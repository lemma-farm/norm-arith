"name" = "dk_1970_formalization"
"version" = "0.1.0"
"defaultTargets" = ["DavisKahan", "Challenge", "Solution"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ForTauCeti"
"globs" = ["ForTauCeti.*"]
"leanOptions" = {"warningAsError" = true, "weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = false}}}}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]

[["lean_lib"]]
"name" = "DavisKahan"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]

[["lean_lib"]]
"name" = "Palomar"
"globs" = ["Palomar.*"]
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated.syntax=false"]
