"name" = "RequestProject"
"defaultTargets" = ["RequestProject", "Challenge", "Solution", "Verification"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "RequestProject"
"globs" = ["RequestProject.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Verification"
"roots" = ["Verification.Audit"]
"srcDir" = "."
