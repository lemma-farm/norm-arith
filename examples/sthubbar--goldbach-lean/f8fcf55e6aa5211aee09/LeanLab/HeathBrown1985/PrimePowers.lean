theorem card_mRange_le (x : ℝ) (hx : 0 ≤ x) : (#(mRange x) : ℝ) ≤ 3 * x := by
  have h : #(mRange x) ≤ ⌊3 * x⌋₊ := by
    unfold mRange; refine (card_filter_le _ _).trans ?_; simp
  exact le_trans (by exact_mod_cast h) (Nat.floor_le (by linarith))

                                                                                   
                             
                                           
                                                                  
                                                   
                                 
                     
                           
                                 
                                                                
            
                                           
                                           
                                                                                           
                           
                   
            
                                                                   
                                  
                                                                                  
                                                      
                                    
                                                           
                                     
                                                                        
                                         
                                                 
                                                                            
                                     
              
                                        
                                                                               
                                                                    
                                      
                                                                            
                                                          
                                                               
                                                                                      
                                              
                                   
                              
                                 
                                                                                               
                                                       
                    

