"name" = "SharpWasserstein"
"version" = "0.1.0"
"defaultTargets" = ["SharpWasserstein", "Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SharpWasserstein"
"globs" = ["SharpWasserstein", "SharpWasserstein.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "BrownianMotion"
"globs" = ["BrownianMotion.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "KolmogorovExtension4"
"globs" = ["KolmogorovExtension4.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
