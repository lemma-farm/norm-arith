"name" = "math_collab"
"version" = "0.1.0"
"defaultTargets" = ["GuthMaynard", "Solution", "VerificationStatements"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "MathCollab"
"globs" = ["MathCollab.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "GuthMaynard"
"globs" = ["GuthMaynard.+"]
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "WeylPort"
"globs" = ["WeylPort.+"]
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."

[["lean_lib"]]
"name" = "VerificationStatements"
"roots" = ["VerificationStatements"]
"srcDir" = "."
