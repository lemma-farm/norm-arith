"name" = "superdiffusion_clt"
"defaultTargets" = ["SuperdiffusionCLT"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["require"]]
"name" = "CoarseGraining"
"path" = "/project/deps/norm-extraction-build/repair-goal-aa4f7c7c794e0080/38742ad6e5534816f907/__deps/CoarseGraining-8bbf3809"

[["lean_lib"]]
"name" = "SuperdiffusionCLT"
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "SuperdiffusionCLTAudit"
"globs" = ["SuperdiffusionCLTAudit.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."
