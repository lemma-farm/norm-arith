"name" = "ccdn_dimension_growth"
"version" = "0.1.0"
"defaultTargets" = ["CCDN", "CCDNPaper", "Axioms", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false, "warningAsError" = true}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "CCDN"
"srcDir" = "."

[["lean_lib"]]
"name" = "CCDNPaper"
"srcDir" = "."

[["lean_lib"]]
"name" = "Axioms"
"srcDir" = "."

[["lean_lib"]]
"name" = "ArithmeticHeights"
"srcDir" = "vendor/bombieri-vaaler"

[["lean_lib"]]
"name" = "Mertens"
"srcDir" = "vendor/mertens"

[["lean_lib"]]
"name" = "Challenge"
"leanOptions" = {"warningAsError" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
