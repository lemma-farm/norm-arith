"name" = "spherical-aging"
"version" = "0.1.0"
"defaultTargets" = ["SphericalAging"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SphericalAging"
"srcDir" = "."

[["lean_lib"]]
"name" = "AbsorptionCutoff"
"srcDir" = "."

[["lean_lib"]]
"name" = "BrownianMotion"
"srcDir" = "vendor/hard-sphere-foundations/src"

[["lean_lib"]]
"name" = "FourPapersCommon"
"srcDir" = "vendor/hard-sphere-foundations/src"

[["lean_lib"]]
"name" = "KolmogorovExtension4"
"srcDir" = "vendor/hard-sphere-foundations/src"

[["lean_lib"]]
"name" = "StochasticCalculus"
"srcDir" = "vendor/hard-sphere-foundations/src"

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
