"name" = "«lean-code»"
"testDriver" = "test"
"version" = "0.1.0"
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ForMathlib"
"globs" = ["ForMathlib.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "BertinPisot"
"globs" = ["BertinPisot.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "CITED"
"globs" = ["CITED.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "RB"
"globs" = ["RB.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
