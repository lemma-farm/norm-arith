"name" = "SubspaceTheorems"
"testDriver" = "test"
"defaultTargets" = ["ArithmeticHeights", "DiophantineApproximation", "QuantitativeSubspace", "STForMathlib", "CorvajaZannier2004", "AdamczewskiBugeaud2007", "Evertse1984", "NairKumarRout2025", "Bugeaud2013", "BugeaudEvertse2008", "Schlickewei1990", "CorvajaZannier2004Thue", "FaltingsWustholz1994", "Stephan2026a"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ArithmeticHeights"
"globs" = ["ArithmeticHeights.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

