"name" = "SubspaceTheorems"
"testDriver" = "test"
"defaultTargets" = ["ArithmeticHeights", "DiophantineApproximation", "ForMathlib", "CorvajaZannier2004", "AdamczewskiBugeaud2007"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ArithmeticHeights"
"globs" = ["ArithmeticHeights.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "DiophantineApproximation"
"globs" = ["DiophantineApproximation.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "ForMathlib"
"globs" = ["ForMathlib.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "CorvajaZannier2004"
"globs" = ["CorvajaZannier2004.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "AdamczewskiBugeaud2007"
"globs" = ["AdamczewskiBugeaud2007.+"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"longFile" = 1500, "longFileDefValue" = 1500, "header" = true}}}, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "Challenge"
"globs" = ["Challenge.*"]
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "ChallengeFlat"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "ChallengeCorvajaZannier2004"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "SolutionCorvajaZannier2004"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "ChallengeAdamczewskiBugeaud2007"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "SolutionAdamczewskiBugeaud2007"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_exe"]]
"name" = "axioms"
"root" = "scripts.Axioms"
"srcDir" = "."

[["lean_exe"]]
"name" = "«module-system»"
"root" = "scripts.ModuleSystem"
"srcDir" = "."
