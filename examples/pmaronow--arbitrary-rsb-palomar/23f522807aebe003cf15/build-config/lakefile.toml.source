"name" = "arbitraryRsb"
"version" = "1.0.0"
"defaultTargets" = ["DepthPaper", "GeneralDepthPaper", "Challenge", "Solution", "Verification"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "DepthPaper"
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

