[["lean_lib"]]
"name" = "QuantitativePaper"
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "PositiveFieldPaper"
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "Paper"
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "FRSB"
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."

[["lean_lib"]]
"name" = "StochasticCalculus"
