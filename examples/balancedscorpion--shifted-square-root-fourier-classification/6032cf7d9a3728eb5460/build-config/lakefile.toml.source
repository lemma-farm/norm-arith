"name" = "MeyerProblem"
"version" = "0.1.0"
"defaultTargets" = ["MeyerProblem", "MeyerProblemTests", "MeyerProblemAppendix", "MeyerProblemAppendixTests", "Challenge", "Solution"]
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "MeyerProblem"

[["lean_lib"]]
"name" = "MeyerProblemTests"

[["lean_lib"]]
"name" = "MeyerProblemAppendix"

[["lean_lib"]]
"name" = "MeyerProblemAppendixTests"

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
