"name" = "GroupApproximation"
"version" = "0.1.0"
"defaultTargets" = ["GroupApproximation", "PalomarChallenge", "PalomarSolution", "PalomarLIXChallenge", "PalomarLIXSolution", "PalomarSurjunctiveNonsoficChallenge", "PalomarSurjunctiveNonsoficSolution", "PalomarSurjunctiveNonsoficModelTests", "PalomarPestov91Challenge", "PalomarPestov91Solution", "PalomarTypeA2Challenge", "PalomarTypeA2Solution", "PalomarGubaThompsonChallenge", "PalomarGubaThompsonSolution", "PalomarGKPCommutingActionsChallenge", "PalomarGKPCommutingActionsSolution", "PalomarSTWProblemX1Challenge", "PalomarSTWProblemX1Solution", "PalomarSTWProblemXXIIChallenge", "PalomarSTWProblemXXIISolution", "PalomarBlanchardToeplitzChallenge", "PalomarBlanchardToeplitzSolution"]
"buildDir" = ".lake/build"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "GroupApproximation"
"moreLeanArgs" = ["-DwarningAsError=true", "-Dlinter.deprecated=false"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Audit"
"srcDir" = "scripts"
"roots" = ["Audit.DeclFilter", "Audit.Scan", "Audit.Plants"]
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "PalomarChallenge"
"roots" = ["Palomar.Challenge"]
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

