"name" = "CoarseDeGiorgi"
"defaultTargets" = ["CoarseDeGiorgi"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["require"]]
"name" = "CoarseGraining"
"path" = "/project/deps/norm-extraction-build/agent-import-v3/14d6d24550cea4963a16/__deps/CoarseGraining-8bbf3809"

[["lean_lib"]]
"name" = "CoarseDeGiorgi"
"globs" = ["CoarseDeGiorgi.*"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "CoarseDeGiorgiAudit"
"globs" = ["CoarseDeGiorgiAudit.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false}
"srcDir" = "."
