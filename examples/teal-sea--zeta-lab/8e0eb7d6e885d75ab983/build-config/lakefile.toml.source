"name" = "Zeta23Bridge"
"version" = "0.1.0"
"keywords" = ["math"]
"defaultTargets" = ["Zeta23Ext", "BridgeChallenge", "BridgeSolution", "ThreePoint", "FourPoint", "V2Challenge", "V2Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["require"]]
"name" = "Zeta23"
"path" = "/project/deps/norm-extraction-build/repair-goal-aa4f7c7c794e0080/8e0eb7d6e885d75ab983/__deps/Zeta23-5da025cf"

[["lean_lib"]]
"name" = "Zeta23Ext"
"srcDir" = "."

