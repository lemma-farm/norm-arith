"name" = "dedekind_zeta"
"defaultTargets" = ["DedekindZetaZeroFree", "DedekindZetaChallenge", "DedekindZetaSolution"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "DedekindZetaZeroFree"
"globs" = ["DedekindZetaZeroFree", "DedekindZetaZeroFree.+"]

[["lean_lib"]]
"name" = "DedekindZetaChallenge"
"srcDir" = "Challenge"

[["lean_lib"]]
"name" = "DedekindZetaSolution"
"srcDir" = "Solution"
