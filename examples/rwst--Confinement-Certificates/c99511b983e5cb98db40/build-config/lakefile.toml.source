"name" = "«lean-code»"
"testDriver" = "test"
"version" = "0.1.0"
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ForMathlib"
"globs" = ["ForMathlib.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "FLP"
"globs" = ["FLP.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Z32"
"globs" = ["Z32.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."

[["lean_lib"]]
"name" = "SolutionRecord"
"srcDir" = "."
