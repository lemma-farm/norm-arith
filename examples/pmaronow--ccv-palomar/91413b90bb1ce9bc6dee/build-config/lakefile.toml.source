"name" = "nearly_minimax"
"version" = "0.1.0"
"fixedToolchain" = true
"defaultTargets" = ["NearlyMinimax", "RoughRegime", "Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "RoughRegime"
"srcDir" = "Vendor"

[["lean_lib"]]
"name" = "NearlyMinimax"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
