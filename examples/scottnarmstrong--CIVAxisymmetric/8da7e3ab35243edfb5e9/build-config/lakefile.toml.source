"name" = "CIVAxisymmetric"
"version" = "1.0.0"
"defaultTargets" = ["CIV"]
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "CIV"
"globs" = ["CIV"]
"leanOptions" = {"autoImplicit" = false, "warningAsError" = true}

[["lean_lib"]]
"name" = "Comparators"
"globs" = ["Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
