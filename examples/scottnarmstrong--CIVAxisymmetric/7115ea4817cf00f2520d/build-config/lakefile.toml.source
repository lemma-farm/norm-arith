"name" = "CIVAxisymmetric"
"version" = "1.0.0"
"defaultTargets" = ["CIV"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["require"]]
"name" = "CKN"
"path" = "/project/deps/norm-extraction-build/repair-goal-aa4f7c7c794e0080/7115ea4817cf00f2520d/__deps/CKN-b5e25360"

[["lean_lib"]]
"name" = "CIV"
"globs" = ["CIV"]
"leanOptions" = {"autoImplicit" = false, "warningAsError" = true}
"srcDir" = "."

[["lean_lib"]]
"name" = "Comparators"
"globs" = ["Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."
