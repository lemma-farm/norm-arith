"name" = "CKN"
"version" = "2.0.0"
"defaultTargets" = ["CKN"]
"buildDir" = ".lake/build"
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "CKN"
"globs" = ["CKN"]
"leanOptions" = {"autoImplicit" = false, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "CKNAll"
"globs" = ["CKNAll"]
"leanOptions" = {"autoImplicit" = false, "warningAsError" = true}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]

[["lean_lib"]]
"name" = "Comparators"
"globs" = ["comparators.+"]
"leanOptions" = {"autoImplicit" = false}
"srcDir" = "."
"moreLeanArgs" = ["-Dlinter.deprecated=false"]
