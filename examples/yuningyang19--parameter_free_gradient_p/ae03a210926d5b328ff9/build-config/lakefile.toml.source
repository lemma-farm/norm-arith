"name" = "«parameter-free-gradient-formalization»"
"version" = "0.1.0"
"defaultTargets" = ["Certified", "PalomarChallenge", "PalomarSolution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Certified"
"roots" = ["V7", "O3"]
"globs" = ["O3.+", "V7.*"]
"srcDir" = "."

[["lean_lib"]]
"name" = "PalomarChallenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "PalomarSolution"
"roots" = ["Solution"]
"srcDir" = "."
