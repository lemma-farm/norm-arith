"name" = "compartmentDivision"
"version" = "0.1.0"
"defaultTargets" = ["Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "CompartmentProofs"
"roots" = ["proofs.DividingCompartments.Paper"]
"globs" = ["proofs.DividingCompartments.+"]
"moreLeanArgs" = ["-DwarningAsError=true"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"moreLeanArgs" = ["-DwarningAsError=true"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."
