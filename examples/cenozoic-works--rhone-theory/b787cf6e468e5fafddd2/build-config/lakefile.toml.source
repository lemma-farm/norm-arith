"name" = "rhone"
"defaultTargets" = ["Rhone"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "relaxedAutoImplicit" = false, "maxSynthPendingDepth" = 3, "weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"maxHeartbeats" = false}}}}
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
