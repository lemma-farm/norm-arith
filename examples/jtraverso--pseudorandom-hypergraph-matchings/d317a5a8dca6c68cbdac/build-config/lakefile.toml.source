"name" = "egj_pseudorandom"
"version" = "0.1.0"
"defaultTargets" = ["PseudorandomLib", "Challenge", "Solution"]
"requiresModuleSystem" = true
"leanOptions" = {"relaxedAutoImplicit" = false, "weak" = {"linter" = {"mathlibStandardSet" = true}}}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "PseudorandomLib"
"globs" = ["PseudorandomLib.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
