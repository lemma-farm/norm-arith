"name" = "srht"
"version" = "0.1.0"
"defaultTargets" = ["SRHT", "Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SparseFockFormal"
"srcDir" = "vendor/sparse-fock"

[["lean_lib"]]
"name" = "SRHT"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
