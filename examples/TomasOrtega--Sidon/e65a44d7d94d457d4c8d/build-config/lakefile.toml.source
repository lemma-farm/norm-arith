"name" = "Sidon"
"version" = "0.1.0"
"keywords" = ["math"]
"defaultTargets" = ["Sidon", "Challenge", "Solution"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false}
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Sidon"

[["lean_lib"]]
"name" = "Challenge"

[["lean_lib"]]
"name" = "Solution"
