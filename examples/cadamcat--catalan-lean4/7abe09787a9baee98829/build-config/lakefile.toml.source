"name" = "CatalanLean"
"version" = "0.1.0"
"defaultTargets" = ["Catalan"]
"moreLeanArgs" = ["--trust=0"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Catalan"
"srcDir" = "."

[["lean_lib"]]
"name" = "ClassFieldTheory"
"srcDir" = "vendor/ClassFieldTheory/Lean4"
"globs" = ["ClassFieldTheory.+"]
"moreLeanArgs" = ["-DmaxHeartbeats=1000000"]

[["lean_lib"]]
"name" = "ValuedFieldTheory"
"srcDir" = "vendor/ClassFieldTheory/Lean4"
"globs" = ["ValuedFieldTheory.+"]

[["lean_lib"]]
"name" = "GaloisCohomology"
"srcDir" = "vendor/ClassFieldTheory/Lean4"
"globs" = ["GaloisCohomology.+"]

[["lean_lib"]]
"name" = "Verification"
"globs" = ["Verification.Axioms", "Verification.Statements", "Verification.Replay"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
