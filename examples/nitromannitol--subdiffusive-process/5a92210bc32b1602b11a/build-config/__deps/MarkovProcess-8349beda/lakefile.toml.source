"name" = "MarkovProcess"
"defaultTargets" = ["MarkovProcess"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Audit"
"globs" = ["Audit.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "MarkovProcessDocs"
"roots" = ["docs.ConsumerGuide"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "MarkovProcess"
"globs" = ["MarkovProcess.*"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."
