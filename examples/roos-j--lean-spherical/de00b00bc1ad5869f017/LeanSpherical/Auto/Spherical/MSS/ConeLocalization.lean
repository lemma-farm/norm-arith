    |(n : Real) - s| < 3}

                                                                     
                                            
                                                                
                                     
                                                                                    
         

                                                                           
                                                                         
                                              
                                                              
                                                                   
                                            
                                                         
                                         
                                                            
                                                                    
                                                                 
                                    
                               
        
                                                                             
            
                                                     
                     
                                                                     
                                                                 
                                    
                               
        
                             
                                                     
                                          
                                                        

                                                                            
                                                                            
                                                                           
                                                                        
                            
                                                       

                                                                           
                                
