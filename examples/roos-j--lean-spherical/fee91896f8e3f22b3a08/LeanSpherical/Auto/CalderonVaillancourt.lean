/-! ## Fourier decay of smooth compactly supported functions -/

section FourierDecay

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [MeasurableSpace V] [BorelSpace V]

                                                                                          
                                              
                                                                      
                                   
                                                                                  
                                                           
                                              
                                                               
                                                                            
             
                         
                                                   
                                              
                                                     
                                           
                                     
                                                     
                                               
                                   
                                                         

                                                                              
                                                                                       
theorem pow_mul_norm_fourier_le {Ψ : V → ℂ} {M : ℝ} {N : ℕ}
    (hsm : ContDiff ℝ (↑(⊤ : ℕ∞)) Ψ) (hcs : HasCompactSupport Ψ)
    (hint : ∀ n ≤ N, (∫ v, ‖iteratedFDeriv ℝ n Ψ v‖) ≤ M) (w : V) :
    ‖w‖ ^ N * ‖𝓕 Ψ w‖ ≤ 2 ^ N * ((N : ℝ) + 1) * M := by
  have hMnn : 0 ≤ M := by
    refine le_trans ?_ (hint 0 (Nat.zero_le N))
    exact integral_nonneg (fun v => norm_nonneg _)
  have hintbl : ∀ (k n : ℕ), k ≤ (0 : ℕ∞) → (n : ℕ∞) ≤ (⊤ : ℕ∞) →
      Integrable (fun v => ‖v‖ ^ k * ‖iteratedFDeriv ℝ n Ψ v‖) := by
    intro k n hk _
    have hk0 : k = 0 := by simpa using hk
    subst hk0
    simp only [pow_zero, one_mul]
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (hsm.continuous_iteratedFDeriv (by exact_mod_cast le_top)).norm
    · exact (hcs.iteratedFDeriv n).norm
  have hmain := Real.pow_mul_norm_iteratedFDeriv_fourier_le (f := Ψ) (K := (0 : ℕ∞))
    (N := (⊤ : ℕ∞)) hsm hintbl (k := 0) (n := N) (le_refl _) le_top w
  rw [norm_iteratedFDeriv_zero] at hmain
  refine le_trans hmain ?_
  · have hsum : (∑ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
        ∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖) ≤ ((N : ℝ) + 1) * M := by
      have hcard : (Finset.range (0 + 1) ×ˢ Finset.range (N + 1)).card = N + 1 := by
        simp
      have hterm : ∀ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
          (∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖) ≤ M := by
        intro p hp
        rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
        have hp1 : p.1 = 0 := by omega
        rw [hp1]
        simp only [pow_zero, one_mul]
        exact hint p.2 (by omega)
      calc (∑ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
            ∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖)
          ≤ ∑ _p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1), M :=
            Finset.sum_le_sum hterm
        _ = ((N : ℝ) + 1) * M := by
            rw [Finset.sum_const, hcard, nsmul_eq_mul]
            push_cast
            ring
    refine le_trans (mul_le_mul_of_nonneg_left hsum (by positivity)) (le_of_eq ?_)
    norm_num
    ring

/-- The combined decay estimate in the form used below. -/
theorem one_add_pow_mul_norm_fourier_le {Ψ : V → ℂ} {M : ℝ} {N : ℕ}
    (hsm : ContDiff ℝ (↑(⊤ : ℕ∞)) Ψ) (hcs : HasCompactSupport Ψ)
    (hint : ∀ n ≤ N, (∫ v, ‖iteratedFDeriv ℝ n Ψ v‖) ≤ M) (w : V) :
    (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 4 ^ N * ((N : ℝ) + 1) * M := by
  have hMnn : 0 ≤ M := by
    refine le_trans ?_ (hint 0 (Nat.zero_le N))
    exact integral_nonneg (fun v => norm_nonneg _)
  have hzero : ‖𝓕 Ψ w‖ ≤ M := by
    have h := pow_mul_norm_fourier_le (N := 0) hsm hcs (fun n hn => hint n (by omega)) w
    simpa using h
  have hbig := pow_mul_norm_fourier_le (N := N) hsm hcs hint w
  have hkey : (max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 2 ^ N * ((N : ℝ) + 1) * M := by
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw, one_pow, one_mul]
      have h2 : (1 : ℝ) ≤ 2 ^ N * ((N : ℝ) + 1) := by
        have : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
        nlinarith [Nat.cast_nonneg (α := ℝ) N]
      nlinarith
    · rw [max_eq_right hw]
      exact hbig
  have hone : (1 + ‖w‖) ^ N ≤ 2 ^ N * (max 1 ‖w‖) ^ N := by
    rw [← mul_pow]
    refine pow_le_pow_left₀ (by positivity) ?_ N
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw]; linarith
    · rw [max_eq_right hw]; linarith [norm_nonneg w]
  calc (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖
      ≤ (2 ^ N * (max 1 ‖w‖) ^ N) * ‖𝓕 Ψ w‖ :=
        mul_le_mul_of_nonneg_right hone (norm_nonneg _)
    _ = 2 ^ N * ((max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖) := by ring
    _ ≤ 2 ^ N * (2 ^ N * ((N : ℝ) + 1) * M) := by
        refine mul_le_mul_of_nonneg_left hkey (by positivity)
    _ = 4 ^ N * ((N : ℝ) + 1) * M := by
        rw [show (4 : ℝ) = 2 * 2 from by norm_num, mul_pow]
        ring

end FourierDecay

                                    

