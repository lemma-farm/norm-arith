/-! ### Good kernels

A kernel is *good* if it is measurable, bounded, and vanishes outside a product `S × S` with
`μ S` finite.  This class is closed under taking adjoints and composing, and every good kernel
defines a bounded operator on `L²`. -/

/-- Measurable, bounded kernels supported in a product of a finite-measure set with itself. -/
structure IsGoodKernel (μ : Measure α) (K : α → α → ℂ) : Prop where
  meas : Measurable (Function.uncurry K)
  exists_data : ∃ (B : ℝ≥0∞) (S : Set α), B ≠ ⊤ ∧ MeasurableSet S ∧ μ S ≠ ⊤ ∧
    (∀ x y, ‖K x y‖ₑ ≤ B) ∧ (∀ x y, K x y ≠ 0 → x ∈ S ∧ y ∈ S)

section IsGoodKernel

variable {μ : Measure α} {K : α → α → ℂ}

theorem row_meas (hK : IsGoodKernel μ K) (x : α) : Measurable (K x) :=
  hK.meas.comp measurable_prodMk_left

                                                                               
                                      

                                                                                          
theorem exists_schur (hK : IsGoodKernel μ K) :
    ∃ C : ℝ≥0∞, C ≠ ⊤ ∧ (∀ x, ∫⁻ y, ‖K x y‖ₑ ∂μ ≤ C) ∧ (∀ y, ∫⁻ x, ‖K x y‖ₑ ∂μ ≤ C) := by
  obtain ⟨B, S, hB, hS, hSfin, hbdd, hsupp⟩ := hK.exists_data
  refine ⟨B * μ S, ENNReal.mul_ne_top hB hSfin, ?_, ?_⟩
  · intro x
    have hle : ∀ y, ‖K x y‖ₑ ≤ S.indicator (fun _ => B) y := by
      intro y
      by_cases hy : y ∈ S
      · simpa [Set.indicator_of_mem hy] using hbdd x y
      · have : K x y = 0 := by
          by_contra hne
          exact hy (hsupp x y hne).2
        simp [Set.indicator_of_notMem hy, this]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS]
  · intro y
    have hle : ∀ x, ‖K x y‖ₑ ≤ S.indicator (fun _ => B) x := by
      intro x
      by_cases hx : x ∈ S
      · simpa [Set.indicator_of_mem hx] using hbdd x y
      · have : K x y = 0 := by
          by_contra hne
          exact hx (hsupp x y hne).1
        simp [Set.indicator_of_notMem hx, this]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS]

theorem sqMass_row_ne_top (hK : IsGoodKernel μ K) (x : α) : sqMass μ (K x) ≠ ⊤ := by
  obtain ⟨B, S, hB, hS, hSfin, hbdd, hsupp⟩ := hK.exists_data
  have hle : ∀ y, ‖K x y‖ₑ ^ (2 : ℝ) ≤ S.indicator (fun _ => B ^ (2 : ℝ)) y := by
    intro y
    by_cases hy : y ∈ S
    · rw [Set.indicator_of_mem hy]
      exact ENNReal.rpow_le_rpow (hbdd x y) (by norm_num)
    · have hz : K x y = 0 := by
        by_contra hne
        exact hy (hsupp x y hne).2
      simp [Set.indicator_of_notMem hy, hz]
  have hbound : sqMass μ (K x) ≤ B ^ (2 : ℝ) * μ S := by
    rw [sqMass]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS]
  refine ne_top_of_le_ne_top ?_ hbound
  exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hB) hSfin

                                                           
                                       
                                                             
                                                                                 
           
                       
                                  
                                                         
                               
                     
                                  
                                           
                                                                   
               
                                           
                                     
                                      
                                                                                 

