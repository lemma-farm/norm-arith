def centeredCentralShell (eps : Real) : Set Real := Ico (-eps) eps

/-- Positive outer dyadic shell `k`: `[2^k eps, 2^(k+1) eps)`. -/
def centeredPositiveOuterShell (eps : Real) (k : Nat) : Set Real :=
  Ico ((2 : Real) ^ k * eps) ((2 : Real) ^ (k + 1) * eps)

/-- Negative outer dyadic shell `k`: `[-2^(k+1) eps, -2^k eps)`. -/
def centeredNegativeOuterShell (eps : Real) (k : Nat) : Set Real :=
  Ico (-((2 : Real) ^ (k + 1) * eps)) (-((2 : Real) ^ k * eps))

def centeredShellWindow (eps : Real) (J : Nat) : Set Real :=
  Ico (-((2 : Real) ^ J * eps)) ((2 : Real) ^ J * eps)

                                                                 
                                      
                                                                        
     

private theorem positive_shell_cover
    {eps beta : Real} (J : Nat)
    (hbeta : beta ∈ Ico ((2 : Real) ^ 0 * eps) ((2 : Real) ^ J * eps)) :
    ∃ k ∈ Finset.range J, beta ∈ centeredPositiveOuterShell eps k := by
  have hcover := Ico_subset_biUnion_Ico J
    (fun k : Nat => (2 : Real) ^ k * eps) hbeta
  rcases Set.mem_iUnion.mp hcover with ⟨k, hk⟩
  rcases Set.mem_iUnion.mp hk with ⟨hkJ, hmem⟩
  exact ⟨k, hkJ, hmem⟩

private theorem negative_shell_cover
    {eps beta : Real} (J : Nat)
    (hbeta : -beta ∈ Ioc ((2 : Real) ^ 0 * eps) ((2 : Real) ^ J * eps)) :
    ∃ k ∈ Finset.range J, beta ∈ centeredNegativeOuterShell eps k := by
  have hcover := Ioc_subset_biUnion_Ioc J
    (fun k : Nat => (2 : Real) ^ k * eps) hbeta
  rcases Set.mem_iUnion.mp hcover with ⟨k, hk⟩
  rcases Set.mem_iUnion.mp hk with ⟨hkJ, hkbeta⟩
  refine ⟨k, hkJ, ?_⟩
  unfold centeredNegativeOuterShell
  rw [mem_Ico]
  rw [mem_Ioc] at hkbeta
  constructor <;> linarith

/-- A finite central-plus-dyadic shell cover of the real coordinate window.
No logarithm is hidden: callers choose `J` so the window contains their
fundamental circle coordinate interval. -/
theorem centeredFiniteShell_cover
    {eps beta : Real} (J : Nat) (hbeta : beta ∈ centeredShellWindow eps J) :
    beta ∈ centeredCentralShell eps ∨
      (∃ k ∈ Finset.range J, beta ∈ centeredPositiveOuterShell eps k) ∨
      (∃ k ∈ Finset.range J, beta ∈ centeredNegativeOuterShell eps k) := by
  by_cases hcenter : beta ∈ centeredCentralShell eps
  · exact Or.inl hcenter
  by_cases hpos : eps ≤ beta
  · right
    left
    apply positive_shell_cover J
    rw [mem_Ico]
    constructor
    · simpa using hpos
    · exact hbeta.2
  · right
    right
    have hlt : beta < eps := lt_of_not_ge hpos
    have hneg : beta < -eps := by
      by_contra h
      have hlow : -eps ≤ beta := le_of_not_gt h
      exact hcenter ⟨hlow, hlt⟩
    apply negative_shell_cover J
    rw [mem_Ioc]
    constructor
    · linarith
    · linarith [hbeta.1]

                                                                            
                                    
                                                                      
                                                                 

                                                                        
                                         
                                                  
                                                  
                                                                
                                            
                       
                                               
           
                                                        
                                                             
                                                                      
                                             
                                                 
             
           
                                                        
                                                             
                                                                      
                                             
                                                 

                                                                        
                                         
                                                  
                                                  
                                                                
                                            
                       
                                               
           
                                                        
                                                             
                                                                      
                                             
                                              
                                                          
                                                    
             
           
                                                        
                                                             
                                                                      
                                             
                                              
                                                          
                                                    

                                                   
                                                
                                               
                                                                    
                                        
                                             
                                
                                                                          
                                                        

                                                   
                                                
                                               
                                                                    
                                        
                                             
                                
                                                                          
                                                                      
                                                           

                                                         
                                                  
                                                    
                                                                  
                                           
                                           
                           
                                                                             
                                                                             
                                                                         
                                                               
                                               
                                      

                                                                           
            
inductive CenteredShellTag
  | central
  | positive (k : Nat)
  | negative (k : Nat)
  deriving DecidableEq

def centeredShellTagSet (eps : Real) : CenteredShellTag → Set Real
  | .central => centeredCentralShell eps
  | .positive k => centeredPositiveOuterShell eps k
  | .negative k => centeredNegativeOuterShell eps k

noncomputable def centeredFiniteShellTags (J : Nat) : Finset CenteredShellTag :=
  ({.central} : Finset CenteredShellTag) ∪
    ((Finset.range J).image CenteredShellTag.positive ∪
      (Finset.range J).image CenteredShellTag.negative)

noncomputable def centeredActiveShellTags (eps : Real) (J : Nat) (beta : Real) :
    Finset CenteredShellTag := by
  classical
  exact (centeredFiniteShellTags J).filter (fun i => beta ∈ centeredShellTagSet eps i)

                                                                            
                                         
                                                               
                                           
                                                         
                     
       
           
                                                                  
           
                                                                  
           
                                                                  
         
                                                      
           
                                                                          
           
                                                                  
           
                                                                          
         
                                                      

                                           
                                                  
                                                       
           
                                  
                 
                                                
                               
                                                
                               
                                                      

theorem centeredActiveShellTags_nonempty_of_window
    {eps beta : Real} (J : Nat) (hbeta : beta ∈ centeredShellWindow eps J) :
    (centeredActiveShellTags eps J beta).Nonempty := by
  classical
  rcases centeredFiniteShell_cover J hbeta with hcenter | hpos | hneg
  · refine ⟨CenteredShellTag.central, Finset.mem_filter.mpr ⟨?_, hcenter⟩⟩
    simp [centeredFiniteShellTags]
  · rcases hpos with ⟨k, hk, hmem⟩
    refine ⟨CenteredShellTag.positive k, Finset.mem_filter.mpr ⟨?_, hmem⟩⟩
    simpa [centeredFiniteShellTags] using hk
  · rcases hneg with ⟨k, hk, hmem⟩
    refine ⟨CenteredShellTag.negative k, Finset.mem_filter.mpr ⟨?_, hmem⟩⟩
    simpa [centeredFiniteShellTags] using hk

/-- One exact local piece: the sharp (half-open) shell restriction of an
arbitrary centered-coordinate field. -/
noncomputable def centeredShellRestrict
    (S : Set Real) (F : Real → Complex) (beta : Real) : Complex := by
  classical
  exact if beta ∈ S then F beta else 0

theorem centeredShellRestrict_eq_self_of_mem
    {S : Set Real} {F : Real → Complex} {beta : Real} (hbeta : beta ∈ S) :
    centeredShellRestrict S F beta = F beta := by
  simp [centeredShellRestrict, hbeta]

                                                
                                                                          
                                            
                                     

noncomputable def centeredTagRestrict (eps : Real) (F : Real → Complex)
    (i : CenteredShellTag) (beta : Real) : Complex :=
  centeredShellRestrict (centeredShellTagSet eps i) F beta

                                                                       
                                                                           
                                                                        
                                                
                                                                     
                                                
                                                                                             
           
                                                                        
                                                               
                                              
                                                                      
              
                                               
                                                            
                                                        
                                    
                            
                                            
                                   

                                                                             
noncomputable def centeredTagEnvelope {X : Type*}
    (eps : Real) (F : Real → X → Complex) (i : CenteredShellTag) (x : X) : ENNReal :=
  ⨆ beta : Real,
    ENNReal.ofReal (‖centeredTagRestrict eps (fun theta => F theta x) i beta‖ ^ 2)

                                                                        
                                                                          
                                    
                                             
                                                    
                                                   
                                             
                                                 
                                                                    
                                              
                                                                                        
           
                                                                               
                                          
                                                                          
           
                 
              
                                                                           
                                                                             
                                                                                  
                                                                                           
                                
                                                      
        
                                         
                                                                                                
                    
                                          
                                    
                                                                                             
                                                                              
                                  
                                          
                                                       
                                    
      
                                                                    
                                                
                                                                                     
                             
                                        
                                                         
                                                                

/-- The same reassembly bound after replacing each sharp-shell envelope by
any measurable local majorant.  This is the direct handoff interface for
Airy's central and outer shell estimates. -/
theorem lintegral_iSup_centeredFiniteShell_le_of_local_majorants
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    {eps : Real} (J : Nat) (F : Real → X → Complex)
    (Q : CenteredShellTag → X → ENNReal)
    (hQmeas : ∀ i ∈ centeredFiniteShellTags J, Measurable (Q i))
    (hlocal : ∀ i ∈ centeredFiniteShellTags J, ∀ x : X,
      centeredTagEnvelope eps F i x ≤ Q i x) :
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∑ i ∈ centeredFiniteShellTags J, ∫⁻ x : X, Q i x ∂mu := by
  classical
  have hpoint : ∀ x : X, (⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2)) ≤
      ∑ i ∈ centeredFiniteShellTags J, Q i x := by
    intro x
    apply iSup_le
    intro beta
    rcases centeredActiveShellTags_nonempty_of_window J beta.2 with ⟨i, hi⟩
    have hitag : i ∈ centeredFiniteShellTags J := (Finset.mem_filter.mp hi).1
    have himem : beta.1 ∈ centeredShellTagSet eps i := (Finset.mem_filter.mp hi).2
    have hEq : centeredTagRestrict eps (fun theta => F theta x) i beta.1 = F beta.1 x := by
      unfold centeredTagRestrict
      exact centeredShellRestrict_eq_self_of_mem himem
    calc
      ENNReal.ofReal (‖F beta.1 x‖ ^ 2) =
          ENNReal.ofReal (‖centeredTagRestrict eps (fun theta => F theta x) i beta.1‖ ^ 2) := by
            rw [hEq]
      _ ≤ centeredTagEnvelope eps F i x :=
        le_iSup (fun theta : Real =>
          ENNReal.ofReal (‖centeredTagRestrict eps (fun eta => F eta x) i theta‖ ^ 2)) beta.1
      _ ≤ Q i x := hlocal i hitag x
      _ ≤ ∑ j ∈ centeredFiniteShellTags J, Q j x := by
        exact Finset.single_le_sum
          (s := centeredFiniteShellTags J)
          (f := fun j => Q j x)
          (fun j hj => bot_le) hitag
  calc
    (∫⁻ x : X, ⨆ beta : {b : Real // b ∈ centeredShellWindow eps J},
        ENNReal.ofReal (‖F beta.1 x‖ ^ 2) ∂mu) ≤
      ∫⁻ x : X, ∑ i ∈ centeredFiniteShellTags J, Q i x ∂mu :=
        lintegral_mono hpoint
    _ = ∑ i ∈ centeredFiniteShellTags J, ∫⁻ x : X, Q i x ∂mu := by
      rw [lintegral_finsetSum (centeredFiniteShellTags J) hQmeas]

                                                                      
                                                                             
                                                                        
                                                                 
                                                 
                                                    
                                                
                                                                      
                            
                                                                                   
                            
                                                                                       
                                                                     
                                                               
         
        
                                  
                                                            
         
         
                                  
                                                            

                                                                          
                                                                         
                                                                      
                                          
                                                    
                                                
                  
                                                                     
                             
                                                                                  
                                                                                        
                                                                                       
                  
                                                                             
                                  
                               
                                                                                   
               
        
                    
                                                                                        
                                                                                 
                                                                                     
                                                      
                               
                                                                                  
                                                                                        
                                    
                                 
                          
                                                                                     
                                                                                      
                                          
                                                                         
                               
                                                                                    
                                                                                          
                                                     
                                  
                               
                                                                                   
               
        
                    
                                                                                        
                                                                                 
                                                                                     
                                                     
                               
                                                                                  
                                                                                        
                                    
                                 
                          
                                                                                     
                                                                                      
                                          
                                                                         
                               
                                                                                    
                                                                                          
                                                     

