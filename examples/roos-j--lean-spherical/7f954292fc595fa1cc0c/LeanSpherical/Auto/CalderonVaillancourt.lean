/-! ## Fourier decay of smooth compactly supported functions -/

section FourierDecay

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [MeasurableSpace V] [BorelSpace V]

/-- The `L¹` norm of a continuous function supported in a set of finite measure is at most
the sup bound times the measure of the set. -/
theorem integral_norm_le_of_support {E : Type*} [NormedAddCommGroup E]
    {f : V → E} {C : ℝ} {S : Set V}
    (hf : Integrable f) (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (hC : 0 ≤ C)
    (hbd : ∀ x, ‖f x‖ ≤ C) (hsupp : ∀ x, x ∉ S → f x = 0) :
    (∫ v, ‖f v‖) ≤ C * (volume S).toReal := by
  have hlt : (∫⁻ v, ‖f v‖ₑ) ≤ ENNReal.ofReal C * volume S := by
    have hle : ∀ v, ‖f v‖ₑ ≤ S.indicator (fun _ => ENNReal.ofReal C) v := by
      intro v
      by_cases hv : v ∈ S
      · rw [Set.indicator_of_mem hv, ← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hbd v)
      · simp [Set.indicator_of_notMem hv, hsupp v hv]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS]
  rw [← ENNReal.ofReal_le_ofReal_iff (by positivity),
    ofReal_integral_norm_eq_lintegral_enorm hf]
  refine le_trans hlt (le_of_eq ?_)
  rw [ENNReal.ofReal_mul hC, ENNReal.ofReal_toReal hSfin]

                                                                              
                                                                                       
                                                           
                                                                
                                                                   
                                                       
                         
                                               
                                                  
                                                                 
                                                                    
                  
                                         
             
                                 
                                                           
                                                                           
                                       
                                                                                    
                                                                     
                                        
                          
                                                                    
                                                                              
                                                                                    
            
                                                                      
                                                                 
                  
                                                                         
                                      
                
                                     
                                 
                                                               
                                                        
                                                                     
                                   
                                   
                                                      
                     
                
                                                                                  
            
        

                                                          
                                                                   
                                                                
                                                                   
                                                             
                         
                                               
                                                  
                                
                                                                                        
                 
                                                              
                                                                         
                                      
                                           
                                                     
                                                           
                                              
               
                          
                
                                                           
                  
                                                
                                      
                                   
                                                    
                              
                                              
                                                       
                                                      
                                                 
                                                             
                                       
                                                           
            

