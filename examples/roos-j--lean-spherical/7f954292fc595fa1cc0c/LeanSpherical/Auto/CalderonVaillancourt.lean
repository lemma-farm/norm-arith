            (MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp G))).symm)
      _ =ᵐ[μ] (((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp F)) +
          MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp G)) : Lp ℂ 2 μ)) : α → ℂ) :=
