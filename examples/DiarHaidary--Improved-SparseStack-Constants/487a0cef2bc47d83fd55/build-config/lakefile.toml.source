name = "SparseStackV3"
version = "0.1.0"
defaultTargets = ["SparseStackV3", "Solution"]

[leanOptions]
autoImplicit = false
relaxedAutoImplicit = false

[[require]]
name = "mathlib"
git = "https://github.com/leanprover-community/mathlib4.git"
rev = "db584cd6d46c92f209a44c0f1c829460d327499d"

[[lean_lib]]
name = "SparseStackV3"
roots = ["SparseStackV3"]

[[lean_lib]]
name = "Solution"
roots = ["Solution"]

[[lean_lib]]
name = "Challenge"
roots = ["Challenge"]
