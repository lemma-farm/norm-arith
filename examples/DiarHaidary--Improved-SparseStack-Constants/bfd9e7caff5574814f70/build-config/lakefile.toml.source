"name" = "SparseStackV3"
"version" = "0.1.0"
"defaultTargets" = ["SparseStackV3", "Solution"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SparseStackV3"
"roots" = ["SparseStackV3"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."
