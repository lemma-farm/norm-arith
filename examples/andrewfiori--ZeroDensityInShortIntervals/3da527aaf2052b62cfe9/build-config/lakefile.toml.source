"name" = "ZerosInShortIntervals"
"version" = "0.1.0"
"keywords" = ["math"]
"defaultTargets" = ["ZerosInShortIntervals", "Challenge", "Solution"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "relaxedAutoImplicit" = false, "weak" = {"linter" = {"mathlibStandardSet" = true, "style" = {"whitespace" = false, "header" = {"license" = "Released under CC BY 4.0 license as described in the file LICENSE."}}}}, "maxSynthPendingDepth" = 3}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "ZerosInShortIntervals"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
