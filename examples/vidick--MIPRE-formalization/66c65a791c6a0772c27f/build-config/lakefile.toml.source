"name" = "MIPRE"
"version" = "0.1.0"
"keywords" = ["math"]
"defaultTargets" = ["MIPRE", "Palomar"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "relaxedAutoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "MIPRE"
"srcDir" = "."

[["lean_lib"]]
"name" = "Palomar"
"roots" = ["Palomar.Challenge", "Palomar.Bridge", "Palomar.Solution"]
"srcDir" = "."
