"name" = "AmbidextrousSofa"
"version" = "0.1.0"
"keywords" = ["math"]
"defaultTargets" = ["AmbidextrousSofa", "Challenge", "Solution"]
"leanOptions" = {"pp" = {"unicode" = {"fun" = true}}, "autoImplicit" = false, "maxSynthPendingDepth" = 3}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "MovingSofaOptimality"
"globs" = ["MovingSofaOptimality.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "AmbidextrousSofa"
"globs" = ["AmbidextrousSofa.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
