"name" = "rp2_decay"
"version" = "0.4.0"
"defaultTargets" = ["RP2", "RP3", "Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "RP2"
"srcDir" = "."

[["lean_lib"]]
"name" = "RP3"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
