"name" = "centered_maximal_constant"
"version" = "0.1.0"
"defaultTargets" = ["CenteredMaximal"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "CenteredMaximal"
"globs" = ["CenteredMaximal", "CenteredMaximal.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
