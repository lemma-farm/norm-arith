"name" = "KakeyaPalomar"
"version" = "0.1.0"
"defaultTargets" = ["Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "KakeyaTwoScale"
"roots" = ["KakeyaTwoScale.KakeyaDependencyClosed"]
"globs" = ["KakeyaTwoScale.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "DensityHalesJewett"
"srcDir" = "vendor/DensityHalesJewett"
"roots" = ["DensityHalesJewett.Szemeredi"]
"globs" = ["DensityHalesJewett.+"]
"leanOptions" = {"relaxedAutoImplicit" = false, "maxSynthPendingDepth" = 3}

[["lean_lib"]]
"name" = "HamSandwich"
"srcDir" = "vendor/HamSandwich"
"roots" = ["HamSandwich.SphereOddDegree.BorsukUlam"]
"globs" = ["HamSandwich.+"]
"leanOptions" = {"backward" = {"defeqAttrib" = {"useBackward" = true}, "isDefEq" = {"respectTransparency" = false}}}

[["lean_lib"]]
"name" = "OAI"
"srcDir" = "vendor/Semialgebraic"
"roots" = ["OAI.Analysis.SymmetricDomains.PolynomialSignSetChoice2"]
"globs" = ["OAI.+"]

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
