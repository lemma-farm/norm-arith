"name" = "regularity_structures"
"defaultTargets" = ["RegularityStructures", "Phi43Statements", "Phi43", "Witnesses", "Regression"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "RegularityStructures"
"globs" = ["RegularityStructures.*"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "Phi43Statements"
"globs" = ["Phi43Statements.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = false, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "Phi43"
"globs" = ["Phi43.*"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
