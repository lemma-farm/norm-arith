"name" = "RequestProject"
"defaultTargets" = ["AreaProof", "PlanarBucklingChallenge", "PlanarBucklingSolution", "SubmissionSolutionAudit"]
"moreLeanArgs" = ["-j1"]
"leanOptions" = {"Elab" = {"async" = false}}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "RequestProject"
"globs" = ["RequestProject.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "AreaProof"
"roots" = ["H01HilbertModel", "EllipticH01Bridge", "FiniteAreaTestLpBounds", "H01UniformTails", "PolarizationEnergy", "AbsoluteValueEnergy", "H01NonnegativeCompactApproximation", "PolarizationMeasure", "EuclideanReflection", "PolarizationEnergyTransport", "PolarizationLipschitz", "EuclideanReflectionContraction", "PolarizedOpenDomain", "CompactLipOriginalH01", "CompactLipOriginalH01Energy", "AffinePolarizationRealEnergy", "PolarizationL2Continuity", "H01WeakLimitAdmissibility", "AffinePolarizedH01Candidate", "H01AbsoluteValue", "H01TranslationModulus", "FrechetKolmogorovTail", "H01CompactEmbedding", "H01NonzeroMass", "H01RayleighMinimizer", "H01DirichletEuler", "H01NonnegativeMinimizer", "H01WeakGradientBridge", "AffinePolarizedGroundState", "AffineReflectionWeakTransport", "H01ComponentTestCutoff", "H01ComponentProjection", "H01ComponentRestriction", "H01ComponentSelection", "FaberKrahnEqualityConnected", "GraphH01ShiftedTruncation", "H01BoundaryTruncation", "H01GraphEuler", "H01GroundStateGlobalTest", "H01ZeroExtensionSubsolution", "H01FullEuler", "WeakSMPRegularizers", "WeakSMPLogTest", "PositiveCompactWeakApproximation", "PositiveCompactWeakTesting", "WeakSMPCaccioppoliAlgebra", "WeakSMPIntegratedCaccioppoli", "AnchoredL2Estimate", "WeakSMPBallLogBound", "WeakSMPLogBoundDecay", "WeakSMPBallZero", "ConnectedLocalAEDichotomy", "WeakSMPConnected", "H01GroundStatePositive", "WeakGradientDifference", "WeakSMPMinimumBranch", "AffineHalfspaceFold", "FoldedDomainConnected", "FoldedDomainNonempty", "PolarizationBranchExtension", "FaberKrahnPolarizationBranch", "FaberKrahnEqualityGroundStateData", "RadialPotentialCenter", "RadialKernelReflection", "RadialPotentialPolarization", "ReflectionPairs", "ReflectionOrderGoodPoints", "ReflectionOrderPositiveBall", "ReflectionBranchPositiveBall", "PlanarBallRadius", "FaberKrahnEqualityAeDisk", "PolarizationBounds", "FinitePolarizationOrbit", "LipschitzCompactness", "GlobalLipschitzCompactness", "PolarizationMoment", "BoundedPolarizationOrbit", "PolarizationMomentTransport", "SquaredMomentPolarization", "UniformDistributionClosure", "RadialSupportRadius", "OrbitMinimizerSupport", "FiniteOrbitEnergies", "UniformSquaredIntegral", "OrbitL2Closure", "SpectralCutoffGeometry", "CutoffMassLimit", "CutoffEnergyEstimate", "CutoffRayleighReal", "FixedInitialFaberKrahn", "DirichletTestDensity", "TestFunctionFaberKrahn", "DirichletFKAreaProduct", "UnconditionalFaberKrahn", "UnconditionalAreaRigidity", "UnconditionalAreaFinalAudit"]
"srcDir" = "."

[["lean_lib"]]
"name" = "PlanarBucklingChallenge"
"roots" = ["PlanarBucklingChallenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "PlanarBucklingSolution"
"roots" = ["PlanarBucklingSolution"]
"srcDir" = "."

[["lean_lib"]]
"name" = "SubmissionSolutionAudit"
"roots" = ["SubmissionSolutionAudit"]
"srcDir" = "."
