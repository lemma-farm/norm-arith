"name" = "planarwave"
"version" = "1.0.0"
"defaultTargets" = ["Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution", "Planarwave"]
"globs" = ["Solution", "Planarwave.+"]
"srcDir" = "."
