"name" = "compactGlennie"
"version" = "0.1.0"
"keywords" = ["math", "Albert algebra", "Glennie polynomial"]
"defaultTargets" = ["Glennie"]
"moreLeanArgs" = ["-j1", "-M3500"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Glennie"
"globs" = ["Glennie", "Glennie.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "AlbertGeometry"
"globs" = ["AlbertGeometry", "AlbertGeometry.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "AlbertRecognition"
"globs" = ["AlbertRecognition", "AlbertRecognition.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "GenericCubic"
"globs" = ["GenericCubic", "GenericCubic.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Connected"
"globs" = ["Connected", "Connected.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"globs" = ["Challenge", "Challenge.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"globs" = ["Solution", "Solution.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "UniversalGluing"
"globs" = ["UniversalGluing", "UniversalGluing.+"]
"srcDir" = "."
