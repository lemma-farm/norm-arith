def monoQ (r t : ℝ) : ℝ := t ^ r

/-- Its derivative `q(t) = Q'(t) = r t^{r-1}` (lines 77-79). -/
def monoq (r t : ℝ) : ℝ := r * t ^ (r - 1)

                                                                                                
                                                                              
                                                                    
                                                                  

                                                                       
                                                

theorem hasDerivAt_monoQ (r : ℝ) {t : ℝ} (ht : 0 < t) : HasDerivAt (monoQ r) (monoq r t) t := by
  unfold monoQ monoq
  exact Real.hasDerivAt_rpow_const (Or.inl ht.ne')

end

