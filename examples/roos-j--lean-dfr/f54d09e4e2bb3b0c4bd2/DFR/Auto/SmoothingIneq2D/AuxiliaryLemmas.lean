    (Real.fourierChar (-inner ℝ p.2 p.1.2) : ℂ) * (f (p.2 + p.1.1) * star (f p.2)))
  have hf := Lp.stronglyMeasurable f
  exact (continuous_subtype_val.comp (Real.continuous_fourierChar.comp
    (continuous_snd.inner (continuous_snd.comp continuous_fst)).neg)).stronglyMeasurable.mul
    ((hf.comp_measurable (by fun_prop)).mul (hf.comp_measurable measurable_snd).star)

/-- The squared Fourier transform of the multiplicative difference is integrable
jointly in translation and frequency, as used in Lemma 3.1's final display. -/
theorem smoothing_integrable_fourierDifference_energy
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) :
    Integrable (fun p : E × E =>
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) p.1) : E → ℂ) p.2‖ ^ 2)
      (volume.prod volume) := by
  apply (integrable_prod_iff'
    ((smoothing_stronglyMeasurable_fourierDifference f).norm.pow 2).aestronglyMeasurable).mpr
  constructor
  · filter_upwards [smoothing_ae_memLp_fourierCorrelation f] with ξ hξ
    have hF : MemLp (𝓕 (fun η => (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
        star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) : E → ℂ) 2 volume :=
      (memLp_congr_ae (smoothing_fourier_toLp_ae_eq (smoothing_integrable_fourierCorrelation f ξ)
        hξ)).mp
        (Lp.memLp (𝓕 (hξ.toLp _)))
    have hFn := hF.comp_measurePreserving (Measure.measurePreserving_neg volume)
    have hsq := (memLp_two_iff_integrable_sq_norm hFn.aestronglyMeasurable).mp hFn
    simpa only [Function.comp_def, Pi.pow_apply,
      smoothing_fourier_multiplicativeDifference_norm] using hsq
  · have hw : Integrable (fun η => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) volume :=
      (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).aestronglyMeasurable).mp (Lp.memLp (𝓕 f))
    have hprod := hw.mul_prod hw
    have hfull := ((measurePreserving_add_prod volume volume).integrable_comp
      hprod.aestronglyMeasurable).mpr hprod
    apply hfull.integral_prod_left.congr
    filter_upwards [smoothing_integral_fourier_multiplicativeDifference_norm_sq f] with ξ hξ
    simpa only [Real.norm_eq_abs, Pi.pow_apply, abs_pow, abs_norm, Function.comp_apply] using
      hξ.symm
/-- Translation of the centered frequency ball in Lemma 3.1. -/
theorem smoothing_integral_ball_translate
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (w : E → ℝ) (η : E) (R : ℝ) :
    (∫ ξ in Metric.closedBall (0 : E) R, w (ξ + η)) =
      ∫ ξ in Metric.closedBall η R, w ξ := by
  rw [← integral_indicator measurableSet_closedBall,
    ← integral_indicator measurableSet_closedBall]
  have ht := integral_add_right_eq_self (μ := volume)
    ((Metric.closedBall η R).indicator w) η
  rw [← ht]
  apply integral_congr_ae
  filter_upwards [] with ξ
  classical
  change (if ξ ∈ Metric.closedBall (0 : E) R then w (ξ + η) else 0) =
    (if ξ + η ∈ Metric.closedBall η R then w (ξ + η) else 0)
  simp only [Metric.mem_closedBall, dist_eq_norm, sub_zero, add_sub_cancel_right]

/-- The equality in the final display of Lemma 3.1: the multiplicative-difference
energy on the centered ball is the spectral-pair energy at distance at most R. -/
theorem smoothing_fourierDifference_ball_energy
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (R : ℝ) :
    (∫ s, ∫ ξ in Metric.closedBall (0 : E) R,
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) =
      ∫ η, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 *
        ∫ ξ in Metric.closedBall η R, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2 := by
  have hp := (smoothing_integrable_fourierDifference_energy f).restrict
    (s := Set.univ ×ˢ Metric.closedBall (0 : E) R)
  rw [← Measure.prod_restrict, Measure.restrict_univ] at hp
  rw [integral_integral_swap hp]
  calc
    _ = ∫ ξ in Metric.closedBall (0 : E) R, ∫ η,
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η)‖ ^ 2 *
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 :=
      integral_congr_ae (ae_restrict_of_ae
        (smoothing_integral_fourier_multiplicativeDifference_norm_sq f))
    _ = ∫ η, ∫ ξ in Metric.closedBall (0 : E) R,
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η)‖ ^ 2 *
        ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2 := by
      apply integral_integral_swap
      have hw : Integrable (fun η => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) volume :=
        (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).aestronglyMeasurable).mp (Lp.memLp (𝓕 f))
      have hprod := hw.mul_prod hw
      have hfull := ((measurePreserving_add_prod volume volume).integrable_comp
        hprod.aestronglyMeasurable).mpr hprod
      have hr := hfull.restrict (s := Metric.closedBall (0 : E) R ×ˢ Set.univ)
      simpa only [← Measure.prod_restrict, Measure.restrict_univ, Function.comp_def,
        Function.uncurry_def] using! hr
    _ = _ := by
      apply integral_congr_ae
      filter_upwards [] with η
      rw [integral_mul_const, smoothing_integral_ball_translate
        (fun ξ => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2) η R, mul_comm]

                                                                           
                                                                               
                                                      
                                                 
                                                   
                                                                       
                                                    
                                                               
                   
      
                                                            
                                                               
                             
                             
                                                   
                                                        
                 
                                         
                              

                                                                     
                                                                           
                                                                             
                                                                            
                                     
                                                                         
                                                   
                                                                     
                                   
                                   
                                                                                                  
                                                                                                 
             
                          
                                                                                 
                                                                                        
                                                                                        
                  
                                                                           
                                      
                               
                
                                                               
             
                              
               
                                       
                                     
                                                      
                                                                            
                                                         
                                               
                                               

/-- The averaging step in Lemma 3.1: a large weighted energy forces one
frequency window to capture a definite fraction of the total mass. Here `b`
will be the mass of a translated frequency ball. -/
theorem smoothing_exists_large_window
    {E : Type*} [MeasurableSpace E] {μ : Measure E}
    {w b : E → ℝ} (hw : Integrable w μ)
    (hwb : Integrable (fun x => w x * b x) μ)
    (hw_nonneg : ∀ᵐ x ∂μ, 0 ≤ w x)
    (hmass : 0 < ∫ x, w x ∂μ) {ρ : ℝ} (hρ : 0 < ρ)
    (henergy : ρ * (∫ x, w x ∂μ) ^ 2 ≤ ∫ x, w x * b x ∂μ) :
    ∃ x, (ρ / 2) * (∫ y, w y ∂μ) < b x := by
  by_contra! hsmall
  have hbound : (∫ x, w x * b x ∂μ) ≤
      (∫ x, w x ∂μ) * ((ρ / 2) * (∫ y, w y ∂μ)) := by
    rw [← integral_mul_const]
    apply integral_mono_ae hwb (hw.mul_const _)
    filter_upwards [hw_nonneg] with x hx
    exact mul_le_mul_of_nonneg_left (hsmall x) hx
  have hpos : 0 < ρ * (∫ x, w x ∂μ) ^ 2 := mul_pos hρ (sq_pos_of_pos hmass)
  nlinarith

                                                                             
                                                                          
                                                                               
                                             
                                                                         
                                                   
                                                                   
                                                                         
                                   
                                                 
                                                                      
                                                                         
                     
                                                                   
                                                                   
                
                                                                                           
                                                      
                                                
                                                
                                                 
                               
           
                      

/-- The weighted frequency-ball energy is integrable. This supplies the
integrability hypothesis of `smoothing_exists_large_window` without assuming
convergence of the iterated energy integral in Lemma 3.1. -/
theorem smoothing_integrable_ball_energy
    {E : Type*} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] {μ : Measure E} [SFinite μ]
    {w : E → ℝ} (hw : Integrable w μ) (R : ℝ) :
    Integrable (fun x => w x * ∫ y in Metric.closedBall x R, w y ∂μ) μ := by
  let S : Set (E × E) := {p | dist p.2 p.1 ≤ R}
  have hS : MeasurableSet S :=
    (isClosed_le (continuous_snd.dist continuous_fst) continuous_const).measurableSet
  have hprod := (hw.mul_prod hw).indicator hS
  have hsection (x : E) :
      (∫ y, S.indicator (fun p : E × E => w p.1 * w p.2) (x, y) ∂μ) =
        w x * ∫ y in Metric.closedBall x R, w y ∂μ := by
    rw [← integral_const_mul, ← integral_indicator measurableSet_closedBall]
    apply integral_congr_ae
    exact Filter.Eventually.of_forall fun y => by
      by_cases hy : dist y x ≤ R <;> simp [S, Metric.mem_closedBall, hy]
  simpa only [hsection] using hprod.integral_prod_left

/-- The inequality in the final display of Lemma 3.1: total spectral mass
multiplied by the supremum of the spectral mass in a ball bounds the energy. -/
theorem smoothing_fourierDifference_energy_le_ball_mass
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (R : ℝ) :
    (∫ s, ∫ ξ in Metric.closedBall (0 : E) R,
      ‖(𝓕 (smoothingMultiplicativeDifference (⇑f) s) : E → ℂ) ξ‖ ^ 2) ≤
      ‖f‖ ^ 2 * sSup (Set.range (fun c : E =>
        ∫ ξ in Metric.closedBall c R, ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2)) := by
  let w : E → ℝ := fun ξ => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) ξ‖ ^ 2
  have hw : Integrable w volume :=
    (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).aestronglyMeasurable).mp (Lp.memLp (𝓕 f))
  have hwpos : ∀ᵐ ξ ∂volume, 0 ≤ w ξ := Filter.Eventually.of_forall fun ξ => sq_nonneg _
  have hb : BddAbove (Set.range (fun c : E => ∫ ξ in Metric.closedBall c R, w ξ)) := by
    refine ⟨∫ ξ, w ξ, ?_⟩
    rintro y ⟨c, rfl⟩
    exact setIntegral_le_integral hw hwpos
  have hm : (∫ ξ, w ξ) = ‖f‖ ^ 2 := by
    have h := smoothing_frequencyRestriction_norm_sq (Lp.memLp (𝓕 f)) MeasurableSet.univ
    simpa only [Set.indicator_univ, Lp.toLp_coeFn, Measure.restrict_univ,
      Lp.norm_fourier_eq] using h.symm
  rw [smoothing_fourierDifference_ball_energy]
  change (∫ η, w η * ∫ ξ in Metric.closedBall η R, w ξ) ≤
    ‖f‖ ^ 2 * sSup (Set.range (fun c : E => ∫ ξ in Metric.closedBall c R, w ξ))
  rw [← hm, ← integral_mul_const]
  apply integral_mono_ae (smoothing_integrable_ball_energy hw R) (hw.mul_const _)
  filter_upwards [hwpos] with η hη
  exact mul_le_mul_of_nonneg_left (le_csSup hb (Set.mem_range_self η)) hη

                                                                       
                                                                               
                                                                               
                                  
                                                                        
                                                           
                                                                    
                                                          
                                      
                                                           
                                                                          
                                                                          
                              

                                                                              
                                                                           
                                                                                  
                                                 
                                                                         
                                                   
                                                             
                            
                                                   
                                     
                                                   
                                            
                                   
                                             
                                               
                                                  
                      
           
                                                   
        
                                       
                                     
                                  
                                                                                        
                                            
                                                                                    
                                                                             
                                
                
                                 
                 
                                              
                                
                                                        
                 
                                              
                                                 
                                                                    
                                             
                                                                          
                                          
                        
                                  
                                                                                       
                                                                         

                                                                             
                                                                                
                                                                        
                                                                             
                                                                           
                             
                          
                                                                         
                                                   
                                          
                                              
                            
                                              
                                                                         
                                             
                                                                           
                                               
                                                  
                                                         
                                                                  

/-- The cutoff chosen in the first sentence of Lemma 3.2's proof. Its transition
intervals give compact support strictly inside (-1,1) and an integer partition. -/
noncomputable def smoothingPartitionCutoff (x : ℝ) : ℝ :=
  Real.smoothTransition (2 * x + 3 / 2) - Real.smoothTransition (2 * x - 1 / 2)

/-- Smoothness of the cutoff in Lemma 3.2. -/
theorem smoothingPartitionCutoff_contDiff : ContDiff ℝ ∞ smoothingPartitionCutoff := by
  exact (Real.smoothTransition.contDiff.comp
    ((contDiff_const.mul contDiff_id).add contDiff_const)).sub
    (Real.smoothTransition.contDiff.comp
      ((contDiff_const.mul contDiff_id).sub contDiff_const))

/-- Positivity and the unit bound for Lemma 3.2's cutoff. -/
theorem smoothingPartitionCutoff_bounds (x : ℝ) :
    0 ≤ smoothingPartitionCutoff x ∧ smoothingPartitionCutoff x ≤ 1 := by
  constructor
  · exact sub_nonneg.mpr (Real.smoothTransition.monotone (by linarith))
  · unfold smoothingPartitionCutoff
    linarith [Real.smoothTransition.le_one (2 * x + 3 / 2),
      Real.smoothTransition.nonneg (2 * x - 1 / 2)]

/-- The cutoff in Lemma 3.2 vanishes outside the inner interval. -/
theorem smoothingPartitionCutoff_eq_zero {x : ℝ} (hx : 3 / 4 ≤ |x|) :
    smoothingPartitionCutoff x = 0 := by
  unfold smoothingPartitionCutoff
  rcases le_abs.mp hx with h | h
  · rw [Real.smoothTransition.one_of_one_le (by linarith),
      Real.smoothTransition.one_of_one_le (by linarith), sub_self]
  · rw [Real.smoothTransition.zero_of_nonpos (by linarith),
      Real.smoothTransition.zero_of_nonpos (by linarith), sub_self]

/-- Compact support strictly inside the source's interval (-1,1). -/
theorem smoothingPartitionCutoff_tsupport :
    tsupport smoothingPartitionCutoff ⊆ Set.Icc (-3 / 4 : ℝ) (3 / 4) := by
  apply closure_minimal _ isClosed_Icc
  intro x hx
  have h : |x| < 3 / 4 := lt_of_not_ge fun h => hx (smoothingPartitionCutoff_eq_zero h)
  constructor <;> linarith [(abs_lt.mp h).1, (abs_lt.mp h).2]

/-- The source's cutoff belongs to C∞ with compact support. -/
theorem smoothingPartitionCutoff_hasCompactSupport : HasCompactSupport smoothingPartitionCutoff :=
  isCompact_Icc.of_isClosed_subset isClosed_closure smoothingPartitionCutoff_tsupport

/-- Finite telescoping form of the integer partition in Lemma 3.2, reusing
lean-spherical's integer telescoping theorem. -/
theorem smoothingPartitionCutoff_sum (x : ℝ) (M : ℕ) (hM : |x| + 1 ≤ M) :
    ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), smoothingPartitionCutoff (x - n) = 1 := by
  let F : ℤ → ℝ := fun n => Real.smoothTransition (2 * (x - n) - 1 / 2)
  have heq (n : ℤ) : smoothingPartitionCutoff (x - n) = F (n - 1) - F n := by
    simp only [smoothingPartitionCutoff, F, Int.cast_sub, Int.cast_one]
    congr 2; ring
  simp_rw [heq]
  rw [CalderonVaillancourt.sum_Icc_telescope]
  have hleft : F (-(M : ℤ) - 1) = 1 := by
    apply Real.smoothTransition.one_of_one_le
    simp only [Int.cast_sub, Int.cast_neg, Int.cast_natCast, Int.cast_one]
    linarith [neg_abs_le x]
  have hright : F (M : ℤ) = 0 := by
    apply Real.smoothTransition.zero_of_nonpos
    simp only [Int.cast_natCast]
    linarith [le_abs_self x]
  rw [hleft, hright, sub_zero]
/-- The integer translates of the smooth cutoff sum to one, as required in the
first sentence of Lemma 3.2's proof. The sum has finite support at every point. -/
theorem smoothingPartitionCutoff_partition (x : ℝ) :
    ∑' n : ℤ, smoothingPartitionCutoff (x + n) = 1 := by
  obtain ⟨M, hM⟩ := exists_nat_gt (|x| + 1)
  have hfinite : ∀ n : ℤ, n ∉ Finset.Icc (-(M : ℤ)) (M : ℤ) →
      smoothingPartitionCutoff (x - n) = 0 := by
    intro n hn
    apply smoothingPartitionCutoff_eq_zero
    simp only [Finset.mem_Icc, not_and_or, not_le] at hn
    rcases hn with hn | hn
    · have hn' : (n : ℝ) < -(M : ℝ) := by exact_mod_cast hn
      apply le_abs.mpr
      left
      linarith [neg_abs_le x]
    · have hn' : (M : ℝ) < (n : ℝ) := by exact_mod_cast hn
      apply le_abs.mpr
      right
      linarith [le_abs_self x]
  have hsum : (∑' n : ℤ, smoothingPartitionCutoff (x - n)) = 1 := by
    rw [tsum_eq_sum hfinite]
    exact smoothingPartitionCutoff_sum x M hM.le
  have hreindex := (Equiv.neg ℤ).tsum_eq (fun n : ℤ => smoothingPartitionCutoff (x - n))
  simpa only [Equiv.neg_apply, Int.cast_neg, sub_neg_eq_add] using hreindex.trans hsum

                                                                                
                                                                                     
                                      
                                                       
                                       
                                                                     
                                                                      
                                                                                    
                                       
            
                                                
                                     

/-- The high-mass index set in Lemma 3.2's proof. The interval has length R
and intersects the support of the corresponding scaled partition cutoff. -/
def smoothingHighMassIndices (w : ℝ → ℝ) (R ρ : ℝ) : Set ℤ :=
  {n | ∃ a : ℝ,
    (Set.Icc a (a + R) ∩ Function.support
      (fun ξ => smoothingPartitionCutoff (ξ / R + n))).Nonempty ∧
    ρ * (∫ ξ, w ξ) ≤ ∫ ξ in Set.Icc a (a + R), w ξ}

/-- An enlarged frequency window contains any length-R interval used to select
its index in Lemma 3.2. -/
def smoothingFrequencyWindow (R : ℝ) (n : ℤ) : Set ℝ :=
  {ξ | |ξ / R + n| ≤ 2}

/-- The enlarged frequency windows used for counting are measurable. -/
theorem smoothingFrequencyWindow_measurable (R : ℝ) (n : ℤ) :
    MeasurableSet (smoothingFrequencyWindow R n) :=
  (isClosed_le ((continuous_id.div_const R).add continuous_const).abs
    continuous_const).measurableSet

                                                                                  
                                                                             
                                               
                                                                  
                                                          
                           
                                       
                                                                  
            
                        
                                         
                                                     
                                                    
               
                                
                      
                                
                      
             
                    
                                                                                     

                                                                                   
                                                                             
                                                          
                                                       
                                                                   
                          
                
                                                                      
                                                                              

/-- At most six enlarged windows contain any fixed frequency. -/
theorem smoothingFrequencyWindow_overlap (R x : ℝ) (S : Finset ℤ) :
    (S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2)).card ≤ 6 := by
  classical
  let k : ℤ := ⌊-x / R⌋
  have hlow : (k : ℝ) ≤ -x / R := Int.floor_le _
  have hupp : -x / R < (k : ℝ) + 1 := Int.lt_floor_add_one _
  simp only [neg_div] at hlow hupp
  have hsub : S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2) ⊆
      Finset.Icc (k - 2) (k + 3) := by
    intro n hn
    have hn' := (abs_le.mp (Finset.mem_filter.mp hn).2)
    have hlo : (k : ℝ) - 2 ≤ n := by linarith [hn'.1]
    have hhi : (n : ℝ) ≤ (k : ℝ) + 3 := by linarith [hn'.2]
    simp only [Finset.mem_Icc]
    exact ⟨by exact_mod_cast hlo, by exact_mod_cast hhi⟩
  apply (Finset.card_le_card hsub).trans
  rw [Int.card_Icc]
  omega
/-- Bounded overlap bounds the sum of spectral window masses in Lemma 3.2. -/
theorem smoothingFrequencyWindow_sum_integral {w : ℝ → ℝ} (hw : Integrable w volume)
    (hwpos : ∀ᵐ x ∂volume, 0 ≤ w x) (R : ℝ) (S : Finset ℤ) :
    (∑ n ∈ S, ∫ x in smoothingFrequencyWindow R n, w x) ≤ 6 * ∫ x, w x := by
  classical
  simp_rw [← integral_indicator (smoothingFrequencyWindow_measurable R _)]
  rw [← integral_finsetSum S (fun n _ => hw.indicator (smoothingFrequencyWindow_measurable R n)),
    ← integral_const_mul]
  apply integral_mono_ae
    (integrable_finsetSum S (fun n _ => hw.indicator (smoothingFrequencyWindow_measurable R n)))
    (hw.const_mul 6)
  filter_upwards [hwpos] with x hx
  have hsum : (∑ n ∈ S, (smoothingFrequencyWindow R n).indicator w x) =
      ((S.filter (fun n : ℤ => |x / R + (n : ℝ)| ≤ 2)).card : ℝ) * w x := by
    change (∑ n ∈ S, if |x / R + (n : ℝ)| ≤ 2 then w x else 0) = _
    simp only [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  rw [hsum]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast smoothingFrequencyWindow_overlap R x S) hx

                                                                                  
                                                                                  
                                                          
                                                      
                                                        
                              
                                             
                                                             
        
                                          
                                                                                                 
                                                                                
                            
           

                                                                               
                                                                           
                                                                              
                                                          
                                         
                                             
                                                                
           
                                                              
                  
                                           
                                                                          
                                                                                    
                                               
                                                      
                            
                      
                                           
                                                                                 
             

/-- The finite multiplier defining the sharp part in Lemma 3.2. -/
noncomputable def smoothingSharpMultiplier (R : ℝ) (S : Finset ℤ) (ξ : ℝ) : ℝ :=
  ∑ n ∈ S, smoothingPartitionCutoff (ξ / R + n)

/-- The source's finite multiplier is between zero and one. -/
theorem smoothingSharpMultiplier_bounds (R : ℝ) (S : Finset ℤ) (ξ : ℝ) :
    0 ≤ smoothingSharpMultiplier R S ξ ∧ smoothingSharpMultiplier R S ξ ≤ 1 := by
  constructor
  · exact Finset.sum_nonneg fun n _ => (smoothingPartitionCutoff_bounds _).1
  · have hs : Summable (fun n : ℤ => smoothingPartitionCutoff (ξ / R + n)) :=
      by
        by_contra h
        have hz := tsum_eq_zero_of_not_summable h
        rw [smoothingPartitionCutoff_partition] at hz
        norm_num at hz
    simpa only [smoothingPartitionCutoff_partition, smoothingSharpMultiplier] using!
      hs.sum_le_tsum S (fun n _ => (smoothingPartitionCutoff_bounds _).1)

/-- The finite sharp multiplier is measurable. -/
theorem smoothingSharpMultiplier_continuous (R : ℝ) (S : Finset ℤ) :
    Continuous (smoothingSharpMultiplier R S) := by
  apply continuous_finsetSum
  intro n _
  exact smoothingPartitionCutoff_contDiff.continuous.comp
    ((continuous_id.div_const R).add continuous_const)

/-- The sharp Fourier multiplier acts on every L² input. -/
theorem smoothing_memLp_sharpMultiplier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    MemLp (fun ξ => (smoothingSharpMultiplier R S ξ : ℂ) *
      (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) 2 volume := by
  apply (Lp.memLp (𝓕 f)).of_le
    (((Complex.continuous_ofReal.comp (smoothingSharpMultiplier_continuous R
      S)).aestronglyMeasurable).mul
      (Lp.memLp (𝓕 f)).aestronglyMeasurable)
  filter_upwards [] with ξ
  simp only [Pi.mul_apply, Function.comp_apply]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingSharpMultiplier_bounds R S ξ).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingSharpMultiplier_bounds R S ξ).2

/-- The sharp part defined in the displayed formulas of Lemma 3.2's proof. -/
noncomputable def smoothingSharpPart (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  𝓕⁻ ((smoothing_memLp_sharpMultiplier f R S).toLp _)

/-- The flat part in the same source display. -/
noncomputable def smoothingFlatPart (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  f - smoothingSharpPart f R S

/-- The defining Fourier formula for the sharp part, valid almost everywhere. -/
theorem smoothingSharpPart_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume, (𝓕 (smoothingSharpPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
      (smoothingSharpMultiplier R S ξ : ℂ) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
  rw [smoothingSharpPart, fourier_fourierInv_eq]
  exact (smoothing_memLp_sharpMultiplier f R S).coeFn_toLp

/-- The defining Fourier formula for the flat part, valid almost everywhere. -/
theorem smoothingFlatPart_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume, (𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ =
      (1 - (smoothingSharpMultiplier R S ξ : ℂ)) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
  rw [smoothingFlatPart, show 𝓕 (f - smoothingSharpPart f R S) =
    𝓕 f - 𝓕 (smoothingSharpPart f R S) from (Lp.fourierTransformₗᵢ ℝ ℂ).map_sub _ _]
  filter_upwards [Lp.coeFn_sub (𝓕 f) (𝓕 (smoothingSharpPart f R S)),
    smoothingSharpPart_fourier f R S] with ξ hsub hsharp
  rw [hsub, Pi.sub_apply, hsharp]
  ring

                                                                      
                                                             
                                                                                         
                                               

                                                                             
                                                                         
                                                                      
                                         
                                          
                       
                                                            
                                                                    
           
                     
                                                      
                                                
              
                                                                    
                                    
                                                                                                  
                                        
                                                                                          
                                                                           
                                        
                                   
             
                                               
                                                                 
                                                                    
                                                           
                                                  
               
                                

                                                                          
                                                                                 
                                                                               
                                         
                                          
                       
                                                            
                                                                
                                                              
                                                                                
                                                                                  
                                                                               
                                                                                            
                                                                                
                                                                  
                                                                      

/-- The sharp part's L² bound in Lemma 3.2(1). -/
theorem smoothingSharpPart_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : ‖smoothingSharpPart f R S‖ ≤ ‖f‖ := by
  rw [← Lp.norm_fourier_eq (smoothingSharpPart f R S), ← Lp.norm_fourier_eq f]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [smoothingSharpPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingSharpMultiplier_bounds R S ξ).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingSharpMultiplier_bounds R S ξ).2

/-- The flat part's L² bound in Lemma 3.2(1). -/
theorem smoothingFlatPart_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) : ‖smoothingFlatPart f R S‖ ≤ ‖f‖ := by
  rw [← Lp.norm_fourier_eq (smoothingFlatPart f R S), ← Lp.norm_fourier_eq f]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [smoothingFlatPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, ← Complex.ofReal_one, ← Complex.ofReal_sub,
    Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (sub_nonneg.mpr (smoothingSharpMultiplier_bounds R S ξ).2)]
  exact mul_le_of_le_one_left (norm_nonneg _)
    (by linarith [(smoothingSharpMultiplier_bounds R S ξ).1])

                                                                           
                                                                 
                            
                                                                          
                                                                              

/-- The centered spectral piece whose inverse Fourier transform is h_n in
Lemma 3.2(2). Demodulation moves the selected window to the origin. -/
noncomputable def smoothingPieceSpectrum (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) (ξ : ℝ) : ℂ :=
  (smoothingPartitionCutoff (ξ / R) : ℂ) *
    (𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ - n * R)

/-- The smooth physical piece h_n in Lemma 3.2(2). -/
noncomputable def smoothingPiece (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : ℝ → ℂ := 𝓕⁻ (smoothingPieceSpectrum f R n)

/-- Compactness of the centered scaled cutoff supporting each spectral piece. -/
theorem smoothing_scaledCutoff_compact {R : ℝ} (hR : 0 < R) :
    HasCompactSupport (fun ξ : ℝ => smoothingPartitionCutoff (ξ / R)) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_Icc : IsCompact (Set.Icc (-R) R))
  intro ξ hξ
  have hb : |ξ / R| < 3 / 4 :=
    lt_of_not_ge fun h => hξ (smoothingPartitionCutoff_eq_zero h)
  rw [abs_div, abs_of_pos hR, div_lt_iff₀ hR] at hb
  apply abs_le.mp
  linarith

/-- Every spectral moment of a centered piece is integrable; this justifies
all smooth derivatives in Lemma 3.2(2), even for inputs only in L². -/
theorem smoothingPieceSpectrum_moments (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (k : ℕ) :
    Integrable (fun ξ : ℝ => ‖ξ‖ ^ k * ‖smoothingPieceSpectrum f R n ξ‖) volume := by
  have hc : Continuous (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) :=
    (continuous_norm.pow k).mul
      (smoothingPartitionCutoff_contDiff.continuous.comp (continuous_id.div_const R))
  have hcompact : HasCompactSupport (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) :=
    (smoothing_scaledCutoff_compact hR).mul_left
  have hc2 : MemLp (fun ξ : ℝ => ‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) 2 volume :=
    hc.memLp_of_hasCompactSupport hcompact
  have hF := (Lp.memLp (𝓕 f)).comp_measurePreserving
    (measurePreserving_add_right volume (-(n : ℝ) * R))
  have hprod := hc2.integrable_mul hF.norm
  change Integrable (fun ξ : ℝ => (‖ξ‖ ^ k * smoothingPartitionCutoff (ξ / R)) *
    ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ + (-(n : ℝ) * R))‖) volume at hprod
  simpa only [smoothingPieceSpectrum, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingPartitionCutoff_bounds _).1, Function.comp_def,
    sub_eq_add_neg, neg_mul, Pi.mul_apply, mul_assoc] using! hprod

                                                                            
                                                            
                                                                            
                                                              
                                                                              
                                                                      
                                          
                            

                                                                                
                                                                                            
                                       
                                                                         
                                                   
                                                                      
                                                                                 
                                                   
                                           
                                                                                                 
                                          
                                                                          
                 
                                                                            
                                                                 
                                                    
                                                                  
                                                          
                                                                                             
                                                                   
                                                
                                                                       
                                                                            
                           
                                             
           
                      
                                                                         
                                                  
             
                            
                      
                                                        
                      
                                                  

/-- The centered spectrum defining h_n belongs to L². -/
theorem smoothingPieceSpectrum_memLp (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : MemLp (smoothingPieceSpectrum f R n) 2 volume := by
  have hF := (Lp.memLp (𝓕 f)).comp_measurePreserving
    (measurePreserving_add_right volume (-(n : ℝ) * R))
  unfold smoothingPieceSpectrum
  simp only [sub_eq_add_neg, ← neg_mul]
  apply hF.of_le
    ((Complex.continuous_ofReal.comp (smoothingPartitionCutoff_contDiff.continuous.comp
      (continuous_id.div_const R))).aestronglyMeasurable.mul hF.aestronglyMeasurable)
  filter_upwards [] with ξ
  simp only [Pi.mul_apply, Function.comp_apply, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (smoothingPartitionCutoff_bounds _).1]
  exact mul_le_of_le_one_left (norm_nonneg _) (smoothingPartitionCutoff_bounds _).2

                                                                             
                                                                         
                                                                      
                                                                                         
                                                                                          
                                                                              

/-- The L² class of the smooth piece h_n from Lemma 3.2. -/
noncomputable def smoothingPieceL2 (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : Lp (α := ℝ) ℂ 2 volume :=
  𝓕⁻ ((smoothingPieceSpectrum_memLp f R n).toLp _)

                                                               
                                                         
                                  
                                                                
                                                                            
                                        

/-- The defining L² Fourier transform of the smooth piece h_n. -/
theorem smoothingPieceL2_fourier (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) :
    ⇑(𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume) =ᵐ[volume]
      smoothingPieceSpectrum f R n := by
  rw [smoothingPieceL2, fourier_fourierInv_eq]
  exact (smoothingPieceSpectrum_memLp f R n).coeFn_toLp

                                                                              
                                                                     
                                  
                                      
                                                                       
                                                           
            
                                 
                                                                   
                                                      
                                          
                                               
            
                                        

/-- The individual L² bound for h_n in Lemma 3.2(2), with constant one. -/
theorem smoothingPieceL2_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (n : ℤ) : ‖smoothingPieceL2 f R n‖ ≤ ‖f‖ := by
  have hbound : ‖(𝓕 (smoothingPieceL2 f R n) : Lp (α := ℝ) ℂ 2 volume)‖ ≤
      ‖smoothingTranslationL2 (-(n : ℝ) * R) (𝓕 f)‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [smoothingPieceL2_fourier f R n,
      smoothingTranslationL2_coe (-(n : ℝ) * R) (𝓕 f)] with ξ hξ ht
    rw [hξ, ht, smoothingPieceSpectrum, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (smoothingPartitionCutoff_bounds _).1]
    simp only [sub_eq_add_neg, neg_mul]
    exact mul_le_of_le_one_left (norm_nonneg _) (smoothingPartitionCutoff_bounds _).2
  simpa only [Lp.norm_fourier_eq, LinearIsometry.norm_map] using hbound

                                                                               
                                                                     
                                  
                 
                                                                          
                                   
                                                                                         
                                   
                                                                 
                                          
                                    
                                                              
                                                     
                                       
                                     
                                                                                             

                                                                  
                                                                         
                                         
                              
                                                                                  
                                             
                                                   
                                                                  
                  
              
                                                                                    
                                                   
                                      
                                                                                                  
            
                   
                
                                                                          

                                                                                  
                                                    
                                                                           
                                         
                                              
                                                                                         
                                                  
                                           
                                                                      
                                                                          
                                                    
                                                                                 
                     
           
                            
           
                 

                                                                        
                                     
                                                                  
                                         
                                              
                                       
                                                                                  
                                                                          
         
                            
           
                                                               
                                                                                
                               
           
                                                                   
             
        
                                                 

/-- Schwartz-test Fourier duality for arbitrary L² inputs, used for the
uniform derivative bound in Lemma 3.2(2). -/
theorem smoothing_integral_schwartz_mul_fourier (Q : SchwartzMap ℝ ℂ)
    (f : Lp (α := ℝ) ℂ 2 volume) :
    (∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ) = ∫ x, (𝓕 Q) x * f x := by
  have hd := congrArg (fun T : TemperedDistribution ℝ ℂ => T Q)
    (Lp.fourier_toTemperedDistribution_eq f)
  simpa only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply,
    smul_eq_mul] using hd.symm

/-- A physical L∞ bound controls the spectral pairing by the L¹ norm of the
Schwartz kernel. This extends the needed multiplier bound to L² inputs. -/
theorem smoothing_norm_schwartz_pairing_le (Q : SchwartzMap ℝ ℂ)
    (f : Lp (α := ℝ) ℂ 2 volume) {M : ℝ} (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) :
    ‖∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ≤
      M * ∫ x, ‖(𝓕 Q) x‖ := by
  rw [smoothing_integral_schwartz_mul_fourier, ← integral_const_mul]
  apply norm_integral_le_of_norm_le ((𝓕 Q).integrable.norm.const_mul M)
  filter_upwards [hf] with x hx
  rw [norm_mul, mul_comm M]
  exact mul_le_mul_of_nonneg_left hx (norm_nonneg _)
/-- The real Fourier scaling identity underlying the uniform derivative
constant in Lemma 3.2(2). -/
theorem smoothing_fourier_scale (ψ : ℝ → ℂ) {R : ℝ} (hR : 0 < R) (y : ℝ) :
    (𝓕 (fun ξ : ℝ => ψ (ξ / R))) y = R • (𝓕 ψ) (R * y) := by
  rw [Real.fourier_eq, Real.fourier_eq]
  calc
    _ = ∫ ξ : ℝ, (fun u : ℝ => Real.fourierChar (-inner ℝ u (R * y)) • ψ u) (ξ / R) := by
      apply integral_congr_ae
      filter_upwards [] with ξ
      congr 2
      simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial]
      field_simp
    _ = _ := by
      simpa only [abs_of_pos hR] using!
        (Measure.integral_comp_div (fun u : ℝ =>
          Real.fourierChar (-inner ℝ u (R * y)) • ψ u) R)

/-- Scaling the frequency cutoff preserves the L¹ norm of its Fourier kernel. -/
theorem smoothing_integral_norm_fourier_scale (ψ : ℝ → ℂ) {R : ℝ} (hR : 0 < R) :
    (∫ y : ℝ, ‖(𝓕 (fun ξ : ℝ => ψ (ξ / R))) y‖) = ∫ y : ℝ, ‖(𝓕 ψ) y‖ := by
  simp_rw [smoothing_fourier_scale ψ hR, norm_smul, Real.norm_eq_abs, abs_of_pos hR]
  rw [integral_const_mul]
  have hs := Measure.integral_comp_mul_left (fun y : ℝ => ‖(𝓕 ψ : ℝ → ℂ) y‖) R
  have hs' : (∫ y : ℝ, ‖(𝓕 ψ : ℝ → ℂ) (R * y)‖) =
      R⁻¹ * ∫ y : ℝ, ‖(𝓕 ψ : ℝ → ℂ) y‖ := by
    simpa only [smul_eq_mul, abs_inv, abs_of_pos hR] using! hs
  rw [hs', ← mul_assoc, mul_inv_cancel₀ hR.ne', one_mul]
/-- The Fourier character is smooth as a complex-valued function. -/
theorem smoothing_fourierChar_contDiff (a : ℝ) :
    ContDiff ℝ ∞ (fun ξ : ℝ => (Real.fourierChar (inner ℝ a ξ) : ℂ)) := by
  simp_rw [Real.fourierChar_apply, RCLike.inner_apply, starRingEnd_apply, star_trivial]
  have hc : ContDiff ℝ ∞ (fun t : ℝ => (t : ℂ)) := Complex.ofRealCLM.contDiff
  fun_prop

/-- A smooth compact frequency multiplier has a scale-uniform L∞ bound on L²
inputs. This is the arbitrary-L² extension needed for Lemma 3.2(2). -/
theorem smoothing_scaled_multiplier_bound (φ : SchwartzMap ℝ ℂ)
    (hφ : HasCompactSupport (φ : ℝ → ℂ)) (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) {M : ℝ} (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) (x : ℝ) :
    ‖(𝓕⁻ (fun ξ : ℝ => φ (ξ / R) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ)) x‖ ≤
      M * ∫ y : ℝ, ‖(𝓕 φ) y‖ := by
  have hscaled : HasCompactSupport (fun ξ : ℝ => φ (ξ / R)) := by
    simpa only [Function.comp_def, Homeomorph.coe_mulRight₀, div_eq_mul_inv] using
      hφ.comp_homeomorph (Homeomorph.mulRight₀ R⁻¹ (inv_ne_zero hR.ne'))
  let q : ℝ → ℂ := fun ξ => (Real.fourierChar (inner ℝ x ξ) : ℂ) * φ (ξ / R)
  have hqc : HasCompactSupport q := hscaled.mul_left
  have hqs : ContDiff ℝ ∞ q :=
    (smoothing_fourierChar_contDiff x).mul (φ.smooth ⊤ |>.comp (contDiff_id.div_const R))
  let Q : SchwartzMap ℝ ℂ := hqc.toSchwartzMap hqs
  have hraw : (𝓕⁻ (fun ξ : ℝ => φ (ξ / R) * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ)) x =
      ∫ ξ, Q ξ * (𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ := by
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards [] with ξ
    change Real.fourierChar (inner ℝ ξ x) • (φ (ξ / R) * _) =
      ((Real.fourierChar (inner ℝ x ξ) : ℂ) * φ (ξ / R)) * _
    rw [real_inner_comm ξ x, Circle.smul_def, smul_eq_mul, mul_assoc]
  have hQF (y : ℝ) : (𝓕 Q) y = (𝓕 (fun ξ : ℝ => φ (ξ / R))) (y - x) := by
    rw [SchwartzMap.fourier_coe]
    exact smoothing_fourier_modulation_integral x (fun ξ : ℝ => φ (ξ / R)) y
  have hkernel : (∫ y : ℝ, ‖(𝓕 Q) y‖) = ∫ y : ℝ, ‖(𝓕 φ) y‖ := by
    simp_rw [hQF, sub_eq_add_neg]
    rw [integral_add_right_eq_self
      (fun y : ℝ => ‖(𝓕 (fun ξ : ℝ => φ (ξ / R)) : ℝ → ℂ) y‖) (-x)]
    simpa only [SchwartzMap.fourier_coe] using smoothing_integral_norm_fourier_scale (φ : ℝ → ℂ)
      hR
  rw [hraw, ← hkernel]
  exact smoothing_norm_schwartz_pairing_le Q f hf
/-- The one-dimensional inverse-Fourier derivative formula needed for the
R^N derivative estimate in Lemma 3.2(2). -/
theorem smoothing_iteratedDeriv_fourierInv {H : ℝ → ℂ}
    (hHm : AEStronglyMeasurable H volume)
    (hH : ∀ k : ℕ, Integrable (fun ξ : ℝ => ‖ξ‖ ^ k * ‖H ξ‖) volume) (N : ℕ) :
    iteratedDeriv N (𝓕⁻ H) =
      𝓕⁻ (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N * H ξ) := by
  have hneg : ∀ k : ℕ, Integrable (fun ξ : ℝ => ξ ^ k • H (-ξ)) volume := by
    intro k
    have hmeas := (continuous_pow k).aestronglyMeasurable.smul
      (hHm.comp_measurePreserving (Measure.measurePreserving_neg volume))
    apply (integrable_norm_iff hmeas).mp
    change Integrable (fun ξ : ℝ => ‖(ξ ^ k : ℝ) • H (-ξ)‖) volume
    have hi := ((Measure.measurePreserving_neg volume).integrable_comp (hH k).1).mpr (hH k)
    simpa only [Function.comp_def, Pi.smul_apply, norm_neg, norm_smul, norm_pow] using hi
  rw [Real.fourierInv_eq_fourier_comp_neg,
    Real.iteratedDeriv_fourier (N := ⊤) (fun k _ => hneg k) (by simp),
    Real.fourierInv_eq_fourier_comp_neg]
  congr 1
  funext ξ
  simp only [smul_eq_mul, Complex.ofReal_neg]
  congr 2
  ring
/-- The fixed derivative cutoff (2πiξ)^N φ(ξ), whose Fourier kernel supplies
the order-dependent constant in Lemma 3.2(2). -/
noncomputable def smoothingDerivativeCutoff (N : ℕ) : SchwartzMap ℝ ℂ := by
  let u : ℝ → ℂ := fun ξ => (2 * Real.pi * Complex.I * ξ) ^ N *
    (smoothingPartitionCutoff ξ : ℂ)
  have hcompact : HasCompactSupport u :=
    (smoothingPartitionCutoff_hasCompactSupport.comp_left (g := Complex.ofReal) rfl).mul_left
  have hc : ContDiff ℝ ∞ (fun t : ℝ => (t : ℂ)) := Complex.ofRealCLM.contDiff
  have hu : ContDiff ℝ ∞ u := by
    unfold u
    have hp : ContDiff ℝ ∞ (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N) := by fun_prop
    exact hp.mul (hc.comp smoothingPartitionCutoff_contDiff)
  exact hcompact.toSchwartzMap hu

/-- Evaluation of the fixed derivative cutoff. -/
theorem smoothingDerivativeCutoff_apply (N : ℕ) (ξ : ℝ) :
    smoothingDerivativeCutoff N ξ = (2 * Real.pi * Complex.I * ξ) ^ N *
      (smoothingPartitionCutoff ξ : ℂ) := rfl

/-- The derivative cutoff has compact support, as required for the uniform
multiplier estimate. -/
theorem smoothingDerivativeCutoff_compact (N : ℕ) :
    HasCompactSupport (smoothingDerivativeCutoff N : ℝ → ℂ) := by
  change HasCompactSupport (fun ξ : ℝ => (2 * Real.pi * Complex.I * ξ) ^ N *
    (smoothingPartitionCutoff ξ : ℂ))
  exact (smoothingPartitionCutoff_hasCompactSupport.comp_left (g := Complex.ofReal) rfl).mul_left

/-- The derivative constant depends only on the order N and the fixed cutoff. -/
noncomputable def smoothingDerivativeConstant (N : ℕ) : ℝ :=
  ∫ x : ℝ, ‖(𝓕 (smoothingDerivativeCutoff N)) x‖

/-- Extracting R^N from the derivative multiplier in Lemma 3.2(2). -/
theorem smoothingDerivativeCutoff_scale (N : ℕ) {R : ℝ} (hR : 0 < R) (ξ : ℝ) :
    (R ^ N : ℝ) • smoothingDerivativeCutoff N (ξ / R) =
      (2 * Real.pi * Complex.I * ξ) ^ N * (smoothingPartitionCutoff (ξ / R) : ℂ) := by
  rw [smoothingDerivativeCutoff_apply, Complex.real_smul, Complex.ofReal_pow, ← mul_assoc, ←
    mul_pow]
  congr 2
  push_cast
  field_simp [hR.ne']
/-- The derivative of h_n is R^N times a fixed scaled multiplier applied to
a modulation of f. This keeps the derivative constant independent of n and R. -/
theorem smoothingPiece_iteratedDeriv (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (N : ℕ) (x : ℝ) :
    iteratedDeriv N (smoothingPiece f R n) x =
      (R ^ N : ℝ) • (𝓕⁻ (fun ξ : ℝ => smoothingDerivativeCutoff N (ξ / R) *
        (𝓕 (smoothingModulationL2 ((n : ℝ) * R) f) : Lp (α := ℝ) ℂ 2 volume) ξ)) x := by
  have hgf : ∀ᵐ ξ ∂volume,
      (𝓕 (smoothingModulationL2 ((n : ℝ) * R) f) : Lp (α := ℝ) ℂ 2 volume) ξ =
        (𝓕 f : Lp (α := ℝ) ℂ 2 volume) (ξ - n * R) := by
    rw [smoothing_fourier_modulation]
    simpa only [sub_eq_add_neg] using! smoothingTranslationL2_coe (-((n : ℝ) * R)) (𝓕 f)
  rw [smoothingPiece, smoothing_iteratedDeriv_fourierInv
    (smoothingPieceSpectrum_memLp f R n).aestronglyMeasurable (smoothingPieceSpectrum_moments f hR
      n)]
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_smul]
  apply integral_congr_ae
  filter_upwards [hgf] with ξ hξ
  rw [hξ, smoothingPieceSpectrum, ← mul_assoc, ← smoothingDerivativeCutoff_scale N hR ξ]
  simp only [Circle.smul_def, Complex.real_smul, smul_eq_mul]
  ring

/-- The uniform derivative inequality in Lemma 3.2(2). Every almost-everywhere
bound M for the input gives the stated bound C_N R^N M for all points x;
C_N depends only on N and the fixed cutoff. -/
theorem smoothingPiece_derivative_bound (f : Lp (α := ℝ) ℂ 2 volume)
    {R : ℝ} (hR : 0 < R) (n : ℤ) (N : ℕ) {M : ℝ}
    (hf : ∀ᵐ x ∂volume, ‖f x‖ ≤ M) (x : ℝ) :
    ‖iteratedDeriv N (smoothingPiece f R n) x‖ ≤
      smoothingDerivativeConstant N * R ^ N * M := by
  have hg : ∀ᵐ y ∂volume, ‖smoothingModulationL2 ((n : ℝ) * R) f y‖ ≤ M := by
    filter_upwards [smoothingModulationL2_coe ((n : ℝ) * R) f, hf] with y hy hfy
    simpa only [hy, Circle.norm_smul] using hfy
  have hb := smoothing_scaled_multiplier_bound (smoothingDerivativeCutoff N)
    (smoothingDerivativeCutoff_compact N) (smoothingModulationL2 ((n : ℝ) * R) f) hR hg x
  rw [smoothingPiece_iteratedDeriv f hR n N x, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hR.le N)]
  calc
    _ ≤ R ^ N * (M * smoothingDerivativeConstant N) :=
      mul_le_mul_of_nonneg_left hb (pow_nonneg hR.le N)
    _ = _ := by ring

                                                                         
                                                                                          
                                                                       
                            
                                                        
                                                                         
                                                             
           
                        

/-- If every cutoff active at a frequency has been selected, the sharp multiplier
is one. This is the covering observation in Lemma 3.2's flat-energy argument. -/
theorem smoothingSharpMultiplier_eq_one (R ξ : ℝ) (S : Finset ℤ)
    (hcover : ∀ n : ℤ, smoothingPartitionCutoff (ξ / R + n) ≠ 0 → n ∈ S) :
    smoothingSharpMultiplier R S ξ = 1 := by
  have hsum := smoothingPartitionCutoff_partition (ξ / R)
  rw [tsum_eq_sum (s := S) (fun n hn => by
    by_contra h
    exact hn (hcover n h))] at hsum
  exact hsum

/-- The flat Fourier multiplier vanishes on any length-R interval whose input
mass meets the threshold in Lemma 3.2's selection. -/
theorem smoothingFlatPart_zero_on_high_interval (f : Lp (α := ℝ) ℂ 2 volume)
    (R ρ a : ℝ) (S : Finset ℤ)
    (hselect : ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ)
    (hm : ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ∫ ξ in Set.Icc a (a + R), ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) :
    ∀ᵐ ξ ∂volume.restrict (Set.Icc a (a + R)),
      (𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ = 0 := by
  filter_upwards [ae_restrict_mem measurableSet_Icc,
    ae_restrict_of_ae (smoothingFlatPart_fourier f R S)] with ξ hξ hflat
  have hcover : ∀ n : ℤ, smoothingPartitionCutoff (ξ / R + n) ≠ 0 → n ∈ S := by
    intro n hn
    apply (hselect n).mpr
    exact ⟨a, ⟨ξ, hξ, hn⟩, hm⟩
  rw [hflat, smoothingSharpMultiplier_eq_one R ξ S hcover, Complex.ofReal_one, sub_self, zero_mul]

/-- Pointwise spectral domination of the flat part, used on the remaining
low-mass intervals in the proof of (3.25). -/
theorem smoothingFlatPart_fourier_norm_le (f : Lp (α := ℝ) ℂ 2 volume)
    (R : ℝ) (S : Finset ℤ) :
    ∀ᵐ ξ ∂volume,
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ≤
      ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ := by
  filter_upwards [smoothingFlatPart_fourier f R S] with ξ hξ
  rw [hξ, norm_mul, ← Complex.ofReal_one, ← Complex.ofReal_sub, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr (smoothingSharpMultiplier_bounds R S ξ).2)]
  exact mul_le_of_le_one_left (norm_nonneg _)
    (by linarith [(smoothingSharpMultiplier_bounds R S ξ).1])

/-- Every length-R interval has small flat Fourier mass, as used in the final
contradiction proving Lemma 3.2(3). -/
theorem smoothingFlatPart_interval_mass (f : Lp (α := ℝ) ℂ 2 volume)
    (R a : ℝ) {ρ : ℝ} (hρ : 0 < ρ) (S : Finset ℤ)
    (hselect : ∀ n : ℤ, n ∈ S ↔ n ∈ smoothingHighMassIndices
      (fun ξ => ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) R ρ) :
    (∫ ξ in Set.Icc a (a + R),
      ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) := by
  by_cases hm : ρ * (∫ ξ, ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) ≤
      ∫ ξ in Set.Icc a (a + R), ‖(𝓕 f : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2
  · have hz := smoothingFlatPart_zero_on_high_interval f R ρ a S hselect hm
    have hint : (∫ ξ in Set.Icc a (a + R),
        ‖(𝓕 (smoothingFlatPart f R S) : Lp (α := ℝ) ℂ 2 volume) ξ‖ ^ 2) = 0 := by
      apply integral_eq_zero_of_ae
      filter_upwards [hz] with ξ hξ
      simp only [hξ, norm_zero, zero_pow (by decide : (2 : ℕ) ≠ 0), Pi.zero_apply]
    rw [hint]
    exact mul_nonneg hρ.le (integral_nonneg fun ξ => sq_nonneg _)
  · apply le_trans _ (not_le.mp hm).le
    have hg := (memLp_two_iff_integrable_sq_norm
      (Lp.memLp (𝓕 (smoothingFlatPart f R S))).aestronglyMeasurable).mp (Lp.memLp (𝓕
        (smoothingFlatPart f R S)))
    have hf := (memLp_two_iff_integrable_sq_norm (Lp.memLp (𝓕 f)).aestronglyMeasurable).mp
      (Lp.memLp (𝓕 f))
    apply integral_mono_ae hg.integrableOn hf.integrableOn
    filter_upwards [ae_restrict_of_ae (smoothingFlatPart_fourier_norm_le f R S)] with ξ hξ
    exact pow_le_pow_left₀ (norm_nonneg _) hξ 2
