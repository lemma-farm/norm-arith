/-- The correlation in Lemma 3.1 is integrable at every frequency. -/
theorem smoothing_integrable_fourierCorrelation
    {E : Type*} [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (f : Lp (α := E) ℂ 2 volume) (ξ : E) :
    Integrable (fun η => (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
      star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) volume := by
  exact ((Lp.memLp (𝓕 f)).comp_measurePreserving
    (measurePreserving_add_left volume ξ)).integrable_mul (Lp.memLp (𝓕 f)).star

