    ∀ᵐ ξ ∂volume, MemLp (fun η =>
      (𝓕 f : Lp (α := E) ℂ 2 volume) (ξ + η) *
        star ((𝓕 f : Lp (α := E) ℂ 2 volume) η)) 2 volume := by
  have hw : Integrable (fun η => ‖(𝓕 f : Lp (α := E) ℂ 2 volume) η‖ ^ 2) volume :=
