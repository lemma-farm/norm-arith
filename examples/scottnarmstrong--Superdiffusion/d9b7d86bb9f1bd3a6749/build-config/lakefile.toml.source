"name" = "superdiffusion_formalization"
"defaultTargets" = ["Algsuperdiff"]
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SuperdiffusionAudit"
"globs" = ["SuperdiffusionAudit.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}, "warn" = {"classDefReducibility" = false}}

[["lean_lib"]]
"name" = "Algsuperdiff"
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}, "warn" = {"classDefReducibility" = false}}
