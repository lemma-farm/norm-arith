"name" = "typed_triangle_absorption"
"version" = "1.0.0"
"requiresModuleSystem" = true
"defaultTargets" = ["Challenge", "Solution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "PartitionedTriangleAbsorption"
"roots" = ["PartitionedTriangleAbsorption"]
"globs" = ["PartitionedTriangleAbsorption", "PartitionedTriangleAbsorption.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
