"name" = "nair_tenenbaum"
"version" = "0.1.0"
"defaultTargets" = ["NairTenenbaum", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "NairTenenbaum"
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true}}}
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
