"name" = "Erdos173"
"defaultTargets" = ["OAI", "Erdos173", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "OAI"
"globs" = ["OAI.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Erdos173"
"globs" = ["Erdos173.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
