"name" = "slowEquilibration"
"version" = "1.0.0"
"defaultTargets" = ["Solution", "Audit"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "SlowEquilibration"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."

[["lean_lib"]]
"name" = "Audit"
"srcDir" = "."

[["lean_lib"]]
"name" = "BrownianMotion"
"srcDir" = "vendor/all-lean"
"globs" = ["BrownianMotion.+"]
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "Common"
"srcDir" = "vendor/all-lean"
"globs" = ["Common.+"]

[["lean_lib"]]
"name" = "FRSB"
"srcDir" = "vendor/all-lean"
"globs" = ["FRSB.+"]

[["lean_lib"]]
"name" = "FourPapersCommon"
"srcDir" = "vendor/all-lean"
"globs" = ["FourPapersCommon.+"]

[["lean_lib"]]
"name" = "KolmogorovExtension4"
"srcDir" = "vendor/all-lean"
"globs" = ["KolmogorovExtension4.+"]
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "Lemmas"
"srcDir" = "vendor/all-lean"
"globs" = ["Lemmas.+"]
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "OverlapPaper"
"srcDir" = "vendor/all-lean"
"globs" = ["OverlapPaper.+"]

[["lean_lib"]]
"name" = "Paper"
"srcDir" = "vendor/all-lean"
"globs" = ["Paper", "Paper.+"]

[["lean_lib"]]
"name" = "ParisiFormula"
"srcDir" = "vendor/all-lean"
"globs" = ["ParisiFormula.+"]
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "QuantitativeFollowup"
"srcDir" = "vendor/all-lean"
"globs" = ["QuantitativeFollowup.+"]

[["lean_lib"]]
"name" = "QuantitativePaper"
"srcDir" = "vendor/all-lean"
"globs" = ["QuantitativePaper.+"]

[["lean_lib"]]
"name" = "StochasticCalculus"
"srcDir" = "vendor/all-lean"
"globs" = ["StochasticCalculus.+"]

[["lean_lib"]]
"name" = "Targets"
"srcDir" = "vendor/all-lean"
"globs" = ["Targets.+"]
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "SphericalAging"
"srcDir" = "vendor/all-lean"
"globs" = ["SphericalAging.+"]

[["lean_lib"]]
"name" = "OAI"
"srcDir" = "vendor/openai-math"
"globs" = ["OAI.+"]
"leanOptions" = {"autoImplicit" = false}

[["lean_lib"]]
"name" = "SixHeadlines"
"srcDir" = "."

[["lean_lib"]]
"name" = "SixHeadlinesAudit"
"srcDir" = "."

[["lean_lib"]]
"name" = "PressureLowerTailsAudit"
"srcDir" = "."
