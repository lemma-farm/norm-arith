"name" = "hypoelliptic_aleksandrov"
"defaultTargets" = ["HypoellipticAleksandrov", "FullCoefficientChallenge", "FullCoefficientSolution", "KineticAleksandrovChallenge", "KineticAleksandrovSolution"]
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "PDEFoundation"
"globs" = ["PDEFoundation.+"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "HypoellipticAleksandrov"
"globs" = ["HypoellipticAleksandrov.*"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "FullCoefficientChallenge"
"roots" = ["AleksandrovComparators.FullCoefficient.Challenge"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "FullCoefficientSolution"
"roots" = ["AleksandrovComparators.FullCoefficient.Solution"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "KineticAleksandrovChallenge"
"roots" = ["AleksandrovComparators.KineticAleksandrov.Challenge"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."

[["lean_lib"]]
"name" = "KineticAleksandrovSolution"
"roots" = ["AleksandrovComparators.KineticAleksandrov.Solution"]
"leanOptions" = {"autoImplicit" = false, "relaxedAutoImplicit" = false, "linter" = {"unusedVariables" = true, "unusedSectionVars" = true, "unusedSimpArgs" = true, "unnecessarySimpa" = true, "deprecated" = true}}
"srcDir" = "."
