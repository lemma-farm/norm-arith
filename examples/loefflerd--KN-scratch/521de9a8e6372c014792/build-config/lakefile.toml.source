"name" = "KNIndependent"
"allowNonModules" = true
"defaultTargets" = ["Definitions", "Theorems", "Solutions", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Definitions"
"globs" = ["Definitions.+"]

[["lean_lib"]]
"name" = "Theorems"
"globs" = ["Theorems.+"]

[["lean_lib"]]
"name" = "Solutions"
"globs" = ["Solutions.+"]

[["lean_lib"]]
"name" = "Challenge"

[["lean_lib"]]
"name" = "Solution"
