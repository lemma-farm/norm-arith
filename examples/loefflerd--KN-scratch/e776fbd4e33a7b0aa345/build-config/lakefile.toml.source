"name" = "KNIndependent"
"allowNonModules" = true
"defaultTargets" = ["Definitions", "Theorems", "Solutions", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Definitions"
"globs" = ["Definitions.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Theorems"
"globs" = ["Theorems.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solutions"
"globs" = ["Solutions.+"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
