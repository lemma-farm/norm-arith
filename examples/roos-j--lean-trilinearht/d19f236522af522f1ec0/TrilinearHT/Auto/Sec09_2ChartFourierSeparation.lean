def GeomBound {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] (f : E → F) (x : E) (K R : ℝ) (m : ℕ) : Prop :=
  ∀ i ≤ m, ‖iteratedFDeriv ℝ i f x‖ ≤ K * R ^ i

section GeomBoundCalculus
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

theorem GeomBound.K_nonneg {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : E → F} {x : E} {K R : ℝ} {m : ℕ} (h : GeomBound f x K R m) : 0 ≤ K := by
  have := h 0 (Nat.zero_le _)
  simp only [pow_zero, mul_one] at this
  exact (norm_nonneg _).trans this

theorem GeomBound.mono {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : E → F} {x : E} {K R K' R' : ℝ} {m : ℕ} (h : GeomBound f x K R m)
    (hK : K ≤ K') (hR0 : 0 ≤ R) (hR : R ≤ R') : GeomBound f x K' R' m := fun i hi =>
  (h i hi).trans (mul_le_mul hK (pow_le_pow_left₀ hR0 hR i) (by positivity)
    (h.K_nonneg.trans hK))

/-- Leibniz rule for geometric bounds. -/
theorem GeomBound.mul {A : Type*} [NormedCommRing A] [NormedAlgebra ℝ A]
    {f g : E → A} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    {x : E} {K₁ R₁ K₂ R₂ : ℝ} {m : ℕ} (hR₁ : 0 ≤ R₁)
    (h₁ : GeomBound f x K₁ R₁ m) (h₂ : GeomBound g x K₂ R₂ m) :
    GeomBound (fun y => f y * g y) x (K₁ * K₂) (R₁ + R₂) m := by
  intro j hj
  have hK₁ := h₁.K_nonneg
  have hK₂ := h₂.K_nonneg
  calc
    _ ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) *
        ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (j - i) g x‖ :=
      norm_iteratedFDeriv_mul_le hf hg x (by simp)
    _ ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * (K₁ * R₁ ^ i) *
        (K₂ * R₂ ^ (j - i)) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ j := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi
      apply mul_le_mul (mul_le_mul_of_nonneg_left (h₁ i (hi'.trans hj)) (by positivity))
        (h₂ (j - i) ((Nat.sub_le _ _).trans hj)) (norm_nonneg _) (by positivity)
    _ = (K₁ * K₂) * (R₁ + R₂) ^ j := by
      rw [add_pow, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring

                                                           
                                                                          
                                              
                                                                                 
                                                
                                                                  
            
                                                                                        
      
                                                                
                                                                         
                                        

                                                                                      
                                                                                       
                                                                                      
                                                       
                                       
                                                          
            
                                                                    
                                                                                                 
                                                      
                                                                            
                                         
                                                                   
      
                                                                                    
                                  

                                               
                                                                            
                                                                                             
           
                                           
        
                                                               
                                        
              

                                                              
                                                                                
                                            
           
                                                                  
                         
                  
                                           
                              
                   
                                           
                              
                                                                                              
                       

                                            
                                                                     
                                                
                                                
                                                                              
                                  

                                                   
theorem GeomBound.ofReal {f : E → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) {x : E} {K R : ℝ} {m : ℕ}
    (h : GeomBound f x K R m) : GeomBound (fun y => (f y : ℂ)) x K R m := by
  intro i hi
  have he : (fun y => (f y : ℂ)) = Complex.ofRealLI ∘ f := rfl
  rw [he, Complex.ofRealLI.norm_iteratedFDeriv_comp_left hf.contDiffAt (by simp)]
  exact h i hi

/-- The Fourier character of a phase with geometric bounds. -/
theorem GeomBound.fourierChar {φ : E → ℝ} (hφ : ContDiff ℝ (⊤ : ℕ∞) φ) {x : E}
    {K R : ℝ} {m : ℕ} (hR : 0 ≤ R) (h : GeomBound φ x K R m) :
    GeomBound (fun y => (Real.fourierChar (φ y) : ℂ)) x 1
      ((m + 1) * (2 * Real.pi) * (max K 1 * R)) m := by
  intro n hn
  have hK1 : 1 ≤ max K 1 := le_max_right _ _
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDeriv ℝ i φ x‖ ≤ (max K 1 * R) ^ i := by
    intro i hi1 hin
    calc ‖iteratedFDeriv ℝ i φ x‖ ≤ K * R ^ i := h i (hin.trans hn)
      _ ≤ max K 1 ^ i * R ^ i := by
          gcongr
          exact (le_max_left _ _).trans (le_self_pow₀ hK1 (by omega))
      _ = _ := (mul_pow _ _ _).symm
  have hC : ∀ i, i ≤ n → ‖iteratedFDeriv ℝ i (fun t : ℝ => (Real.fourierChar t : ℂ)) (φ x)‖ ≤
      (2 * Real.pi) ^ n := fun i hi => by
    rw [chart_fourierChar_derivative_norm]
    exact pow_le_pow_right₀ (by linarith [Real.pi_gt_three]) hi
  have hcomp := norm_iteratedFDeriv_comp_le (n := n) chart_fourierChar_smooth hφ (by simp) x
    hC hD
  change ‖iteratedFDeriv ℝ n (fun y => (Real.fourierChar (φ y) : ℂ)) x‖ ≤ _ at hcomp
  have hfact : (n.factorial : ℝ) ≤ (m + 1 : ℝ) ^ n := by
    calc (n.factorial : ℝ) ≤ (n : ℝ) ^ n := by exact_mod_cast Nat.factorial_le_pow n
      _ ≤ _ := pow_le_pow_left₀ (Nat.cast_nonneg _) (by
          have : (n : ℝ) ≤ m := by exact_mod_cast hn
          linarith only [this]) _
  refine hcomp.trans ?_
  calc (n.factorial : ℝ) * (2 * Real.pi) ^ n * (max K 1 * R) ^ n ≤
        (m + 1 : ℝ) ^ n * (2 * Real.pi) ^ n * (max K 1 * R) ^ n := by gcongr
    _ = _ := by rw [one_mul, ← mul_pow, ← mul_pow]

end GeomBoundCalculus

                                                                            
                                                                               
                                                                             
            
                                                                              
                                                                                  
                                
                                                            
                                                                                  

                                                
                                                                             
                                                                          
                                                                          
                                                                          
                                                                             
                                                            
                           
                                                                             
                                                
                                                                
                        
                                                                           
                                                                            
                  
         
         
          
                                                            
      

                                                                              
                                                                           
                                                                       
                                                                
                                                                       
                                                                               
                                                  
                                                              
                                                        
                                                  
                           
                                               
                       
           
                                
                          
              
                                       
                                                     
                             
                                                
                                                                           
                                                                     
           
                                   
                                              
                                                       
                                                
                                         

                                                                 

                                                                                       
                                                                                        
                
                                           

                                                                          
                                                                                      
                                  

                                              
                                                                         
                                                                                  
                                                  
                                           
                                                   
                                               
                                                                   
                                                                      
                                                           

                                                                                  
                                                                                  
                           
                                                      
                                         
                                                             
                                                            
                  
         
                    
     

                                                                                      
                                                      
                                                                                             

                                                                 
                                                           
                      
                       
         
          

                                                  
                                                          
                       
                       
         
          

                                                                                              
                       
                                                                                   
                       
                                       
          

                                                                                       
                                            
                                                                                  
                       
                                                                             
                                                 
                               
                                                                              
                                                   
                                                                      
                                                        
                      
                                                 
                                                        
                                                           
                                                                                               

                                                                          
                                                                          
                                                                  
                                         
                                                                       
                                                                                 
                                                      
                                                                              
                                                              
                                                               
                                                        
                                                  
                           
                                       
                                                                                           
                              
             
                     
              
                        
                                                                     
                 
              
                                        
             
                          
                                                      
                                                                               
                                                  
                                       
                                 
                                                                         
                                             
                                                                  
                                                                 
                                               
            
        
              
                                                               
                 
              
                                        
             
                                                      
                                     
                                        
                                                               
                                                
                                         
                                          
                                                                                              
                           
                                                                                         
                       
                                                        
                        
             

                                                                                 
                                                                  
                                         
                                                                       
                                                          
                                                              
                                                                                       
                                                              
                                                               
                                                            
                                                                             

                                                               
                                                                         
                                                                  
                                         
                                                                       
                                   
                                                                              
                              
          
                                            
                                                                             
                           
                               
                               
                                                              

                                                                          
                                                                         
                                                                  
                                         
                                                                       
                                                                  
                                                                              
                                                                              
                                                              
                                                                                       
                                                                                     
                                                              
                              
                                                          
                                                                       
                                        
                                                                  
                                                                                    
                       

                                                                 
                                                                               
                                                 
                                                                                     
                                                  
                                             
                                                                     
            
              
                                                                             
                                                         
                                                                                
                      

                                                                    
                                                     
                                             
                                                                             
                     
                                                             
                                               
            
                                                                        
                                                                                           
          
                                                    
                   
                                      
                                              
                        
                                                              
                                                                          
                                                                                       
                                                     

theorem GeomBound.add {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {f g : E → F}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g) {x : E} {K₁ K₂ R : ℝ} {m : ℕ}
    (h₁ : GeomBound f x K₁ R m) (h₂ : GeomBound g x K₂ R m) :
    GeomBound (fun y => f y + g y) x (K₁ + K₂) R m := by
  intro i hi
  change ‖iteratedFDeriv ℝ i (f + g) x‖ ≤ _
  rw [iteratedFDeriv_add_apply (hf.of_le (by simp)).contDiffAt (hg.of_le (by simp)).contDiffAt]
  calc _ ≤ ‖iteratedFDeriv ℝ i f x‖ + ‖iteratedFDeriv ℝ i g x‖ := norm_add_le _ _
    _ ≤ K₁ * R ^ i + K₂ * R ^ i := add_le_add (h₁ i hi) (h₂ i hi)
    _ = _ := by ring

                                                     
                                                                                 
                                                                            

                                                           
                                                                                  
                                                                           

                                                                  
                                                               
                
                                                                                     

                                                                    
                                                               
                
                                                                                     

                                                      
                                                                    
                                    
                                            

                                                                                
                                     

                                                                                     
                                                        
                                                                   
                                                        
           
                                          
                                               
                                                                
                                  

                                                                                 
                                                                                    
                                                      

                                                                                      
                                                
                                                              
                                                        

                                               
                                                                                 
                            
                                                                     

                                                                              
                       
                                    
                                                                               
                                                                           
                             
                                       
                                       
      

                                                                           
                                                
                                                                                 
                                                                        
                                                        
                                                             
                                                                   
                                                                             
                                                                             
                                                      
                                              
                                                                      
                                                 
                                                
                                                        
                                                             
                                                                         
         
                                                                             
                                                                       
                                                   
                                             
                                                              
                                                                
                         
           
                            
                                                                                         
                         
                                            
                            
                                                                               
                                                                                       
                                               
                                               
                                               
                                        
                                        
                                                                                
                                
                                                                        
                                
                                                                   
                                          
                                                                                  
                                                                                  
                                                      
                                                 
                                    
                     
                                                     
                                                
                                                                        
                                                                                                    
                                                  
                                                                     
                                                                 
                                                                           
                                                                               
                                                        
                                            
         
                                                                               
                          
                                          
                                                                          
                                                      
                                                                                
         
     

                                                                           
                                                                           
                                          
                                                              
                       
              
                 
                                                                          
             
                                              
                                                                           

                                                                               
                                                                          
                                                                             
                                                           
                                                            
                                             
                                                                     
                                                                   
                                                         
                                                                                     
                                          
                                                                   
                                                                                           
                                                             
                                                     
                                                
                                             
                          
                                            
                                                                                   
                                                                   
                                                                                      
                      
                   
                                                                        
                                    
                                  
                       
                                                                 
              
                                                                             
                              
      
                                              
                 
                                                  
                      
              
                                              
                                                                       
                                               
                                                                        
                                             
                            
                                                                               
                      
                                                  
                                                                        
                         
                            
                                                                                 
                      
                                                  
                                                                         
                         
                                                                        
                           
                                    
                                                               
                                
                                                                                           
                            
                                               
                                                                
                                                                       
                               
                                                     
                                                                       
                                                                             
                                                                       
                                                                                           
                                                   
                        
                                         
                                       
                  
                                                                 
                               
                                                                         
                                                                   
                                                      
                                                                            
                                                                                           
                                                          
                                                                             
                                             
                                           
                                                                  
                                                                                             
                                                                                         
                      
                                    
                                                                                       
                       
                                        
                                                               
                                           
        
                                                                  
                                                 
                                                                          
                                                                    
                                                      
                                                                  
                                                                  
                                                                                     
                                                             
                                                           
                                
                                                                         
                             
                                         
            
                                               
                                                                                     
                                                                   
             
                                                       
                                                                  
                                      
                                                                                             
            
              
                        
                                
           
                             
           
                                                                           
                                                                    
                                                                      
                                                  
                                                                            
                                                                     
                                
                                                                                               
                                     
                                                 
                                               
                                                                                  
                                                                                          
         
                                          
                                               
     

                                                                              
                                                 
                                                                    
                                             
                                                                     
                                                                   
                                                         
                                                                                     
                                          
                                                                   
                                                                                           
                                                             
                                   
                                                
                                             
                          
                                            
                                                                                   
                                                                   
                                                                                       
                                                                                  
                   
                                                                        
                                                                               
                                      
                                 
                                                                                     
                                  
                                                               
                                                                                   
                                                                            
                                                                           
                                                                                       
                                                                                          
                                             
                                                                                      
              
                                                         
                                                         
                    

                                                                           
                                                                                  
                                                           
                                        
                                                               
                                                 
                                                                                    
                                        
                                                                                            

                                                                             
                                                                            
                                                                         
                                                                     
                                                                    
                                             
                                                                     
                                                                   
                                                         
                                                                                     
                                          
                                                                                       
                                                                                           
                                                                          
                                             
                                                                     
                                                     
                                                               
                                                      
                                        
                                                        
                                                                
                                                       
                                                                                     
         
                                                                                    
                            
                                                                            
                                                                                             
                                          
                                                                                 
                                                                                         
                                                
                                                                                              
                     
                                       
                                  
                                                                                                   
                                   
                                          
                                                                                           
               

                                                                                   
                                                                 
                                                                                        
                      
                                                    
                                           
                                                                
                                                                         
                                                                     
                                                
                                                          
                                           
                         
                                                             
                                                               
                          
                       
           
                 
                                                         
             
             
                                              
                                              

                                                                            
                                                                                
                                                                                    
                                                       
                                                                                     
                                                                                    
                                                       
                       
                                                                                  
                           
         
                                                                                
                                               
                               
                                                                    
          
                                               

                                                                        
                                                          
                                                            
                                                                             
                             
           
                                                                                      
                                                                             
                    
                          
                                                                                   
                                 
                      
                        
                
                          
                  
                           
                 
                                                              
                    
          
                        
      

                                                                                 
                                                                         
                                                                                         
                                                                    
                                                          
                                                                      
                                             

                                                                           
                                                                    
                                                                      
                             
                                                                    
                                             
                                                                     
                                                                   
                                                                                        
                                                                                     
                                                  
                                                                  
                                                                 
                                                                       
                                                      
                                                                                 
                                                                            
                           
                                                                                                 
                                                              
                                                  
                                                                          
                                            
                                  
                             
                                  
                                                                                             
                                     
                                                             
                                          
                                                                                             
                                                                                              
                                                                                                 
                                                  
                     
           
                                       
                                                                             
                                                  
                                                   
                                                                              
                                                                                  
                                                 
                                                                                    
                                                              
                                                                                           
                                                                                              
                                                                 
                    
           
                                                                         
                       
               
                                                                              
                                                                                  
                                                                  
                                                 
                                                                          
                                                                                     
                                                                                         
                                 
                                                   
        
                                 
                                                                                   
                           
                                                                  
                                    
                                                                       
                                                                                         
                                                          
                                                                      
                                                                     
                                                                         
                                
                                  
                                                                                                 
                 
                                                                                  
                                                                                      
                                                  
                                                                               
                                                                                     
                                                                            
                                                              
                      
            
                                                
                                   
                                                                           
                                                                                                    
                                                                                                 
                                                                                               
               
              
                              
                                                               
        
                                                                                              
                                        
                                                                                                
                                            
             

                                                

                                                                             
                                                                              
                                       

                       
def PowLe (W : ℝ) (e : ℕ) (x : ℝ) : Prop := 0 ≤ x ∧ x ≤ W ^ e

namespace PowLe
variable {W x y : ℝ} {a b : ℕ}

theorem mono (hW : 1 ≤ W) (h : PowLe W a x) (hab : a ≤ b) : PowLe W b x :=
  ⟨h.1, h.2.trans (pow_le_pow_right₀ hW hab)⟩

theorem of_le (hx : 0 ≤ x) (hxy : x ≤ y) (h : PowLe W a y) : PowLe W a x :=
  ⟨hx, hxy.trans h.2⟩

theorem mul (h₁ : PowLe W a x) (h₂ : PowLe W b y) : PowLe W (a + b) (x * y) :=
  ⟨mul_nonneg h₁.1 h₂.1, by
    rw [pow_add]; exact mul_le_mul h₁.2 h₂.2 h₂.1 (h₁.1.trans h₁.2)⟩

theorem add (hW : 2 ≤ W) (h₁ : PowLe W a x) (h₂ : PowLe W b y) :
    PowLe W (max a b + 1) (x + y) := by
  have hW1 : 1 ≤ W := by linarith only [hW]
  refine ⟨add_nonneg h₁.1 h₂.1, ?_⟩
  have ha := h₁.2.trans (pow_le_pow_right₀ hW1 (le_max_left a b))
  have hb := h₂.2.trans (pow_le_pow_right₀ hW1 (le_max_right a b))
  rw [pow_succ]
  have hp : 0 ≤ W ^ max a b := by positivity
  nlinarith only [hW, ha, hb, hp]

theorem pow (h : PowLe W a x) (n : ℕ) : PowLe W (a * n) (x ^ n) :=
