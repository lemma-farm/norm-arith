theorem localProgressionForm_update_const_smul (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (k : Fin 4) (c : ℂ) (g : ℝ → ℂ) :
    localProgressionForm r w (Function.update f k (c • g)) =
      c * localProgressionForm r w (Function.update f k g) := by
  have h := localProgressionForm_update_smul r w (Function.update f k g) k c
  rwa [Function.update_self, Function.update_idem] at h

                                                                               
                                                                                          
                                                                               
                                
                                                                                  
                                                               
                                                              
                                                                
                                                              
                                                         
                                                            
                                               
                                                                              
                                          
                                                                              
                                          

                                                                     
                                                                                      
                                                                               
                                
                                                                                  
                                                                                       
                                                                       
                                                                                    
                                                                               
           
                                            
            
                                
                                                                           
                                 
           
                       
                                                           
                                                                    
                                                                                                   
                                                                                           
                                    
                                                                                    
                                  
                             
                                                            
                                                                                
                                                                                  
                                                        
                                                           
                                           
                                                                                    
                                                                   

                                                                         
                                                                                           
                                                                               
                                
                                                                                        
                                                                                       
                                                               
                                                              
                                                              
                                                      
                                                       
                                                             
                                                                        
                                           
                                                               
                                                                                               
                               
             
                                                                               
                     
                                                        
                                                                                             
                               
                                                                                                  
                             
                                                                              
                                                               
                                                       
                                                 

                                              
                                                                                              
                                                               
        

theorem memLp_Ico_of_normalized {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤) :
    MemLp g 2 (volume.restrict (Set.Ico a₀ (a₀ + r))) := by
  have h : MemLp g 2 (normalizedIntervalMeasure a₀ r) := hg.lt_top
  refine h.of_measure_le_smul (c := ENNReal.ofReal r) ENNReal.ofReal_ne_top ?_
  rw [normalizedIntervalMeasure, smul_smul, ← ENNReal.ofReal_mul hr.le, mul_inv_cancel₀ hr.ne',
    ENNReal.ofReal_one, one_smul]
  exact Measure.restrict_mono Set.Ico_subset_Icc_self le_rfl

theorem sqrt_normalized_le_of_eLpNorm {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ} {C : ℝ}
    (hC : 0 ≤ C) (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C) :
    Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2) ≤ C := by
  have hm : MemLp g 2 (normalizedIntervalMeasure a₀ r) :=
    lt_of_le_of_lt hg ENNReal.ofReal_lt_top
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)] at hg
  have hX : 0 ≤ ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r :=
    integral_nonneg fun _ => by positivity
  have h := (ENNReal.ofReal_le_ofReal_iff hC).mp hg
  have heq : ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r =
      r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2 := by
    rw [normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul,
      setIntegral_congr_set Ico_ae_eq_Icc.symm]
    congr 2; funext y; simp
  rw [heq] at h hX
  rw [Real.sqrt_eq_rpow]
  simpa using h

                                                                               
                                                                                
                                                                               
                                                      
                                                                                             
                                 
                                                                                
                                                                
                                                   
                                                     
                                  
                                                                                    
                                                                     
                                                
                                           
                                                            
                                              
                                                             
                                                       
                                                       
                                                              
                                                    
                                          
                             
                                       
                                       
              
                                                                     
                                        
                                            
                                         
                                                                    
                                                                                        
              
                                                          
                               
                    

                                                                 
                                                                                          
                                                                 
                                            
                                                                                       
           
                                            
            
                                
                                                  
                
                       
                                    
                                                                                             
                                       
                                                                            
                                                                 

theorem eLpNorm_two_le_of_bound {a₀ r : ℝ} (hr : 0 < r) {g : ℝ → ℂ} (hg : Measurable g)
    {B : ℝ} (hB : ∀ x, ‖g x‖ ≤ B) :
    eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal B := by
  have : IsProbabilityMeasure (normalizedIntervalMeasure a₀ r) :=
    normalizedIntervalMeasure_probability a₀ hr
  refine (eLpNorm_le_of_ae_bound hg.aestronglyMeasurable
    (Filter.Eventually.of_forall hB)).trans ?_
  simp

                                                                               
                                                                          
                                                   
                                                                     

                                                                             
                                                                              
                                                                               
                                                          
                                                             
                                                                               
                                                    
                                                                            
                                                           
                                                                           
                                                                  
                                                   
                                       
                                                                                     
                                 
                                        
                                                                                     
                                                           
                             
                                                                                                 
          
           
                                                 
                                                                              
                                                          
                                                          
                                 
                                      
                                                
                         
                         
                                                
                                 
                                               
                                   
           
                                                                                  
                                                               
               
                                                                        
                                      
                  
                                                                                            
                      
                                                      
                            
                     
                                                               
                                                                              
                                                                                            
           
                       
                                 
                              
                                                                 
                            
                                                                                          
                                        
                                         
                                           
                            
                                     
                                                   
                            
          
                                                   
                                                                                          
                          
                                                                                  
                                                                                  
                                                            
                                                            
                                                                         
                                                                         
                                                             
                                                                                            
                                                        
                                                               
                                                
                                     
            
                                                                
                               
                                   
                                                  
                                                                                      
                     
                                                                                    
                                                                          
                                                                                           
                                                                                                 
                             
                                              
           
                                                                              
                                                                                             
                                                        
                                                                                             
                                                                                             
                                   
                                                                                    
                                                    
                                                    
                                                    
                                                                     
                                                                                    
                          
                                                                                           
                                                                      
                                                                      
                                                                         
                                                          
                                                                                   
                                
                       
                                               
                                                                                     
                                               
                                                                                     
                                                                          
                                                                     
                        
                                                    
                                                                              
                                                       
                                                                                              
                                                     
                                                                 
                                                                     
                       
                                              
                                                                     
                                                                        
                                                        
                                               
                                                                      
                                                                      
                                  
                     
          
                                                
                                                               
                                                                    
                                                                                             
                                          
                                                             
                                       
                                                     
                                                                  
                                                        
                                    
                                      
                                      
                                 
                                                          
                               
                                                                 
                                                                      
                                                                               
                                 
                                                   
                                       
                                                                       
                                                                         
                                                               
                                                                               
                                           
                                    
                                                                                    
                                                                         
                                            
                              
            
                                        
                                    
                                     
                
                  
                                                                                
                            
              
                                                                                      
            
                                                        
                                      
                                                                                        
                         
                                                    
                                             
                                                                                     
                                                                          
                                      
                                                                                         
                                       
          

                                                                               
def QPLe (Y : ℝ) (K : ℕ) (a : ℝ) : Prop := a ≤ Real.exp (K * Y ^ K)

namespace QPLe
variable {Y a b : ℝ} {K L : ℕ}

theorem mono (hY : 1 ≤ Y) (hKL : K ≤ L) (h : QPLe Y K a) : QPLe Y L a :=
  h.trans (exp_poly_le hY hKL (by exact_mod_cast hKL))

theorem of_le (hab : a ≤ b) (h : QPLe Y K b) : QPLe Y K a := hab.trans h

                                              
                                                    

theorem mul (hY : 1 ≤ Y) (hb0 : 0 ≤ b) (ha : QPLe Y K a) (hb : QPLe Y L b) :
    QPLe Y (K + L) (a * b) := by
  unfold QPLe at *
  refine (mul_le_mul ha hb hb0 (Real.exp_pos _).le).trans ?_
  rw [← Real.exp_add]
  apply Real.exp_le_exp.mpr
  have h1 : Y ^ K ≤ Y ^ (K + L) := pow_le_pow_right₀ hY (by omega)
  have h2 : Y ^ L ≤ Y ^ (K + L) := pow_le_pow_right₀ hY (by omega)
  push_cast
  nlinarith [Nat.cast_nonneg (α := ℝ) K, Nat.cast_nonneg (α := ℝ) L]

theorem pow (hY : 1 ≤ Y) (ha0 : 0 ≤ a) (ha : QPLe Y K a) (n : ℕ) :
    QPLe Y (n * K + K) (a ^ n) := by
  unfold QPLe at *
  refine (pow_le_pow_left₀ ha0 ha n).trans ?_
  rw [← Real.exp_nat_mul]
  apply Real.exp_le_exp.mpr
  have h1 : Y ^ K ≤ Y ^ (n * K + K) := pow_le_pow_right₀ hY (by omega)
  have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg K
  have hY0 : 0 ≤ Y ^ K := by positivity
  have hnK : (0 : ℝ) ≤ n * K := by positivity
  have hE0 : 0 ≤ Y ^ (n * K + K) := by positivity
  push_cast
  nlinarith [mul_nonneg hnK (sub_nonneg.mpr h1), mul_nonneg hK0 hE0]

                                                        
             
                                     
                                                                                      
                    
                                                                           

                                                                            
                  
                                                   

                                                              
                                                                      
                                                                                
                                    
                                                  
                                        
                                                             
                                                                               
             
                                                          
           
                                         
          

end QPLe

                                                          
                                                   
                                                                 
                                                      

                                                            
                                                            
                                                                                              
                                                                     
                                                                         
                                                          
                                                 
                                                 
                                                                                   
                                                                             
                                                                           
                                                                                     
                                         
                            
                                                                     
                                                                             
                
                                                                                     
                    
                                                                                 
                 
                                               
                                                                             
                                 
                                                                           
                                                                         
                                
                                         
                            
                                                       
                                                               
                                                                  
                         
                                                                                         
                    
                                                               
                   
                                        
                                                                                 
                                                         
                                                     
                                                             
                                                                            
                                                 
                         
                                                      
                                                       
                                        
                                                                        
                                                 
                         
                                                         
                                                 
                                     

                                                                                                 
                                                                                         
                                                                               
                                                  
                                                                                       
                                                                                   
                                                                        
                            
                                                                         
                                                   
                                                          
                                                           
                                                           
                                                                
                                                                             
                      
                                                                       
                                      
                                                                                
                                     
                                               
                                                         
                                                                   
                               
           
                                                                              
                        
                        
                        
                        
                                         
                                                                            
                                              
                                                                                   
                                                             
                                                                                        
                                                     
                                                                      
                                                       
                                                                   
            
                
                                                                           
                                                                
                                                  
                                         
                                                               
              
         

                                                                        
noncomputable def separatedLocalForm (r : ℝ) (w : ℝ × ℝ → ℂ) (Q : ℝ → ℂ) (a b : Fin 4)
