"name" = "trilinearht"
"version" = "0.1.0"
"defaultTargets" = ["TrilinearHT", "Challenge", "Solution"]
"leanOptions" = {"weak" = {"linter" = {"mathlibStandardSet" = true}}}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "TrilinearHT"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"srcDir" = "."
