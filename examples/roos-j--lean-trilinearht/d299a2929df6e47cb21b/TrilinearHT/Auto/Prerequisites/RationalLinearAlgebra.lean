theorem euclidean_norm_le_sum_coordinates {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) :
    ‖x‖ ≤ ∑ i, ‖x i‖ := by
  apply (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg (fun _ _ => norm_nonneg _))).mp
  rw [EuclideanSpace.norm_sq_eq]
  exact Finset.sum_sq_le_sq_sum_of_nonneg (fun _ _ => norm_nonneg _)

                                                                         
                                                                          
                                                                         
                                                    
                                                              
                                                             
         
      
                                                                                            
                                      
                                                                                 
                                                 
                             
               
                             
               
                                     
                                                                           
                                                                                
                         

                                                        
                                                                 
                                       
                                           
        
                                         
                                                                     
                                         
                                                 
        
                                                                           
                                              
                                  
                                 
      
                                 
                                                                    
                                                           
                                                                                          
                                                                           
                         
                                                                                      

                                                                        
                                                               
                                                                    
                                                             
                                                       
                                                                       
                                            
                                                          
                                                                   
                                                             
               
                                                      
                                                         
                                                      
                                                                                      
                                             
                                                             
        
                                                 
                                                     
                                           
                                              
                                                     
                 
                
                                        
                                       
                                                                                      
                 
                                                                                        
                                                                         
             
             
                           
                                      
                                                                  
                                                                     
                                                             
                 
                                        
                                                                                        
             
                                    
                                    
                                                                      
                     

                                                                            
                                                                     
                                                                       
                                                
                                              
                                                                                            
           
                                                                 
                                            
                                       
                                         
                                                                                
                                        
                                            
                                                                                 
                                                                        
                                                                
                                                                                     
                       
               
               

                                                                          
                                                                     
                                                                       
                                           
                                                    
                                       
                                                              
                                                
                                                                       
                                                                                     
                                                         
                                                                             
                               
                                                       
                                                                             
                       
                                                      
                                         
                                                                                   
                                                          
                                                                           
                                                                                     
         
         
                                             
                                                                 
                                                                         

                                                                         
                                                                            
                                                        
                                                 
                                                                
                                                                

                                                    
                                                 
                                          
                                                                        
                                                                                                

                                                    
                                                 
                                          
                                                  
                                                                   
           
                                  
                         
                                    
                           
                                                                         
          
                                                                       
                                           
        
                                                                                        

                                                                 
                                                    
                                                                              
           
       
                                                                            
      
                                                    
              
                                        
                    
           
                                    

                                                     
                                                 
                                                    
                                                     
                                                        
           
       
                                  
                         
                                                                   
                                                       
        
                                                      
                
                                          
                      
             
                                      
                                                                   
                                                                                      

                                                                        
                                                                        
                                               
                                                                                
                                            
                                                                     
                                           
                                      
                                                                                                  
            
                                                         
                                                  
                                       
                         
                        
                                                              
                                                                            
                                                                                   
                                                                              
     

                                                                             
noncomputable def realMatrixOperator {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) :
    EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m) :=
  LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (𝕜 := ℝ) A)

theorem realMatrixOperator_norm_le {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    {K : ℝ} (hK : 0 ≤ K) (hA : ∀ i j, |A i j| ≤ K) :
    ‖realMatrixOperator A‖ ≤ (m : ℝ) * n * K := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro x
  calc
    _ ≤ ∑ i, ‖(realMatrixOperator A x) i‖ := euclidean_norm_le_sum_coordinates _
    _ = ∑ i, ‖∑ j, A i j * x j‖ := rfl
    _ ≤ ∑ i, ∑ j, ‖A i j * x j‖ := Finset.sum_le_sum (fun _ _ => norm_sum_le _ _)
    _ ≤ ∑ _i : Fin m, ∑ _j : Fin n, K * ‖x‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply Finset.sum_le_sum
      intro j _
      rw [norm_mul, Real.norm_eq_abs]
      exact mul_le_mul (hA i j) (PiLp.norm_apply_le x j) (norm_nonneg _) hK
    _ = _ := by simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
