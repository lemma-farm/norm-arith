structure CellRowFamily (G : RealDyadicGrid) (ι : Type) where
  index : Finset ι
  cell : ι → ℤ × ℤ
  test : ι → ℝ → ℂ
  measurable : ∀ i, Measurable (test i)
  bounded : ∀ i, ∃ C, ∀ y, ‖test i y‖ ≤ C
  local_support : ∀ i y, y ∉ dyadicGridCell G (cell i).1 (cell i).2 → test i y = 0
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  bessel : ∀ g : Lp ℂ 2 (volume : Measure ℝ),
    ∑ i ∈ index, ‖∫ y, conj (test i y) * g y‖ ^ 2 ≤ bound ^ 2 * ‖g‖ ^ 2

/-- Blueprint sec:base, lines 1482–1485: a cell-dependent opponent `z_I` for the input `F`
on the subtree rooted at `J` is admissible with transfer constant `K` if every local Bessel
row family over cells of `J` applied to the inputs `z_I` is controlled by `K` times its
bound times `‖1_J F‖₂`. -/
def IsAdmissibleOpponent (G : RealDyadicGrid) (J : ℤ × ℤ) (F : ℝ → ℂ)
    (z : ℤ × ℤ → ℝ → ℂ) (K : ℝ) : Prop :=
  ∀ (ι : Type) (R : CellRowFamily G ι),
