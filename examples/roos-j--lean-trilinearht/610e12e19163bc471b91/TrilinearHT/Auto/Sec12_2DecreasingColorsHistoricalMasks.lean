omit [DecidableEq V] in
/-- Rival terms at a successful center are at most `(g - 5) b₁` at all earlier depths. -/
theorem rival_term_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {w : V} (hw : w ∈ A.X) (hwz : w ≠ z) {s' : ℤ}
    (hs : s' ≤ A.s) : K.profTerm ρ s' w v ≤ (((g - 5) * K.b1 : ℤ) : WithBot ℤ) := by
  obtain ⟨⟨hz, hzg, hgap⟩, hg, -⟩ := sigData_spec hc
  have hr := hgap w hw hwz
  have hg0 := (K.roundTop_psc_mem hv ρ).1
  rw [← hg] at hr hg0
  refine (K.profTerm_mono ρ hs w v).trans ?_
  unfold profTerm
  split_ifs with htop
  · exact bot_le
  · unfold psc at hr
    have hw0 := K.Dp_le ρ w
    have hq : (K.Dp ρ w : ℤ) - g + 5 ≤ ((K.dist.d A.s w v).toNat / K.b1 : ℕ) := by
      unfold capDiv at hr
      simp only [htop, ite_false] at hr
      have := min_le_left ((K.dist.d A.s w v).toNat / K.b1) (K.d0 + 6)
      omega
    have h1 := Nat.div_mul_le_self (K.dist.d A.s w v).toNat K.b1
    apply WithBot.coe_le_coe.mpr
    have : (((K.dist.d A.s w v).toNat / K.b1 : ℕ) : ℤ) * K.b1 ≤ (K.dist.d A.s w v).toNat := by
      exact_mod_cast h1
    push_cast
    nlinarith only [(Nat.cast_nonneg K.b1 : (0 : ℤ) ≤ K.b1), hq, this]

theorem prof_center_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {W : Finset V} (hW : W ⊆ A.X) {s' : ℤ} (hs : s' ≤ A.s) :
    K.prof ρ z W v s' ≤ (((g - 5) * K.b1 : ℤ) : WithBot ℤ) := by
  rw [prof_eq]
  apply Finset.sup_le
  intro w hw
  obtain ⟨hwz, hwW⟩ := Finset.mem_erase.mp hw
  exact K.rival_term_le hv hc (hW hwW) hwz hs

theorem clipW_eq_low {T U : ℝ} (hTU : T ≤ U) {x : WithBot ℤ} {c : ℤ} (hx : x ≤ (c : WithBot ℤ))
    (hc : (c : ℝ) ≤ T) : clipW T U x = T := by
  cases x with
  | bot => rfl
  | coe n =>
    have : (n : ℝ) ≤ c := by exact_mod_cast WithBot.coe_le_coe.mp hx
    simp only [clipW_coe]
    rw [max_eq_left (by linarith), min_eq_right hTU]

omit [DecidableEq V] in
theorem Tl_ge (g : ℤ) (l : ℕ) : ((g - 3) * K.b1 : ℝ) ≤ K.Tl g l := by
  unfold Tl
  have : (0 : ℝ) ≤ l * K.b1 / (2 * K.d0) := by positivity
  linarith

/-- Blueprint lem:masks, first assertion (pseudometric part): at a successful center, every
present vertex within graph distance `h ≤ 2 b₁` has context distance at most `h` for every
`l ≤ 2 d₀`. -/
theorem lowMet_center_le {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hc : K.prim A v = some (ρ, z, g)) {W : Finset V} (hW : W ⊆ A.X) {l : ℕ} (hl : l ≤ 2 * K.d0)
    {b : V} {δ : ℕ} (hbv : K.dist.d A.s b v = δ) (hδ : δ ≤ 2 * K.b1) :
    K.lowMet ρ g z W l b v ≤ δ := by
  have hTU := K.Tl_le_Ul g hl
  apply K.lowMet_le_of
  intro s'
  unfold clipDiff
  rcases le_total s' A.s with hs | hs
  · -- both profiles are below `T_l`
    have hv' := K.prof_center_le hv hc hW hs
    have hb' : K.prof ρ z W b s' ≤ (((g - 5) * K.b1 + δ : ℤ) : WithBot ℤ) := by
      refine (K.prof_mono ρ z W b hs).trans ((K.prof_le_add ρ z W A.s hbv).trans ?_)
      have := K.prof_center_le hv hc hW (le_refl A.s)
      rw [WithBot.coe_add]
      exact add_le_add this le_rfl
    have hT := K.Tl_ge g l
    have e1 := clipW_eq_low hTU hv' (by push_cast; nlinarith [(Nat.cast_nonneg K.b1 : (0:ℝ) ≤
        K.b1)])
    have e2 := clipW_eq_low hTU hb' (by
      push_cast
      have : (δ : ℝ) ≤ 2 * K.b1 := by exact_mod_cast hδ
      linarith)
    rw [e1, e2]; simp
  · -- persistence of the graph distance
    have hle := K.dist.anti hs b v
    rw [hbv] at hle
    obtain ⟨δ', hδ'⟩ : ∃ δ' : ℕ, K.dist.d s' b v = δ' :=
      ⟨(K.dist.d s' b v).toNat,
        (ENat.natCast_toNat (ne_top_of_le_ne_top (ENat.natCast_ne_top δ) hle)).symm⟩
    have hδδ : δ' ≤ δ := by rw [hδ'] at hle; exact_mod_cast hle
    have hvb : K.dist.d s' v b = δ' := by rw [K.dist.symm]; exact hδ'
    have := abs_clipW_sub_le_of hTU (K.prof_le_add ρ z W s' hδ') (K.prof_le_add ρ z W s' hvb)
    exact this.trans (by exact_mod_cast hδδ)

                                                              
                                                                                         
                                                 
                                                         
                                                    
                                                            
                                                                                       
                       
                            
                                   
             
                            
                
                                                     
                                                
                              

                       
                                                                                        
                                                
           
                     
                         
                                  
                          
                                                                      
                                         

                                                                                      
                                                                                               
                                                                                  

                                                                                               
                                                                                                  
                                                                                      
                                                             
                                                                                    
                                                                              
                                                                                 

                        

                                                                                         
                                                                                    
                                                     
                                                                                
                                            

                                                                                               
                                                                                  
                                                                                                 
                                   
                                                                           
                                                                           
                                                                            

                       
                                                                                              
           
                                               
                                                                  
                                                                                         
                                                 
           

                       
                                                                    
                                                 

                                                                                                
                                                   
                                                                                           
                                                                                       
                                                                                     
                                              
                                                    
                                                  
                                            
                                              
         
                         
                                                           
                                                                               
                                                  
                                                                             
                                             
                        
                                                                 
                                                                         
                    
                                               
                        
                                  
                                                                           
                                                                                     
                            
                                                                           
                                                                                           
                                
                                                 
                                              
             

