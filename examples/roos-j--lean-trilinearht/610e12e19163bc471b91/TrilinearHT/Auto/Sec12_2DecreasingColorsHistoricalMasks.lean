/-! ### Profiles and the context pseudometrics -/

/-- Clipping with a shift: `x ≤ y + δ` gives `C(x) ≤ C(y) + δ`. -/
theorem clipW_le_add {T U : ℝ} (hTU : T ≤ U) {x y : WithBot ℤ} {δ : ℕ}
    (h : x ≤ y + (δ : ℤ)) : clipW T U x ≤ clipW T U y + δ := by
  cases x with
  | bot => exact (clipW_mem hTU y).1.trans (le_add_of_nonneg_right (Nat.cast_nonneg _))
  | coe n =>
    cases y with
    | bot => exact absurd h (by simp)
    | coe m =>
      have hnm : n ≤ m + δ := by exact_mod_cast h
      simp only [clipW_coe]
      have : (n : ℝ) ≤ m + δ := by exact_mod_cast hnm
      rcases le_total (m : ℝ) T with h1 | h1 <;> rcases le_total (m : ℝ) U with h2 | h2 <;>
        simp only [max_def, min_def] <;> split_ifs <;> linarith

theorem abs_clipW_sub_le_of {T U : ℝ} (hTU : T ≤ U) {x y : WithBot ℤ} {δ : ℕ}
    (h1 : x ≤ y + (δ : ℤ)) (h2 : y ≤ x + (δ : ℤ)) : |clipW T U x - clipW T U y| ≤ δ := by
  rw [abs_le]
  constructor
  · linarith [clipW_le_add hTU h2]
  · linarith [clipW_le_add hTU h1]

                                                         
                                                                              
                                                     
              
                                                                       
            
                         
                                                                                          
                                                                                               
              

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

/-- One term of a profile. -/
noncomputable def profTerm (ρ : Fin K.d0) (s' : ℤ) (w a : V) : WithBot ℤ :=
  if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ)

theorem prof_eq (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) :
    K.prof ρ z W a s' = (W.erase z).sup (fun w => K.profTerm ρ s' w a) := rfl

omit [DecidableEq V] in
theorem profTerm_mono (ρ : Fin K.d0) {s s' : ℤ} (h : s ≤ s') (w a : V) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s' w a := by
  have hd := K.dist.anti h w a
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have h2 : K.dist.d s' w a ≠ ⊤ := ne_top_of_le_ne_top h1 hd
    simp only [h1, h2, ite_false]
    have : (K.dist.d s' w a).toNat ≤ (K.dist.d s w a).toNat := ENat.toNat_le_toNat hd h1
    exact_mod_cast (by omega : ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s w a).toNat : ℤ) ≤
      ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ))

/-- Profiles increase with depth. -/
theorem prof_mono (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) {s s' : ℤ} (h : s ≤ s') :
    K.prof ρ z W a s ≤ K.prof ρ z W a s' :=
  Finset.sup_mono_fun fun w _ => K.profTerm_mono ρ h w a

omit [DecidableEq V] in
theorem profTerm_le_add (ρ : Fin K.d0) (s : ℤ) (w a b : V) {δ : ℕ} (hab : K.dist.d s a b = δ) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s w b + (δ : ℤ) := by
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have htri := K.dist.triangle s w a b
    have h2 : K.dist.d s w b ≠ ⊤ := by
      intro h; rw [h, hab] at htri
      exact h1 (by simpa using htri)
    simp only [h1, h2, ite_false]
    rw [hab] at htri
    have : (K.dist.d s w b).toNat ≤ (K.dist.d s w a).toNat + δ := by
      have := ENat.toNat_le_toNat htri (by simp [h1])
      simpa [ENat.toNat_add h1 (ENat.natCast_ne_top δ)] using this
    rw [← WithBot.coe_add]
    exact WithBot.coe_le_coe.mpr (by omega)

/-- Profiles are `1`-Lipschitz in the vertex for the graph distance at the same depth. -/
theorem prof_le_add (ρ : Fin K.d0) (z : V) (W : Finset V) (s : ℤ) {a b : V} {δ : ℕ}
    (hab : K.dist.d s a b = δ) : K.prof ρ z W a s ≤ K.prof ρ z W b s + (δ : ℤ) := by
  rw [prof_eq, prof_eq]
  apply Finset.sup_le
  intro w hw
  exact (K.profTerm_le_add ρ s w a b hab).trans
    (add_le_add (Finset.le_sup (f := fun w => K.profTerm ρ s w b) hw) le_rfl)

                                                                                                 
                                                              
                                                                                   

                                                                                      
noncomputable def clipDiff (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V)
    (s' : ℤ) : ℝ :=
  |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') - clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|

omit [DecidableEq V] in
theorem Tl_le_Ul (g : ℤ) {l : ℕ} (hl : l ≤ 2 * K.d0) : K.Tl g l ≤ K.Ul g := by
  unfold Tl Ul
  rcases Nat.eq_zero_or_pos K.d0 with h0 | h0
  · simp [h0]; nlinarith [(Nat.cast_nonneg K.b1 : (0 : ℝ) ≤ K.b1)]
  · have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
    have hd : (0 : ℝ) < 2 * K.d0 := by positivity
    have : (l : ℝ) * K.b1 / (2 * K.d0) ≤ K.b1 := by
      rw [div_le_iff₀ hd]
      have : (l : ℝ) ≤ 2 * K.d0 := by exact_mod_cast hl
      nlinarith
    linarith

                                                                                             
                                                                              
                             
                                              
                                              
                 
                                       

                                                                                   
                                                                     

                                                                                
                                            
                                                           
                                                                 
                                                               

theorem lowMet_le_of (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) {c : ℝ}
    (h : ∀ s', K.clipDiff ρ g z W l a b s' ≤ c) : K.lowMet ρ g z W l a b ≤ c :=
  ciSup_le h

                                                                                               
                                             
                                                              

                                                                                     
                                                         
                                               

                                                                             
                                     
                                                                                  
                      
          
                                                   
                                                   
                            
                                                   

                                                               
                                                                            
                                       
                                                               
                                           
             
                                                 
                                                                                    
                                                        
                          
            
                             
                      
          
                                                                     
                 
                                                               
                                                                     
                                                                                     

