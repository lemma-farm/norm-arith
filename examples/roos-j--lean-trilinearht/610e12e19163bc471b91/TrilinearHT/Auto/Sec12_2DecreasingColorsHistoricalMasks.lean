/-- The data of the coloring (blueprint lines 1714-1728): graph distances, the parameters
`d₀, b₁, b₂` and the primary and high delay arrays (one per round), with values in `[0, d₀]`. -/
structure ColorSetup (V : Type*) where
  dist : DepthDistance V
  d0 : ℕ
  b1 : ℕ
  b2 : ℕ
  Dp : Fin d0 → V → ℕ
  Dh : Fin d0 → V → ℕ
  Dp_le : ∀ ρ v, Dp ρ v ≤ d0
  Dh_le : ∀ ρ v, Dh ρ v ≤ d0

namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)

/-- The primary score `D_z - ⌊d_s(z,v)/b₁⌋` of `z` at the center `v` (distance quotients capped
at `d₀ + 6`, which does not affect top scores or gaps). -/
noncomputable def psc (s : ℤ) (ρ : Fin K.d0) (v z : V) : ℤ :=
  (K.Dp ρ z : ℤ) - capDiv (K.dist.d s z v) K.b1 (K.d0 + 6)

/-- The signature of a family of rounds: the winner predicates and the top scores. -/
noncomputable def roundSig {n : ℕ} (X : Finset V) (sc : Fin n → V → ℤ) : Fin n → (V → Prop) × ℤ :=
  fun ρ => (RoundWinner X (sc ρ), roundTop X (sc ρ))

open Classical in
/-- The first marked round, its winner and its top score. -/
noncomputable def sigData {n : ℕ} (σ : Fin n → (V → Prop) × ℤ) : Option (Fin n × V × ℤ) :=
  if h : ∃ ρ, ∃ z, (σ ρ).1 z then
    some (Fin.find (fun ρ => ∃ z, (σ ρ).1 z) h,
      Classical.choose (Fin.find_spec (p := fun ρ => ∃ z, (σ ρ).1 z) h),
      (σ (Fin.find (fun ρ => ∃ z, (σ ρ).1 z) h)).2)
  else none

omit [DecidableEq V] in
theorem sigData_spec {n : ℕ} {X : Finset V} {sc : Fin n → V → ℤ} {ρ : Fin n} {z : V} {g : ℤ}
    (h : sigData (roundSig X sc) = some (ρ, z, g)) :
    RoundWinner X (sc ρ) z ∧ g = roundTop X (sc ρ) ∧ ∀ ρ' < ρ, ¬ RoundMarked X (sc ρ') := by
  classical
  unfold sigData at h
  split_ifs at h with hex
  simp only [Option.some.injEq, Prod.mk.injEq] at h
  obtain ⟨h1, h2, h3⟩ := h
  subst h1 h2 h3
  refine ⟨Classical.choose_spec (Fin.find_spec (p := fun ρ => ∃ z, (roundSig X sc ρ).1 z) hex),
    rfl,
    fun ρ' hρ' => ?_⟩
  exact Fin.find_min (p := fun ρ => ∃ z, (roundSig X sc ρ).1 z) hex hρ'

                       
                                                                
                                                                            
           
                     
                         
            
                   

                                                                                      
noncomputable def prim (A : AdmState V) (v : V) : Option (Fin K.d0 × V × ℤ) :=
  sigData (roundSig A.X (fun ρ => K.psc A.s ρ v))

/-- The rival profile `f_a(s') = max_{w ∈ W∖{z}} (b₁ D_w - d_{s'}(w,a))` (`-∞` when empty or at
infinite distance). -/
noncomputable def prof (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) : WithBot ℤ :=
  (W.erase z).sup (fun w => if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ))

/-- The lower clipping level `T_l = (g - 3) b₁ + l b₁/(2 d₀)`. -/
noncomputable def Tl (g : ℤ) (l : ℕ) : ℝ := (g - 3) * K.b1 + l * K.b1 / (2 * K.d0)

/-- The upper clipping level `U = (g - 2) b₁`. -/
noncomputable def Ul (g : ℤ) : ℝ := (g - 2) * K.b1

                                                
                                                              

                                                                                                   
noncomputable def lowMet (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) : ℝ :=
  ⨆ s' : ℤ, |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') -
    clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|

                                                                                                
                                                                                              
                  
                                                                   

                 
                                                                                              
                                                     
                                                  
                                                         
                                  
             

                                                                       
                                                                                   
                                  
                                                                         

                                                                                                
                      
                                                      
                                                                          
                       
                                   
                     
                          
                                                 
                                      
                                                                 

