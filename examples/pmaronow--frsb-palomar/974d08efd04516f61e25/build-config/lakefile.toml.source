"name" = "paperFormalization"
"version" = "1.0.0"
"defaultTargets" = ["FRSB", "Challenge", "Solution"]
"leanOptions" = {"autoImplicit" = false}
"buildDir" = ".lake/build"
"srcDir" = "."

[["require"]]
"name" = "mathlib"
"path" = "/project/repo/norm-arith/.lake/packages/mathlib"

[["lean_lib"]]
"name" = "Paper"
"srcDir" = "."

[["lean_lib"]]
"name" = "StochasticCalculus"
"srcDir" = "vendor/lean-stochastic-calculus"

[["lean_lib"]]
"name" = "BrownianMotion"
"srcDir" = "vendor/brownian-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "Common"
"srcDir" = "vendor/cole-hopf-foundations"
"leanOptions" = {"autoImplicit" = false}

[["lean_lib"]]
"name" = "KolmogorovExtension4"
"srcDir" = "vendor/brownian-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "Lemmas"
"srcDir" = "vendor/spin-glass-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "ParisiFormula"
"srcDir" = "vendor/spin-glass-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "Targets"
"srcDir" = "vendor/spin-glass-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "SpinGlassFoundations"
"srcDir" = "vendor/spin-glass-foundations"
"leanOptions" = {"autoImplicit" = true}

[["lean_lib"]]
"name" = "FRSB"
"srcDir" = "."

[["lean_lib"]]
"name" = "Challenge"
"roots" = ["Challenge"]
"srcDir" = "."

[["lean_lib"]]
"name" = "Solution"
"roots" = ["Solution"]
"srcDir" = "."
