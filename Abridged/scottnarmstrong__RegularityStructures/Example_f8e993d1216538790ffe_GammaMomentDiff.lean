                          0 < RegularityStructures.torusParabolicSize (v - u) →
                            |R (u - v)| ≤ A * RegularityStructures.torusParabolicSize (v - u) ^ (-p)) →
                        ∀ {f : RegularityStructures.SpaceTime → ℝ},
