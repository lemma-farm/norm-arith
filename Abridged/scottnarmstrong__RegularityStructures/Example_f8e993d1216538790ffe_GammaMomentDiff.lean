    (h_RegularityStructures_Phi43_hairerPsiWickSquare_sub_integral_mulTwo : ∀ {Ω : Type u} [inst : MeasurableSpace Ω] {P : MeasureTheory.Measure Ω}
      {W : (RegularityStructures.SpaceTime → ℝ) → Ω → ℝ} (N : ℕ) {ρ ρ' : ℝ × (Fin 3 → ℝ) → ℝ},
      RegularityStructures.Phi43.IsMollifier ρ →
        RegularityStructures.Phi43.IsMollifier ρ' →
