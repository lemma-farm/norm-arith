    (h_RegularityStructures_Phi43_abs_flip_le : ∀ {Rr : RegularityStructures.SpaceTime → ℝ} {C e : ℝ},
      0 ≤ e →
        0 ≤ C →
          (∀ (x : RegularityStructures.SpaceTime),
              0 < RegularityStructures.torusParabolicSize x →
                |Rr x| ≤ C * RegularityStructures.torusParabolicSize x ^ (-e)) →
            ∀ {u v : RegularityStructures.SpaceTime},
              0 < RegularityStructures.torusParabolicSize (v - u) →
                |Rr (u - v)| ≤ C * 2 ^ e * RegularityStructures.torusParabolicSize (v - u) ^ (-e))
    (h_RegularityStructures_Phi43_measurable_hairerPsiWickSquare_uncurry : ∀ {ρ : ℝ × (Fin 3 → ℝ) → ℝ} {ε : ℝ} {Ω : Type u} [inst : MeasurableSpace Ω]
      {P : MeasureTheory.Measure Ω} {W : (RegularityStructures.SpaceTime → ℝ) → Ω → ℝ}
      {ξ : Ω → RegularityStructures.SpaceTime → ℝ} (N : ℕ),
      RegularityStructures.Phi43.IsRegularisedNoise P W ρ ε ξ →
