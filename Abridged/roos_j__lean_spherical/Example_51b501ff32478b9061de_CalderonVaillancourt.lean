/-- The combined decay estimate in the form used below. -/
theorem one_add_pow_mul_norm_fourier_le {Ψ : V → ℂ} {M : ℝ} {N : ℕ}
    (hsm : ContDiff ℝ (↑(⊤ : ℕ∞)) Ψ) (hcs : HasCompactSupport Ψ)
    (hint : ∀ n ≤ N, (∫ v, ‖iteratedFDeriv ℝ n Ψ v‖) ≤ M) (w : V) :
    (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 4 ^ N * ((N : ℝ) + 1) * M := by
  have hMnn : 0 ≤ M := by
    refine le_trans ?_ (hint 0 (Nat.zero_le N))
    exact integral_nonneg (fun v => norm_nonneg _)
  have hzero : ‖𝓕 Ψ w‖ ≤ M := by
    have h := pow_mul_norm_fourier_le (N := 0) hsm hcs (fun n hn => hint n (by omega)) w
    simpa using h
  have hbig := pow_mul_norm_fourier_le (N := N) hsm hcs hint w
  have hkey : (max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 2 ^ N * ((N : ℝ) + 1) * M := by
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw, one_pow, one_mul]
      have h2 : (1 : ℝ) ≤ 2 ^ N * ((N : ℝ) + 1) := by
        have : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
        nlinarith [Nat.cast_nonneg (α := ℝ) N]
      nlinarith
    · rw [max_eq_right hw]
      exact hbig
  have hone : (1 + ‖w‖) ^ N ≤ 2 ^ N * (max 1 ‖w‖) ^ N := by
    rw [← mul_pow]
    refine pow_le_pow_left₀ (by positivity) ?_ N
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw]; linarith
    · rw [max_eq_right hw]; linarith [norm_nonneg w]
  calc (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖
      ≤ (2 ^ N * (max 1 ‖w‖) ^ N) * ‖𝓕 Ψ w‖ :=
        mul_le_mul_of_nonneg_right hone (norm_nonneg _)
    _ = 2 ^ N * ((max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖) := by ring
    _ ≤ 2 ^ N * (2 ^ N * ((N : ℝ) + 1) * M) := by
        refine mul_le_mul_of_nonneg_left hkey (by positivity)
    _ = 4 ^ N * ((N : ℝ) + 1) * M := by
        rw [show (4 : ℝ) = 2 * 2 from by norm_num, mul_pow]
