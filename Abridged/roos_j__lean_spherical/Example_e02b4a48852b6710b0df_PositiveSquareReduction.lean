/-- Pointwise complex norm square, retained as a complex-valued function so
it matches the signed tube input convention. -/
def pointwiseNormSquare
    {X : Type*} (f : X -> Complex) : X -> Complex :=
  f * star f


set_option linter.unusedVariables false in
/-- The square map is locally Lipschitz from `L⁴` to `L²`, in the form
needed to turn an `L⁴` approximation of a square root into an `L²`
approximation by a nonnegative square core. -/
theorem eLpNorm_pointwiseNormSquare_sub_le
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (u v : X -> Complex) (hu : MemLp u 4 μ) (hv : MemLp v 4 μ) 
    (h_Auto_Spherical_MSS_eLpNorm_mul_le_four_four_two : ∀ {X : Type u_1} [inst : MeasurableSpace X] {μ : MeasureTheory.Measure X} (f g : X → ℂ),
      MeasureTheory.AEStronglyMeasurable f μ →
        MeasureTheory.AEStronglyMeasurable g μ →
          MeasureTheory.eLpNorm (f * g) 2 μ ≤ MeasureTheory.eLpNorm f 4 μ * MeasureTheory.eLpNorm g 4 μ)
    (h_Auto_Spherical_MSS_pointwiseNormSquare_sub_eq : ∀ {X : Type u_1} (u v : X → ℂ),
      Auto.Spherical.MSS.pointwiseNormSquare u - Auto.Spherical.MSS.pointwiseNormSquare v =
        (u - v) * Star.star u + v * Star.star (u - v))
    :
    eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 μ ≤
      eLpNorm (u - v) 4 μ * eLpNorm u 4 μ +
        eLpNorm v 4 μ * eLpNorm (u - v) 4 μ := by
  have huv : MemLp (u - v) 4 μ := hu.sub hv
  have hstaru : MemLp (star u) 4 μ := hu.star
  have hstaruv : MemLp (star (u - v)) 4 μ := huv.star
  rw [h_Auto_Spherical_MSS_pointwiseNormSquare_sub_eq]
  calc
    eLpNorm ((u - v) * star u + v * star (u - v)) 2 μ ≤
        eLpNorm ((u - v) * star u) 2 μ +
          eLpNorm (v * star (u - v)) 2 μ :=
      eLpNorm_add_le (by norm_num)
    _ ≤ eLpNorm (u - v) 4 μ * eLpNorm (star u) 4 μ +
          eLpNorm v 4 μ * eLpNorm (star (u - v)) 4 μ := by
      gcongr
