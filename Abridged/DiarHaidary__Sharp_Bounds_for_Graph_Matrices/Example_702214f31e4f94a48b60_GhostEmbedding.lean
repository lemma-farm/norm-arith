-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.SpectralNorm ====
section
/-!
# Explicit Euclidean operator norms

The norm below is defined through continuous linear maps of Euclidean spaces.
It never uses an unqualified/default norm on matrices.
-/
namespace GraphMatrices
noncomputable section
open scoped BigOperators RealInnerProductSpace
open WithLp
variable {m n k p q : Type*}
variable [Fintype m] [Fintype n] [Fintype k] [Fintype p] [Fintype q]
variable [DecidableEq n] [DecidableEq k] [DecidableEq p] [DecidableEq q]
/-- The actual linear operator between Euclidean coordinate spaces. -/
def euclideanOperator (A : Matrix m n ℝ) : EuclideanSpace ℝ n →L[ℝ] EuclideanSpace ℝ m :=
  (Matrix.toEuclideanLin.trans LinearMap.toContinuousLinearMap) A
/-- The spectral/operator norm, explicitly fixed to Euclidean input and output. -/
def spectralNorm (A : Matrix m n ℝ) : ℝ := ‖euclideanOperator A‖

variable [DecidableEq m]

end
end GraphMatrices

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.Separators ====
section
/-!
Vertex separators with boundary vertices allowed, including zero-length paths.
The occupied-edge signature is the literal signature of report 97, Section 4.
-/
namespace GraphMatrices
variable {α : Type*} [Fintype α] [DecidableEq α]
/-- The actual induced graph after removing the separator vertices. -/
abbrev outsideGraph (G : SimpleGraph α) (S : Finset α) :=
  G.induce {x | x ∉ S}
/-- No component of the graph outside S meets both boundaries.
The use of reachability includes paths of length zero. -/
def Separates (G : SimpleGraph α) (U V S : Finset α) : Prop :=
  ∀ (u v : {x : α // x ∉ S}), u.val ∈ U → v.val ∈ V →
    ¬ (outsideGraph G S).Reachable u v

set_option linter.unusedVariables false in
axiom _root_.GraphMatrices.exists_separator_card.{w_u_1} : ∀ {α : Type w_u_1} [Fintype α] [DecidableEq α] (G : SimpleGraph α) (U V : Finset α),
  ∃ (k : ℕ) (S : Finset α), GraphMatrices.Separates G U V S ∧ S.card = k
/-- The minimum cardinality of a genuine vertex separator. -/
noncomputable def minimumSeparatorSize (G : SimpleGraph α) (U V : Finset α) : ℕ := by
  classical
  exact Nat.find (exists_separator_card G U V)
def IsMinimumSeparator (G : SimpleGraph α) (U V S : Finset α) : Prop :=
  Separates G U V S ∧ S.card = minimumSeparatorSize G U V

end GraphMatrices

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.OccupationCreation ====
section
/-!
# Finite occupation creation and annihilation

Every occupation state is a literal finite subset of the finite primitive-edge
type. The matrices below are ordinary real matrices and consequently use the
Euclidean operator interpretation established in `SpectralNorm`.
-/
namespace GraphMatrices.OccupationCreation
noncomputable section
attribute [local instance] Classical.propDecidable
open scoped BigOperators
variable {E : Type*} [Fintype E] [DecidableEq E]
/-- The finite coordinate type for the occupation Hilbert space. -/
abbrev State (E : Type*) := Finset E
/-- The matrix of a deterministic transition that may be disabled at its source. -/
def transition (enabled : State E → Prop) [DecidablePred enabled]
    (next : State E → State E) :
    Matrix (State E) (State E) ℝ :=
  fun target source => if enabled source ∧ target = next source then 1 else 0

/-- Creation adds the complete edge set exactly when all its edges are unoccupied. -/
def creationAtom (A : Finset E) : Matrix (State E) (State E) ℝ :=
  transition (Disjoint A) (fun source => source ∪ A)

variable {ι : Type*} [Fintype ι]

variable {F : Type*} [Fintype F] [DecidableEq F]

end
namespace Colored
noncomputable section
attribute [local instance] Classical.propDecidable
variable {C D : Type*} [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D]
/-- Fixed root labels are omitted; an edge records only its interior endpoints.
In a simple rooted graph each endpoint set has cardinal one or two. -/
abbrev Primitive (incident : D → Finset C) (n : ℕ) :=
  (d : D) × ({x // x ∈ incident d} → Fin n)
/-- The primitive edge generated by one colored interior assignment. -/
def primitive (incident : D → Finset C) {n : ℕ} (φ : C → Fin n) (d : D) :
    Primitive incident n := ⟨d, fun x => φ x⟩
/-- Complete primitive-edge set of an assignment; abstract edge roles are retained. -/
def edges (incident : D → Finset C) {n : ℕ} (φ : C → Fin n) :
    Finset (Primitive incident n) := by
  classical
  exact Finset.univ.image (primitive incident φ)

end
end Colored
end GraphMatrices.OccupationCreation

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.FloatingComponents ====
section
/-!
The exponents of report 96, defined from the actual connected components of
the graph remaining after vertex deletion. No analytic estimate is assumed.
-/
namespace GraphMatrices
variable {α : Type*} [Fintype α] [DecidableEq α]
def NoFloatingAt (G : SimpleGraph α) (S U : Finset α) : Prop :=
  ∀ C : (outsideGraph G S).ConnectedComponent, ∃ u ∈ C.supp, u.val ∈ U

end GraphMatrices

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.BoundaryCreation ====
section
/-!
Literal pure-creation operators with input and output boundary registers.
All role labels are retained in primitive edges. Different roles have different
colors, so an arbitrary role assignment is a globally injective colored labeling.
-/
namespace GraphMatrices.BoundaryCreation
noncomputable section
attribute [local instance] Classical.propDecidable
open scoped BigOperators
open OccupationCreation
open OccupationCreation.Colored
variable {C D : Type*} [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D]
abbrev Labels (B : Finset C) (n : ℕ) := {x // x ∈ B} → Fin n
def boundaryLabels (B : Finset C) {n : ℕ} (φ : C → Fin n) : Labels B n :=
  fun x => φ x.val

/-- The incidence data of a literal finite simple graph: every edge has its
actual two endpoints. -/
abbrev graphIncident (G : SimpleGraph C) : G.edgeSet → Finset C :=
  fun e => e.val.toFinset

end
end GraphMatrices.BoundaryCreation

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Dependencies.vad36d74d65ba.GraphMatrices.BoundaryAmbient ====
section
/-! Side creators in an arbitrary larger primitive-edge universe. -/
namespace GraphMatrices.BoundaryCreation
noncomputable section
attribute [local instance] Classical.propDecidable
set_option maxHeartbeats 1000000
open scoped BigOperators
open OccupationCreation
open OccupationCreation.Colored
variable {C D E : Type*} [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D]
  [Fintype E] [DecidableEq E]
abbrev AmbientIndex (B : Finset C) (n : ℕ) := Labels B n × State E
def ambientAtom (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (e : Primitive incident n ↪ E) (φ : C → Fin n) :
    Matrix (AmbientIndex (E := E) U n) (AmbientIndex (E := E) S n) ℝ :=
  fun target source =>
    if source.1 = boundaryLabels S φ ∧ target.1 = boundaryLabels U φ then
      creationAtom ((edges incident φ).image e) target.2 source.2
    else 0
def ambientCreator (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (e : Primitive incident n ↪ E) (allowed : (C → Fin n) → Prop) :
    Matrix (AmbientIndex (E := E) U n) (AmbientIndex (E := E) S n) ℝ :=
  ∑ φ : C → Fin n, if allowed φ then ambientAtom incident S U e φ else 0

def boundedAmbientCreator (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (e : Primitive incident n ↪ E) (allowed : (C → Fin n) → Prop) (K : ℕ) :
    Matrix (AmbientIndex (E := E) U n)
      {source : AmbientIndex (E := E) S n // source.2.card ≤ K} ℝ :=
  (ambientCreator incident S U e allowed).submatrix id Subtype.val

end
end GraphMatrices.BoundaryCreation

end

-- ==== Examples.DiarHaidary__Sharp_Bounds_for_Graph_Matrices.Examples.Example_702214f31e4f94a48b60_GhostEmbedding ====
/-! Extending a partial primitive-edge injection by unused ghost coordinates.
This permits arbitrary disjoint role pools inside the actual label universe. -/
namespace GraphMatrices.GhostEmbedding
noncomputable section
attribute [local instance] Classical.propDecidable
open scoped BigOperators
open OccupationCreation OccupationCreation.Colored BoundaryCreation
variable {P E : Type*} [Fintype P] [DecidableEq P] [Fintype E] [DecidableEq E]
/-- Good primitive coordinates use their actual edge; all others receive a
distinct coordinate in a separate summand. -/
def extendEmbedding (good : P → Prop) (f : {x // good x} ↪ E) : P ↪ E ⊕ P where
  toFun x := if h : good x then Sum.inl (f ⟨x, h⟩) else Sum.inr x
  inj' := by
    intro x y h
    by_cases hx : good x <;> by_cases hy : good y
    · simp only [hx, hy, dite_true, Sum.inl.injEq] at h
      exact congrArg Subtype.val (f.injective h)
    · simp [hx, hy] at h
    · simp [hx, hy] at h
    · simpa [hx, hy] using h

def realEdges (good : P → Prop) (f : {x // good x} ↪ E) (A : Finset P) : Finset E :=
  (A.subtype good).image f

def stateEmbedding : State E ↪ State (E ⊕ P) where
  toFun Ω := Ω.image Sum.inl
  inj' := Finset.image_injective Sum.inl_injective
set_option linter.unusedVariables false in
axiom _root_.GraphMatrices.GhostEmbedding.stateEmbedding_card.{w_u_1,w_u_2} : ∀ {P : Type w_u_1} {E : Type w_u_2} [Fintype P] [inst : DecidableEq P] [Fintype E]
  [inst_2 : DecidableEq E] (Ω : GraphMatrices.OccupationCreation.State E),
  Finset.card
      ((GraphMatrices.GhostEmbedding.stateEmbedding :
          GraphMatrices.OccupationCreation.State E → GraphMatrices.OccupationCreation.State (E ⊕ P))
        Ω) =
    Finset.card Ω

variable {C D : Type*} [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D]
def indexEmbedding (B : Finset C) (n : ℕ) :
    AmbientIndex (E := E) B n ↪ AmbientIndex (E := E ⊕ P) B n where
  toFun x := (x.1, stateEmbedding x.2)
  inj' := by
    intro x y h
    apply Prod.ext
    · exact congrArg (fun z : AmbientIndex (E := E ⊕ P) B n => z.1) h
    exact stateEmbedding.injective
      (congrArg (fun z : AmbientIndex (E := E ⊕ P) B n => z.2) h)
def boundedIndexEmbedding (B : Finset C) (n K : ℕ) :
    {x : AmbientIndex (E := E) B n // x.2.card ≤ K} ↪
      {x : AmbientIndex (E := E ⊕ P) B n // x.2.card ≤ K} where
  toFun x := ⟨indexEmbedding B n x.val, by
    change (stateEmbedding (P := P) x.val.2).card ≤ K
    simpa only [stateEmbedding_card] using x.property⟩
  inj' := by
    intro x y h
    apply Subtype.ext
    exact (indexEmbedding B n).injective (congrArg Subtype.val h)
def realAtom (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (good : Primitive incident n → Prop) (f : {x // good x} ↪ E)
    (φ : C → Fin n) :
    Matrix (AmbientIndex (E := E) U n) (AmbientIndex (E := E) S n) ℝ :=
  fun target source =>
    if source.1 = boundaryLabels S φ ∧ target.1 = boundaryLabels U φ then
      creationAtom (realEdges good f (edges incident φ)) target.2 source.2
    else 0
/-- The actual creator on the real edge space, defined even when the partial
primitive map cannot be extended inside that space. -/
def realCreator (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (good : Primitive incident n → Prop) (f : {x // good x} ↪ E)
    (allowed : (C → Fin n) → Prop) :
    Matrix (AmbientIndex (E := E) U n) (AmbientIndex (E := E) S n) ℝ :=
  ∑ φ, if allowed φ then realAtom incident S U good f φ else 0
def boundedRealCreator (incident : D → Finset C) (S U : Finset C) {n : ℕ}
    (good : Primitive incident n → Prop) (f : {x // good x} ↪ E)
    (allowed : (C → Fin n) → Prop) (K : ℕ) :=
  (realCreator incident S U good f allowed).submatrix id
    (Subtype.val : {x : AmbientIndex (E := E) S n // x.2.card ≤ K} → _)


set_option linter.unusedVariables false in
/-- Ghost coordinates introduce no loss in the side-creation estimate: the
actual operator is a coordinate compression of the already bounded operator. -/
theorem boundedRealCreator_norm_sq_le (G : SimpleGraph C) (S U : Finset C)
    (hmin : IsMinimumSeparator G S U S) (hnf : NoFloatingAt G S U) {n : ℕ}
    (good : Primitive (graphIncident G) n → Prop) (f : {x // good x} ↪ E)
    (allowed : (C → Fin n) → Prop)
    (hgood : ∀ φ, allowed φ → ∀ x ∈ edges (graphIncident G) φ, good x) (K : ℕ) 
    (h_GraphMatrices_spectralNorm_submatrix_le : ∀ {m n p q : Type (max u_3 u_2)} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : Fintype p]
      [inst_3 : Fintype q] [inst_4 : DecidableEq n] [inst_5 : DecidableEq q] [DecidableEq m]
      (A : Matrix m n ℝ) (e : p ↪ m) (f : q ↪ n),
      GraphMatrices.spectralNorm (A.submatrix (⇑e : p → m) (⇑f : q → n)) ≤ GraphMatrices.spectralNorm A)
    (h_GraphMatrices_BoundaryCreation_ambientGraphCreator_norm_sq_le : ∀ {C : Type u_3} {E : Type (max u_3 u_2)} [inst : Fintype C] [inst_1 : DecidableEq C]
      [inst_2 : Fintype E] [inst_3 : DecidableEq E] (G : SimpleGraph C) (S U : Finset C),
      GraphMatrices.IsMinimumSeparator G S U S →
        GraphMatrices.NoFloatingAt G S U →
          ∀ {n : ℕ}
            (e :
              GraphMatrices.OccupationCreation.Colored.Primitive
                  (GraphMatrices.BoundaryCreation.graphIncident G) n ↪
                E)
            (allowed : (C → Fin n) → Prop) (K : ℕ),
            GraphMatrices.spectralNorm
                  (GraphMatrices.BoundaryCreation.boundedAmbientCreator
                    (GraphMatrices.BoundaryCreation.graphIncident G) S U e allowed K) ^
                2 ≤
              (↑(n ^ (Fintype.card C - S.card) +
                    (Fintype.card C - S.card) * n ^ (Fintype.card C - S.card - 1) *
                      (1 + 2 * K) ^ (Fintype.card C + 1)) :
                ℝ))
    (h_GraphMatrices_spectralNorm_nonneg : ∀ {m n : Type (max u_3 u_2)} [inst : Fintype m] [inst_1 : Fintype n] [inst_2 : DecidableEq n]
      (A : Matrix m n ℝ), 0 ≤ GraphMatrices.spectralNorm A)
    (h_GraphMatrices_GhostEmbedding_boundedRealCreator_eq_submatrix : ∀ {E : Type u_2} [inst : Fintype E] [inst_1 : DecidableEq E] {C D : Type u_3} [inst_2 : Fintype C]
      [inst_3 : DecidableEq C] [inst_4 : Fintype D] [inst_5 : DecidableEq D] (incident : D → Finset C)
      (S U : Finset C) {n : ℕ}
      (good : GraphMatrices.OccupationCreation.Colored.Primitive incident n → Prop)
      (f : { x : GraphMatrices.OccupationCreation.Colored.Primitive incident n // good x } ↪ E)
      (allowed : (C → Fin n) → Prop),
      (∀ (φ : C → Fin n),
          allowed φ → ∀ x ∈ GraphMatrices.OccupationCreation.Colored.edges incident φ, good x) →
        ∀ (K : ℕ),
          GraphMatrices.GhostEmbedding.boundedRealCreator incident S U good f allowed K =
            (GraphMatrices.BoundaryCreation.boundedAmbientCreator incident S U
                  (GraphMatrices.GhostEmbedding.extendEmbedding good f) allowed K).submatrix
              (⇑(GraphMatrices.GhostEmbedding.indexEmbedding U n) :
                GraphMatrices.BoundaryCreation.AmbientIndex U n →
                  GraphMatrices.BoundaryCreation.AmbientIndex U n)
              (⇑(GraphMatrices.GhostEmbedding.boundedIndexEmbedding S n K) :
                { x : GraphMatrices.BoundaryCreation.AmbientIndex S n // Finset.card x.2 ≤ K } →
                  { x : GraphMatrices.BoundaryCreation.AmbientIndex S n // Finset.card x.2 ≤ K }))
    :
    spectralNorm (boundedRealCreator (graphIncident G) S U good f allowed K) ^ 2 ≤
      (n ^ (Fintype.card C - S.card) +
        (Fintype.card C - S.card) * n ^ (Fintype.card C - S.card - 1) *
          (1 + 2 * K) ^ (Fintype.card C + 1) : ℕ) := by
  rw [h_GraphMatrices_GhostEmbedding_boundedRealCreator_eq_submatrix _ _ _ _ _ _ hgood]
  apply le_trans (pow_le_pow_left₀ (h_GraphMatrices_spectralNorm_nonneg _)
    (h_GraphMatrices_spectralNorm_submatrix_le _ (indexEmbedding U n) (boundedIndexEmbedding S n K)) 2)
  exact h_GraphMatrices_BoundaryCreation_ambientGraphCreator_norm_sq_le G S U hmin hnf (extendEmbedding good f) allowed K
end
end GraphMatrices.GhostEmbedding
