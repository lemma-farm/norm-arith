-- ==== Examples.djalilchafai__ginibre_poincare.Examples.Example_841633c2195ba52c7029_StrongConvexProductTransport ====
@[expose] public section
open MeasureTheory ProbabilityTheory
open scoped ContDiff BigOperators NNReal
namespace GinibrePoincare
noncomputable section
set_option backward.isDefEq.respectTransparency false
variable {I : Type*} [Fintype I] [DecidableEq I]
def coordinateQuantileTransport (T : I → ℝ → ℝ) (x : I → ℝ) : I → ℝ := fun i => T i (x i)


set_option linter.unusedVariables false in
theorem coordinateQuantileTransport_energy (T : I → ℝ → ℝ)
    (hT : ∀ i, ContDiff ℝ 1 (T i)) (L : ℝ)
    (hb : ∀ i x, |deriv (T i) x| ≤ L)
    (f : (I → ℝ) → ℝ) (hf : Differentiable ℝ f) (x : I → ℝ) 
    (h_GinibrePoincare_coordinateQuantileTransport_fderiv_direction : ∀ {I : Type u_1} [Fintype I] [inst : DecidableEq I] (T : I → ℝ → ℝ),
      (∀ (i : I), ContDiff ℝ 1 (T i)) →
        ∀ (x : I → ℝ) (i : I),
          (fderiv ℝ (GinibrePoincare.coordinateQuantileTransport T) x : (I → ℝ) → I → ℝ)
              (Pi.single i 1) =
            deriv (T i) (x i) • Pi.single i 1)
    (h_GinibrePoincare_coordinateQuantileTransport_contDiff : ∀ {I : Type u_1} [inst : Fintype I] [DecidableEq I] (T : I → ℝ → ℝ),
      (∀ (i : I), ContDiff ℝ 1 (T i)) → ContDiff ℝ 1 (GinibrePoincare.coordinateQuantileTransport T))
    :
    directionalEnergy (fun i : I => Pi.single i 1) (f ∘ coordinateQuantileTransport T) x ≤
      L ^ 2 * directionalEnergy (fun i : I => Pi.single i 1) f (coordinateQuantileTransport T x) := by
  rw [directionalEnergy, directionalEnergy, Finset.mul_sum]
  apply Finset.sum_le_sum
  intro i hi
  rw [fderiv_comp x (hf _) ((h_GinibrePoincare_coordinateQuantileTransport_contDiff T hT).differentiable (by norm_num) x)]
  simp only [ContinuousLinearMap.comp_apply, h_GinibrePoincare_coordinateQuantileTransport_fderiv_direction T hT,
    map_smul, smul_eq_mul, mul_pow]
  have hL : 0 ≤ L := (abs_nonneg (deriv (T i) (x i))).trans (hb i (x i))
  have hsq : (deriv (T i) (x i)) ^ 2 ≤ L ^ 2 := by
    nlinarith [hb i (x i), sq_abs (deriv (T i) (x i)), abs_nonneg (deriv (T i) (x i))]
  exact mul_le_mul_of_nonneg_right hsq (sq_nonneg _)
end
end GinibrePoincare
