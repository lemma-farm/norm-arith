/-- Blueprint `lem:rational-linear`: height is the maximum of the absolute
reduced numerator and the positive reduced denominator. -/
def rationalHeight (q : ℚ) : ℕ := max q.num.natAbs q.den

axiom rational_abs_le_height (q : ℚ) : |q| ≤ (rationalHeight q : ℚ)

/-- The explicit Cramer bound underlying `lem:rational-linear`: inverse
entry heights are bounded by a factorial times a polynomial power of `B`. -/
axiom rationalMatrix_inverse_height_raw {n B : ℕ} (hB : 1 ≤ B)
    (A : Matrix (Fin n) (Fin n) ℚ) (hA : ∀ i j, rationalHeight (A i j) ≤ B)
    (hdet : A.det ≠ 0) (i j) :
    rationalHeight (A⁻¹ i j) ≤ n.factorial * B ^ (n ^ 2 + n * (n ^ 2 + 1))

/-- An entrywise bound controls the Euclidean operator norm. The harmless
quadratic dimension factor is absorbed in the source exponential bound. -/
axiom realMatrix_operatorNorm_le {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    {K : ℝ} (hK : 0 ≤ K) (hA : ∀ i j, |A i j| ≤ K) :
    ‖Matrix.toEuclideanCLM (𝕜 := ℝ) A‖ ≤ (n : ℝ) ^ 2 * K
axiom rational_inverse_budget (n B : ℕ) (hB : 1 ≤ B) :
    (n + 1) ^ 2 * (n.factorial * B ^ (n ^ 2 + n * (n ^ 2 + 1))) ≤
      (2 * B) ^ (2 * (n + 1) ^ 4)
/-- Blueprint `lem:rational-linear`, lines 418–420: nonsingular rational
inverses have entry heights and Euclidean operator norm at most
`exp (2 (d+1)^4 log (2B))`, uniformly for dimensions at most `d`. -/
theorem rationalMatrix_inverse_bounds {n d : ℕ} (hnd : n ≤ d)
    {B : ℝ} (hB : 2 ≤ B) (A : Matrix (Fin n) (Fin n) ℚ)
    (hA : ∀ i j, (rationalHeight (A i j) : ℝ) ≤ B) (hdet : A.det ≠ 0) :
    (∀ i j, (rationalHeight (A⁻¹ i j) : ℝ) ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B))) ∧
    ‖Matrix.toEuclideanCLM (𝕜 := ℝ) (A⁻¹.map (fun q => (q : ℝ)))‖ ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
  let b := ⌊B⌋₊
  let R := n.factorial * b ^ (n ^ 2 + n * (n ^ 2 + 1))
  have hb : 1 ≤ b := Nat.le_floor (by norm_num; linarith)
  have hheight (i j) : rationalHeight (A⁻¹ i j) ≤ R :=
    rationalMatrix_inverse_height_raw hb A (fun i j => Nat.le_floor (hA i j)) hdet i j
  have htotal : (((n + 1) ^ 2 * R : ℕ) : ℝ) ≤
      Real.exp (2 * (d + 1 : ℝ) ^ 4 * Real.log (2 * B)) := by
    calc
      _ ≤ (2 * (b : ℝ)) ^ (2 * (n + 1) ^ 4) := by
        exact_mod_cast rational_inverse_budget n b hb
      _ ≤ (2 * B) ^ (2 * (n + 1) ^ 4) := by
        apply pow_le_pow_left₀ (by positivity)
        have := Nat.floor_le (show 0 ≤ B by linarith)
        dsimp [b]
        linarith
      _ ≤ (2 * B) ^ (2 * (d + 1) ^ 4) :=
        pow_le_pow_right₀ (by linarith)
          (Nat.mul_le_mul_left 2 (Nat.pow_le_pow_left (Nat.add_le_add_right hnd 1) 4))
      _ = _ := by
        have he : 2 * (d + 1 : ℝ) ^ 4 = ((2 * (d + 1) ^ 4 : ℕ) : ℝ) := by push_cast; rfl
        rw [he, Real.exp_nat_mul, Real.exp_log (by linarith : 0 < 2 * B)]
  constructor
  · intro i j
    apply le_trans _ htotal
    exact_mod_cast (hheight i j).trans
      (Nat.le_mul_of_pos_left R (by positivity : 0 < (n + 1) ^ 2))
  · apply (realMatrix_operatorNorm_le _ (Nat.cast_nonneg R) ?_).trans
      ((show (n : ℝ) ^ 2 * R ≤ (((n + 1) ^ 2 * R : ℕ) : ℝ) by
        push_cast
        exact mul_le_mul_of_nonneg_right
          (by nlinarith [Nat.cast_nonneg (α := ℝ) n]) (Nat.cast_nonneg R)).trans htotal)
    intro i j
    change |(A⁻¹ i j : ℝ)| ≤ (R : ℝ)
    have hh : |A⁻¹ i j| ≤ (R : ℚ) :=
      (rational_abs_le_height _).trans (by exact_mod_cast hheight i j)
    exact_mod_cast hh

