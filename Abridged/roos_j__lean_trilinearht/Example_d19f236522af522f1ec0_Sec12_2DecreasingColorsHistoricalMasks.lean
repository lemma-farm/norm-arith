/-- The data of the coloring (blueprint lines 1714-1728): graph distances, the parameters
`d₀, b₁, b₂` and the primary and high delay arrays (one per round), with values in `[0, d₀]`. -/
structure ColorSetup (V : Type*) where
  dist : DepthDistance V
  d0 : ℕ
  b1 : ℕ
  b2 : ℕ
  Dp : Fin d0 → V → ℕ
  Dh : Fin d0 → V → ℕ
  Dp_le : ∀ ρ v, Dp ρ v ≤ d0
  Dh_le : ∀ ρ v, Dh ρ v ≤ d0
namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)
noncomputable def prof (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) : WithBot ℤ :=
  (W.erase z).sup (fun w => if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ))
/-- The lower clipping level `T_l = (g - 3) b₁ + l b₁/(2 d₀)`. -/
noncomputable def Tl (g : ℤ) (l : ℕ) : ℝ := (g - 3) * K.b1 + l * K.b1 / (2 * K.d0)
/-- The upper clipping level `U = (g - 2) b₁`. -/
noncomputable def Ul (g : ℤ) : ℝ := (g - 2) * K.b1
noncomputable def lowMet (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V) : ℝ :=
  ⨆ s' : ℤ, |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') -
    clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|
end ColorSetup
