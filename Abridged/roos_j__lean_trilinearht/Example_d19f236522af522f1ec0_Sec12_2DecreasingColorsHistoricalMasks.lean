/-! ### Profiles and the context pseudometrics -/
namespace ColorSetup
variable {V : Type*} [DecidableEq V] (K : ColorSetup V)
noncomputable def clipDiff (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) (l : ℕ) (a b : V)
    (s' : ℤ) : ℝ :=
  |clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W a s') - clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b s')|

set_option linter.unusedVariables false in
axiom _root_.Auto.ColorSetup.clipDiff_le_lowMet.{w_u_1} : ∀ {V : Type w_u_1} [inst : DecidableEq V] (K : Auto.ColorSetup V) (ρ : Fin K.d0) (g : ℤ) (z : V)
  (W : Finset V) {l : ℕ},
  l ≤ 2 * K.d0 → ∀ (a b : V) (s' : ℤ), K.clipDiff ρ g z W l a b s' ≤ K.lowMet ρ g z W l a b
set_option linter.unusedVariables false in
axiom _root_.Auto.ColorSetup.lowMet_le_of.{w_u_1} : ∀ {V : Type w_u_1} [inst : DecidableEq V] (K : Auto.ColorSetup V) (ρ : Fin K.d0) (g : ℤ) (z : V)
  (W : Finset V) (l : ℕ) (a b : V) {c : ℝ},
  (∀ (s' : ℤ), K.clipDiff ρ g z W l a b s' ≤ c) → K.lowMet ρ g z W l a b ≤ c
theorem lowMet_triangle (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl : l ≤ 2 * K.d0) (a b c : V) :
    K.lowMet ρ g z W l a c ≤ K.lowMet ρ g z W l a b + K.lowMet ρ g z W l b c := by
  apply K.lowMet_le_of
  intro s'
  have h1 := K.clipDiff_le_lowMet ρ g z W hl a b s'
  have h2 := K.clipDiff_le_lowMet ρ g z W hl b c s'
  unfold clipDiff at h1 h2 ⊢
  exact (abs_sub_le _ _ _).trans (add_le_add h1 h2)
