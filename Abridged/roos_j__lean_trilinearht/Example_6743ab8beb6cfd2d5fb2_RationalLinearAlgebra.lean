namespace Auto

noncomputable def realMatrixOperator {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) :
    EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m) :=
  LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin (𝕜 := ℝ) A)

open Matrix
open scoped Matrix

set_option linter.unusedVariables false in
theorem realMatrix_norm_le_from_scaled_columns {k : ℕ}
    (A : Matrix (Fin k) (Fin k) ℝ) {s R : ℝ} (hs : 0 < s) (hR : 0 ≤ R)
    (hcol : ∀ j, ∃ t : ℝ, s ≤ t ∧
      ‖realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)‖ ≤ R) 
    (h_Auto_realMatrixOperator_basis_apply : ∀ {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (j : Fin n),
      (Auto.realMatrixOperator A : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
          ((EuclideanSpace.basisFun (Fin n) ℝ : Fin n → EuclideanSpace ℝ (Fin n)) j) =
        WithLp.toLp 2 (A.col j))
    (h_Auto_realMatrixOperator_norm_le : ∀ {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) {K : ℝ},
      0 ≤ K →
        (∀ (i : Fin m) (j : Fin n), |A i j| ≤ K) → ‖Auto.realMatrixOperator A‖ ≤ (↑m : ℝ) * (↑n : ℝ) * K)
    :
    ‖realMatrixOperator A‖ ≤ (k : ℝ) * k * (R / s) := by
  apply h_Auto_realMatrixOperator_norm_le _ (div_nonneg hR hs.le)
  intro i j
  obtain ⟨t, hst, ht⟩ := hcol j
  have htp : 0 < t := hs.trans_le hst
  have hc := PiLp.norm_apply_le
    (realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)) i
  have he : (realMatrixOperator A (t • EuclideanSpace.basisFun (Fin k) ℝ j)) i =
      t * A i j := by
    rw [map_smul, h_Auto_realMatrixOperator_basis_apply]
    rfl
  rw [he, Real.norm_eq_abs, abs_mul, abs_of_pos htp] at hc
  apply (le_div_iff₀ hs).mpr
  have hm := mul_le_mul_of_nonneg_right hst (abs_nonneg (A i j))
  nlinarith only [hm, hc, ht]
end Auto
