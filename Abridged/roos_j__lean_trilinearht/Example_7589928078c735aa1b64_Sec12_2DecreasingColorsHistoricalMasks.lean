/-- The code of a round datum, forgetting the winner: `0` on failure, else `1 + ρ + d₀ g`. -/
def roundCode (t : Option (Fin K.d0 × V × ℤ)) : ℕ :=
  match t with
  | none => 0
  | some (ρ, _, g) => 1 + ρ + K.d0 * g.toNat
def radix (Nv : ℕ) : ℕ := (K.d0 + 1) ^ 2 + Nat.size Nv + flog32 Nv + 1
/-- The metadata encoding. -/
def metaCode (Nv : ℕ)
    (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) : ℕ :=
  (((K.roundCode c.1 * K.radix Nv + c.2.1) * K.radix Nv + c.2.2.1.1) * K.radix Nv +
    c.2.2.1.2) * K.radix Nv + K.roundCode c.2.2.2

noncomputable def color (Nv : ℕ) (I : T.Cell) (v : V) : ℕ :=
  (K.potMax Nv - K.changes T I v) * K.radix Nv ^ 5 + K.metaCode Nv (K.colorData (T.st I) v) + 1
end ColorSetup
