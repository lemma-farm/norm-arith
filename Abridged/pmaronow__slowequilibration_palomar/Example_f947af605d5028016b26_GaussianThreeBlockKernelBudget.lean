-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.v13616b19efac.SlowEquilibration.GaussianSpinInterpolation ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-! Ordinary integral partition functions for bounded measurable families of
linear fields. The spin measure may be nonatomic, including the genuine
uniform sphere law. Differentiation is proved by dominated convergence. -/
namespace SlowEquilibration.GaussianSpinInterpolation
noncomputable section
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology RealInnerProductSpace
variable {V H : Type*} [MeasurableSpace V]
  [NormedAddCommGroup H] [NormedSpace ℝ H] [CompleteSpace H]
  [FiniteDimensional ℝ H]
set_option linter.unusedSectionVars false
set_option maxHeartbeats 300000
set_option backward.isDefEq.respectTransparency false
def weight (ρ : V → ℝ) (L : V → H →L[ℝ] ℝ) (w : H) (v : V) : ℝ :=
  ρ v * Real.exp (L v w)
def moment (ν : Measure V) (ρ : V → ℝ) (L : V → H →L[ℝ] ℝ) (w : H) : ℝ :=
  ∫ v, weight ρ L w v ∂ν

def expectation (ν : Measure V) (ρ : V → ℝ) (L : V → H →L[ℝ] ℝ) (w : H) : ℝ :=
  moment ν ρ L w / moment ν (fun _ => 1) L w

def gibbsMeasure (ν : Measure V) (L : V → H →L[ℝ] ℝ) (w : H) : Measure V :=
  ν.withDensity (fun v => ENNReal.ofReal
    (Real.exp (L v w) / moment ν (fun _ => 1) L w))

end
end SlowEquilibration.GaussianSpinInterpolation

end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.v13616b19efac.SlowEquilibration.GaussianThreeBlockComparison ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-! Actual original/trial Gaussian rotation with a third independent perturbation
block held fixed. Its derivative has exactly zero contribution from that block. -/
namespace SlowEquilibration.GaussianThreeBlockComparison
noncomputable section
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology RealInnerProductSpace
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
variable {ι V : Type*} [Fintype ι] [MeasurableSpace V]
/-- The actual diagonal linear map on the Euclidean disorder coordinates. -/
def diagonal (a : ι → ℝ) : EuclideanSpace ℝ ι →L[ℝ] EuclideanSpace ℝ ι :=
  (PiLp.continuousLinearEquiv 2 ℝ (fun _ : ι => ℝ)).symm.toContinuousLinearMap.comp
    (ContinuousLinearMap.pi (fun i => a i • PiLp.proj 2 (fun _ : ι => ℝ) i))

def coordinateMask (label : ι → Fin 3) (b : Fin 3) : EuclideanSpace ℝ ι →L[ℝ] EuclideanSpace ℝ ι :=
  diagonal (fun i => if label i = b then 1 else 0)
def rotation (label : ι → Fin 3) (θ : ℝ) : EuclideanSpace ℝ ι →L[ℝ] EuclideanSpace ℝ ι :=
  Real.cos θ • coordinateMask label 0 + Real.sin θ • coordinateMask label 1 + coordinateMask label 2

def rotatedLinear (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ) (label : ι → Fin 3) (θ : ℝ) :=
  fun v => (L v).comp (rotation label θ)

variable [DecidableEq ι]
def coordinateObservable (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ) (i : ι) : V → ℝ :=
  fun v => L v (EuclideanSpace.single i 1)

def covarianceSign (label : ι → Fin 3) (i : ι) : ℝ := if label i=0 then -1 else if label i=1 then 1 else 0
def signedKernel (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ) (label : ι → Fin 3) (v u : V) : ℝ :=
  ∑ i, covarianceSign label i * (coordinateObservable L i v * coordinateObservable L i u)

end
end SlowEquilibration.GaussianThreeBlockComparison

end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.v13616b19efac.SlowEquilibration.GaussianThreeBlockMeanComparison ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-! Three-block Guerra comparison from the actual disorder-averaged
pair covariance. The fixed perturbation block cancels from the derivative. -/
namespace SlowEquilibration.GaussianThreeBlockComparison
noncomputable section
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology RealInnerProductSpace
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 1200000
variable {V ι : Type*} [MeasurableSpace V] [Fintype ι] [DecidableEq ι]
def pairKernelExpectation (ν : Measure V) (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ)
    (label : ι → Fin 3) (θ : ℝ) (w : EuclideanSpace ℝ ι) : ℝ :=
  ∫ z : V × V,signedKernel L label z.1 z.2
    ∂(GaussianSpinInterpolation.gibbsMeasure ν (rotatedLinear L label θ) w).prod
      (GaussianSpinInterpolation.gibbsMeasure ν (rotatedLinear L label θ) w)

end
end SlowEquilibration.GaussianThreeBlockComparison

end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Examples.Example_f947af605d5028016b26_GaussianThreeBlockKernelBudget ====
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-! # A finite domination budget for the actual three-block replica kernel

This bound is used only for parameter measurability and integrability.
Its dependence on the finite coordinate cardinality is explicit.
-/
namespace SlowEquilibration.GaussianThreeBlockComparison
noncomputable section
open Set MeasureTheory ProbabilityTheory
open scoped RealInnerProductSpace
set_option maxHeartbeats 900000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
variable {V ι : Type*} [MeasurableSpace V] [Fintype ι] [DecidableEq ι]
set_option linter.unusedVariables false in
theorem norm_pairKernelExpectation_le (ν : Measure V) [IsProbabilityMeasure ν]
    (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ) (hL : Measurable L)
    {K : ℝ} (hK : 0 ≤ K) (hb : ∀ᵐ v ∂ν,‖L v‖ ≤ K) (label : ι → Fin 3) (θ : ℝ)
    (w : EuclideanSpace ℝ ι) 
    (h_SlowEquilibration_GaussianThreeBlockComparison_rotatedLinear_bound : ∀ {ι : Type u_2} {V : Type u_1} [inst : Fintype ι] [inst_1 : MeasurableSpace V]
      (ν : MeasureTheory.Measure V) (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ) {K : ℝ},
      0 ≤ K →
        (∀ᵐ (v : V) ∂ν, ‖L v‖ ≤ K) →
          ∀ (label : ι → Fin 3) (θ : ℝ),
            ∀ᵐ (v : V) ∂ν,
              ‖SlowEquilibration.GaussianThreeBlockComparison.rotatedLinear L label θ v‖ ≤ K)
    (h_SlowEquilibration_GaussianThreeBlockComparison_coordinateObservable_bound : ∀ {ι : Type u_2} {V : Type u_1} [inst : Fintype ι] [inst_1 : MeasurableSpace V]
      [inst_2 : DecidableEq ι] (ν : MeasureTheory.Measure V) (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ)
      {K : ℝ},
      (∀ᵐ (v : V) ∂ν, ‖L v‖ ≤ K) →
        ∀ (i : ι),
          ∀ᵐ (v : V) ∂ν, |SlowEquilibration.GaussianThreeBlockComparison.coordinateObservable L i v| ≤ K)
    (h_SlowEquilibration_GaussianSpinInterpolation_norm_expectation_le : ∀ {V : Type u_1} {H : Type u_2} [inst : MeasurableSpace V] [inst_1 : NormedAddCommGroup H]
      [inst_2 : NormedSpace ℝ H] [CompleteSpace H] [FiniteDimensional ℝ H] (ν : MeasureTheory.Measure V)
      [MeasureTheory.IsFiniteMeasure ν] [NeZero ν] (ρ : V → ℝ) (L : V → H →L[ℝ] ℝ),
      Measurable ρ →
        Measurable L →
          ∀ {C K : ℝ},
            0 ≤ C →
              (∀ᵐ (v : V) ∂ν, |ρ v| ≤ C ∧ ‖L v‖ ≤ K) →
                ∀ (w : H), ‖SlowEquilibration.GaussianSpinInterpolation.expectation ν ρ L w‖ ≤ C)
    (h_SlowEquilibration_GaussianThreeBlockComparison_pairKernelExpectation_eq_coordinate_sum : ∀ {V : Type u_1} {ι : Type u_2} [inst : MeasurableSpace V] [inst_1 : Fintype ι]
      [inst_2 : DecidableEq ι] (ν : MeasureTheory.Measure V) [MeasureTheory.IsProbabilityMeasure ν]
      (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ),
      Measurable L →
        ∀ {K : ℝ},
          0 ≤ K →
            (∀ᵐ (v : V) ∂ν, ‖L v‖ ≤ K) →
              ∀ (label : ι → Fin 3) (θ : ℝ) (w : EuclideanSpace ℝ ι),
                SlowEquilibration.GaussianThreeBlockComparison.pairKernelExpectation ν L label θ w =
                  ∑ i : ι,
                    SlowEquilibration.GaussianThreeBlockComparison.covarianceSign label i *
                      SlowEquilibration.GaussianSpinInterpolation.expectation ν
                          (SlowEquilibration.GaussianThreeBlockComparison.coordinateObservable L i)
                          (SlowEquilibration.GaussianThreeBlockComparison.rotatedLinear L label θ) w ^
                        2)
    (h_SlowEquilibration_GaussianThreeBlockComparison_rotatedLinear_measurable : ∀ {ι : Type u_2} {V : Type u_1} [inst : Fintype ι] [inst_1 : MeasurableSpace V]
      (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ),
      Measurable L →
        ∀ (label : ι → Fin 3) (θ : ℝ),
          Measurable (SlowEquilibration.GaussianThreeBlockComparison.rotatedLinear L label θ))
    (h_SlowEquilibration_GaussianThreeBlockComparison_coordinateObservable_measurable : ∀ {ι : Type u_2} {V : Type u_1} [inst : Fintype ι] [inst_1 : MeasurableSpace V]
      [inst_2 : DecidableEq ι] (L : V → EuclideanSpace ℝ ι →L[ℝ] ℝ),
      Measurable L →
        ∀ (i : ι), Measurable (SlowEquilibration.GaussianThreeBlockComparison.coordinateObservable L i))
    :
    ‖pairKernelExpectation ν L label θ w‖ ≤ (Fintype.card ι : ℝ)*K^2 := by
  rw [h_SlowEquilibration_GaussianThreeBlockComparison_pairKernelExpectation_eq_coordinate_sum ν L hL hK hb label θ w]
  calc
    _ ≤ ∑ i : ι,‖covarianceSign label i*
        (GaussianSpinInterpolation.expectation ν (coordinateObservable L i) (rotatedLinear L label θ) w)^2‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _i : ι,K^2 := by
      apply Finset.sum_le_sum
      intro i _
      have hs : ‖covarianceSign label i‖ ≤ 1 := by
        unfold covarianceSign
        split_ifs <;> norm_num
      have he := h_SlowEquilibration_GaussianSpinInterpolation_norm_expectation_le ν (coordinateObservable L i)
        (rotatedLinear L label θ) (h_SlowEquilibration_GaussianThreeBlockComparison_coordinateObservable_measurable L hL i)
        (h_SlowEquilibration_GaussianThreeBlockComparison_rotatedLinear_measurable L hL label θ) hK
        ((h_SlowEquilibration_GaussianThreeBlockComparison_coordinateObservable_bound ν L hb i).and (h_SlowEquilibration_GaussianThreeBlockComparison_rotatedLinear_bound ν L hK hb label θ)) w
      rw [norm_mul,norm_pow]
      calc
        _ ≤ 1*K^2 := mul_le_mul hs ((sq_le_sq₀ (norm_nonneg _) hK).mpr he) (by positivity) (by norm_num)
        _ = _ := one_mul _
    _ = _ := by simp
end
end SlowEquilibration.GaussianThreeBlockComparison
