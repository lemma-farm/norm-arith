-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vdd13bda0b125.SlowEquilibration.SphericalModel ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-!
# Actual finite mixed spherical Gaussian fields

The degree blocks are independent genuine ordered Gaussian tensors from the
immutable `all-lean` dependency. Degrees range from two through a fixed finite
maximum, with arbitrary nonnegative coefficients and no parity restriction.
The field is a finite linear combination of these tensors with the manuscript's
normalization. Its Gaussian finite-dimensional laws, smoothness, mean and
covariance are proved against that product disorder measure.

These are the field foundations of `lem:pre-field`. They do not construct a
Parisi minimizer or prove any slow-equilibration estimate.
-/
namespace SlowEquilibration.SphericalModel
noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators InnerProductSpace
abbrev Degree (P : ℕ) := {p : Fin (P + 1) // 2 ≤ p.val}

/-- The ordinary covariance polynomial of the finite degree family. -/
def covariancePolynomial {P : ℕ} (c : Degree P → ℝ) (r : ℝ) : ℝ :=
  ∑ p : Degree P, c p * r ^ p.val.val
end
end SlowEquilibration.SphericalModel

end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Examples.Example_f57905c8bb658c610e3b_SphericalTemperatureStability ====
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-! # Actual quenched-pressure stability under varying temperature

The genuine Gibbs-replica derivative and spherical overlap bound give a
dimension-independent Lipschitz estimate. A fixed-temperature limit therefore
transports to convergent temperature sequences, including sequences approaching
a static endpoint from above.
-/
namespace SlowEquilibration.SphericalModel
noncomputable section
open MeasureTheory ProbabilityTheory Set Filter
open scoped Topology BigOperators
set_option autoImplicit false
set_option maxHeartbeats 600000
set_option backward.isDefEq.respectTransparency false
/-- Nonnegative tensor coefficients control the absolute covariance at every
signed spherical overlap; no parity condition is needed. -/
theorem abs_covariancePolynomial_le_at_one {P : ℕ} (c : Degree P → ℝ)
    (hc : ∀ p, 0 ≤ c p) {r : ℝ} (hr : |r| ≤ 1) :
    |covariancePolynomial c r| ≤ covariancePolynomial c 1 := by
  unfold covariancePolynomial
  calc
    |∑ p, c p * r ^ (p : ℕ)| ≤ ∑ p, |c p * r ^ (p : ℕ)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ p, c p * 1 ^ (p : ℕ) := by
      apply Finset.sum_le_sum
      intro p _
      rw [abs_mul, abs_of_nonneg (hc p), abs_pow, one_pow, mul_one]
      exact mul_le_of_le_one_right (hc p) (pow_le_one₀ (abs_nonneg _) hr)
end
end SlowEquilibration.SphericalModel
