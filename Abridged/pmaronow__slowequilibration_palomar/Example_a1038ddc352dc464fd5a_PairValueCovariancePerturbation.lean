-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
/-! Proper scalar-value conditional covariance, including pure mixtures.
No inverse of the singular pure value/radial score covariance is taken. -/
@[expose] public section
namespace SlowEquilibration.NormalizedPairObservations
noncomputable section
open Function MeasureTheory ProbabilityTheory SphericalModel SphericalGaussianJet WholeFieldRegression

open  PairObservationNormBounds SphericalTwoPointCovariance
open  SphericalSequentialRegression
open scoped RealInnerProductSpace
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 600000


set_option linter.unusedVariables false in
lemma value_gradient_cross_order {N P m : ℕ} (hN : 0 < N) (c : Degree P → ℝ)
    (hc : ∀ p,0 ≤ c p) {d : ℕ} (hdeg : ∀ p,c p≠0 → d ≤ p.val.val)
    (x y : Vector N) (hx : ‖x‖^2=(N:ℝ)) (f : Fin m → Vector N) (hf : Orthonormal ℝ f)
    (hr : |overlap x y| ≤ 1) 
    (h_SlowEquilibration_PairObservationNormBounds_abs_triple_le : ∀ {a b p L : ℝ}, |a| ≤ 1 → |b| ≤ 1 → |p| ≤ L → |a * b * p| ≤ L)
    (h_SlowEquilibration_PairObservationNormBounds_profileBound_pos : ∀ {P : ℕ} (c : SlowEquilibration.SphericalModel.Degree P → ℝ),
      0 < SlowEquilibration.PairObservationNormBounds.profileBound c)
    (h_SlowEquilibration_SphericalTwoPointCovariance_profile_order_common : ∀ {P : ℕ} (c : SlowEquilibration.SphericalModel.Degree P → ℝ) (d : ℕ),
      (∀ (p : SlowEquilibration.SphericalModel.Degree P), c p ≠ 0 → d ≤ (↑(↑p : Fin (P + 1)) : ℕ)) →
        ∀ {r : ℝ},
          |r| ≤ 1 →
            |SlowEquilibration.SphericalModel.covariancePolynomial c r| ≤
                SlowEquilibration.PairObservationNormBounds.profileBound c * |r| ^ d ∧
              |SlowEquilibration.SphericalGaussianJet.firstCovariance c r| ≤
                  SlowEquilibration.PairObservationNormBounds.profileBound c * |r| ^ (d - 1) ∧
                |SlowEquilibration.SphericalGaussianJet.secondCovariance c r| ≤
                    SlowEquilibration.PairObservationNormBounds.profileBound c * |r| ^ (d - 2) ∧
                  |SlowEquilibration.SphericalTwoPointCovariance.thirdCovariance c r| ≤
                    SlowEquilibration.PairObservationNormBounds.profileBound c * |r| ^ (d - 3))
    (h_SlowEquilibration_NormalizedPairObservations_frameSum_norm : ∀ {N m : ℕ} (e : Fin m → SlowEquilibration.SphericalModel.Vector N),
      Orthonormal ℝ e →
        ∀ (v : EuclideanSpace ℝ (Fin m)),
          ‖SlowEquilibration.NormalizedPairObservations.frameSum e v‖ = ‖v‖)
    (h_SlowEquilibration_NormalizedPairObservations_value_gradient_cross_inner : ∀ {N P m : ℕ},
      0 < N →
        ∀ (c : SlowEquilibration.SphericalModel.Degree P → ℝ),
          (∀ (p : SlowEquilibration.SphericalModel.Degree P), 0 ≤ c p) →
            ∀ (x y : SlowEquilibration.SphericalModel.Vector N)
              (f : Fin m → SlowEquilibration.SphericalModel.Vector N) (u : ℝ)
              (v : EuclideanSpace ℝ (Fin m)),
              Inner.inner ℝ u
                  ((SlowEquilibration.NormalizedPairObservations.normalizedValue c x :
                      SlowEquilibration.SphericalModel.EuclideanDisorder N P → ℝ)
                    (((ContinuousLinearMap.adjoint :
                            (SlowEquilibration.SphericalModel.EuclideanDisorder N P →L[ℝ]
                                EuclideanSpace ℝ (Fin m)) →
                              EuclideanSpace ℝ (Fin m) →L[ℝ]
                                SlowEquilibration.SphericalModel.EuclideanDisorder N P)
                          (SlowEquilibration.WholeFieldRegression.gradientCLM c y f) :
                        EuclideanSpace ℝ (Fin m) →
                          SlowEquilibration.SphericalModel.EuclideanDisorder N P)
                      v)) =
                u *
                    SlowEquilibration.SphericalGaussianJet.firstCovariance c
                      (SlowEquilibration.SphericalModel.overlap x y) *
                  (Inner.inner ℝ x (SlowEquilibration.NormalizedPairObservations.frameSum f v) /
                    √(↑N : ℝ)))
    (h_SlowEquilibration_PairObservationNormBounds_normalized_inner_le_one : ∀ {N : ℕ},
      0 < N →
        ∀ (x : SlowEquilibration.SphericalModel.Vector N),
          ‖x‖ ^ 2 = (↑N : ℝ) →
            ∀ (V : SlowEquilibration.SphericalModel.Vector N),
              ‖V‖ ≤ 1 → |Inner.inner ℝ x V / √(↑N : ℝ)| ≤ 1)
    :
    ‖(normalizedValue c x).comp (gradientCLM c y f).adjoint‖ ≤ profileBound c*|overlap x y|^(d-1) := by
  apply ContinuousLinearMap.opNorm_le_of_re_inner_le (by positivity [h_SlowEquilibration_PairObservationNormBounds_profileBound_pos c])
  intro v u hv hu
  change inner ℝ (normalizedValue c x ((gradientCLM c y f).adjoint v)) u ≤ _
  rw [real_inner_comm,h_SlowEquilibration_NormalizedPairObservations_value_gradient_cross_inner hN c hc]
  have huc : |u| ≤ 1 := by simpa only [Real.norm_eq_abs] using hu.le
  have hV : ‖frameSum f v‖ ≤ 1 := by rw [h_SlowEquilibration_NormalizedPairObservations_frameSum_norm f hf,hv]
  have hi:=h_SlowEquilibration_PairObservationNormBounds_normalized_inner_le_one hN x hx (frameSum f v) hV
  have hp:=(h_SlowEquilibration_SphericalTwoPointCovariance_profile_order_common c d hdeg hr).2.1
  exact (le_abs_self _).trans (by simpa [mul_comm,mul_left_comm,mul_assoc] using h_SlowEquilibration_PairObservationNormBounds_abs_triple_le huc hi hp)
end
end SlowEquilibration.NormalizedPairObservations
