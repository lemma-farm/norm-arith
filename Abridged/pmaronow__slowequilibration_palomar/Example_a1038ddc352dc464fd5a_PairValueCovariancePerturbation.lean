-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vf17a84b65665.SphericalAging.FiniteModel ====
public section
set_option autoImplicit false
public section
/-!
# The actual ordered Gaussian tensor model

The disorder is the finite product of standard real Gaussian laws indexed by
all ordered p-tuples. No symmetrization is performed. The Hamiltonian has
exactly the normalization of Section 3. Its mean and covariance below are
proved by integration against this actual law, not postulated as model axioms.
-/
noncomputable section
namespace SphericalAging.FiniteModel
open MeasureTheory ProbabilityTheory
open scoped BigOperators InnerProductSpace
@[expose] abbrev Vector (N : ℕ) := EuclideanSpace ℝ (Fin N)
@[expose] abbrev TensorIndex (N p : ℕ) := Fin p → Fin N
@[expose] abbrev Disorder (N p : ℕ) := TensorIndex N p → ℝ

@[expose] def tensorMonomial {N p : ℕ} (x : Vector N) (I : TensorIndex N p) : ℝ :=
  ∏ k : Fin p, x (I k)
@[expose] def normalization (N p : ℕ) : ℝ :=
  (N : ℝ) ^ (-((p - 1 : ℕ) : ℝ) / 2)

end SphericalAging.FiniteModel

end
end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vf17a84b65665.SlowEquilibration.SphericalModel ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-!
# Actual finite mixed spherical Gaussian fields

The degree blocks are independent genuine ordered Gaussian tensors from the
immutable `all-lean` dependency. Degrees range from two through a fixed finite
maximum, with arbitrary nonnegative coefficients and no parity restriction.
The field is a finite linear combination of these tensors with the manuscript's
normalization. Its Gaussian finite-dimensional laws, smoothness, mean and
covariance are proved against that product disorder measure.

These are the field foundations of `lem:pre-field`. They do not construct a
Parisi minimizer or prove any slow-equilibration estimate.
-/
namespace SlowEquilibration.SphericalModel
noncomputable section
open MeasureTheory ProbabilityTheory
open scoped BigOperators InnerProductSpace
abbrev Vector (N : ℕ) := SphericalAging.FiniteModel.Vector N
/-- All allowed degrees in a finite mixture. Both odd and even degrees occur. -/
abbrev Degree (P : ℕ) := {p : Fin (P + 1) // 2 ≤ p.val}
/-- Each degree has its own ordered Gaussian tensor, including repeated indices. -/
abbrev Disorder (N P : ℕ) :=
  (p : Degree P) → SphericalAging.FiniteModel.Disorder N p.val.val

/-- The ordinary covariance polynomial of the finite degree family. -/
def covariancePolynomial {P : ℕ} (c : Degree P → ℝ) (r : ℝ) : ℝ :=
  ∑ p : Degree P, c p * r ^ p.val.val
/-- The manuscript's normalized overlap, defined on the ambient Euclidean space. -/
def overlap {N : ℕ} (x y : Vector N) : ℝ := inner ℝ x y / N

end
end SlowEquilibration.SphericalModel

end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vf17a84b65665.SphericalAging.GaussianIntegrationByParts ====
public section
set_option autoImplicit false
public section
/-!
# Gaussian integration by parts for the actual ordered tensor law

The one-dimensional identity is derived from the actual Gaussian density and
improper integration by parts. The finite product identity uses Fubini and a
measure-preserving separation of the selected tensor coordinate. The hypotheses
are differentiability and integrability, rather than a Stein-identity premise.
-/
noncomputable section
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
open Set MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
namespace SphericalAging.GaussianIntegrationByParts
open FiniteModel

section FiniteProduct
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

end FiniteProduct

/-- A single normalized ordered-tensor monomial, the coefficient of J_I in H_N. -/
@[expose] def hamiltonianCoefficient {N p : ℕ} (I : TensorIndex N p) (x : Vector N) : ℝ :=
  normalization N p*tensorMonomial x I

end SphericalAging.GaussianIntegrationByParts

end
end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vf17a84b65665.SphericalAging.HamiltonianDerivativeCovariance ====
public section
set_option autoImplicit false
public section
/-!
# Genuine cross-covariances of Hamiltonian derivatives

Every derivative is the actual iterated Fréchet derivative of the manuscript's
ordered Gaussian Hamiltonian. Their Gaussian laws and mixed covariance kernel
are proved by integration against the actual product disorder measure.
-/
noncomputable section
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set
open scoped InnerProductSpace BigOperators
namespace SphericalAging.HamiltonianDerivativeCovariance
open FiniteModel GaussianIntegrationByParts

/-- The genuine coefficient derivative in any ordered list of directions. -/
@[expose] def coefficientDerivative {N p : ℕ} (k : ℕ) (I : TensorIndex N p)
    (x : Vector N) (a : Fin k → Vector N) : ℝ :=
  iteratedFDeriv ℝ k (hamiltonianCoefficient I) x a

end SphericalAging.HamiltonianDerivativeCovariance

end
end
end

-- ==== Examples.pmaronow__slowequilibration_palomar.Dependencies.vf17a84b65665.SlowEquilibration.SphericalGaussianJet ====
public section
-- SPDX-License-Identifier: Apache-2.0
set_option autoImplicit false
@[expose] public section
/-!
# Genuine Gaussian spatial jets of the finite mixed field

Every variable below is an actual spatial derivative of the tensor Hamiltonian
constructed in `SphericalModel`, under its actual product disorder law.
The pure-block derivative coefficient and covariance identities are imported
from the pinned proof provider, then combined using independent degree blocks.
-/
namespace SlowEquilibration.SphericalGaussianJet
noncomputable section
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory
open SphericalModel
open scoped BigOperators InnerProductSpace NNReal
abbrev PureDisorder (N p : ℕ) := SphericalAging.FiniteModel.Disorder N p

def pureJetCLM (N p n : ℕ) (x : Vector N) (a : Fin n → Vector N) :
    PureDisorder N p →L[ℝ] ℝ :=
  ∑ I : SphericalAging.FiniteModel.TensorIndex N p,
    SphericalAging.HamiltonianDerivativeCovariance.coefficientDerivative n I x a •
      ContinuousLinearMap.proj I

def jetCLM {N P : ℕ} (c : Degree P → ℝ) (n : ℕ) (x : Vector N)
    (a : Fin n → Vector N) : Disorder N P →L[ℝ] ℝ :=
  ∑ p : Degree P, Real.sqrt (c p) •
    (pureJetCLM N p.val.val n x a).comp (ContinuousLinearMap.proj p)

/-- The ordinary second derivative covariance polynomial. -/
def secondCovariance {P : ℕ} (c : Degree P → ℝ) (r : ℝ) : ℝ :=
  ∑ p : Degree P, c p * (p.val.val : ℝ) * ((p.val.val : ℝ) - 1) * r ^ (p.val.val - 2)
def firstCovariance {P : ℕ} (c : Degree P → ℝ) (r : ℝ) : ℝ :=
  ∑ p : Degree P, c p * (p.val.val : ℝ) * r ^ (p.val.val - 1)

end
end SlowEquilibration.SphericalGaussianJet

end
end

