    (h_OAI_QuadraticInitialBound_quadratic_pair_summable : ∀ {α : Type u_1} (P : α → Ideal OAI.QuadraticInitialBound.O) [inst : ∀ (i : α), (P i).IsMaximal]
      (hg : ∀ (i : α), OAI.ActualEisensteinCubic.lambda ∉ P i) (S T : Finset α) (W : SchwartzMap ℝ ℂ)
      (M : ℝ),
      0 < M →
        Summable fun (z : OAI.QuadraticInitialBound.O) ↦
          Star.star (OAI.QuadraticInitialBound.quadraticRow P hg S z) *
              OAI.QuadraticInitialBound.quadraticRow P hg T z *
            (W : ℝ → ℂ)
              (‖(OAI.ConcreteTraceCRT.eisEmbedding : OAI.EisensteinEmbedding.O → ℂ) z‖ ^ 2 / M))
    (h_OAI_EisensteinSchwartzPoisson_scaledRadialTest_apply : ∀ (W : SchwartzMap ℝ ℂ) (K : ℝ) (hK : 0 < K) (z : ℂ),
      (OAI.EisensteinSchwartzPoisson.scaledRadialTest W K hK : ℂ → ℂ) z = (W : ℝ → ℂ) (‖z‖ ^ 2 / K))
    (h_OAI_QuadraticInitialBound_radial_weight_lattice_bound : ∀ (W : SchwartzMap ℝ ℂ) (M : ℝ),
      1 ≤ M →
        ∑' (z : OAI.QuadraticInitialBound.O),
            ‖(W : ℝ → ℂ)
                (‖(OAI.ConcreteTraceCRT.eisEmbedding : OAI.EisensteinEmbedding.O → ℂ) z‖ ^ 2 / M)‖ ≤
          OAI.QuadraticInitialBound.diagonalControl W * M)
    :
    ‖∑' z : O, (star (quadraticRow P hg S z) * quadraticRow P hg S z) *
        W (‖eisEmbedding z‖ ^ 2 / M)‖ ≤ diagonalControl W * M := by
  have hMp : 0 < M := by linarith
  have hs := (h_OAI_QuadraticInitialBound_quadratic_pair_summable P hg S S W M hMp).norm
