      (hg : ∀ (i : α), OAI.ActualEisensteinCubic.lambda ∉ P i) (S : Finset α)
      (z : OAI.QuadraticInitialBound.O), ‖OAI.QuadraticInitialBound.quadraticRow P hg S z‖ ≤ 1)
    (h_OAI_EisensteinSchwartzPoisson_actual_eisenstein_summable_norm : ∀ (f : SchwartzMap ℂ ℂ),
