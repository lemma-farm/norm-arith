/-!
# The actual ordered Gaussian tensor model

The disorder is the finite product of standard real Gaussian laws indexed by
all ordered p-tuples. No symmetrization is performed. The Hamiltonian has
exactly the normalization of Section 3. Its mean and covariance below are
proved by integration against this actual law, not postulated as model axioms.
-/
noncomputable section
namespace SphericalAging.FiniteModel
open MeasureTheory ProbabilityTheory
open scoped BigOperators InnerProductSpace
@[expose] abbrev Vector (N : ℕ) := EuclideanSpace ℝ (Fin N)

end SphericalAging.FiniteModel

end
end
end

-- ==== Examples.pmaronow__aging_palomar.Dependencies.v4f130364bf1b.SphericalAging.HamiltonianDerivativeCovariance ====
public section
set_option autoImplicit false
public section
/-!
# Genuine cross-covariances of Hamiltonian derivatives

Every derivative is the actual iterated Fréchet derivative of the manuscript's
ordered Gaussian Hamiltonian. Their Gaussian laws and mixed covariance kernel
are proved by integration against the actual product disorder measure.
-/
noncomputable section
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
open MeasureTheory ProbabilityTheory Set
open scoped InnerProductSpace BigOperators
namespace SphericalAging.HamiltonianDerivativeCovariance
open FiniteModel 
@[expose] def operatorTrace {N : ℕ} (U : Vector N →L[ℝ] Vector N) : ℝ :=
  LinearMap.trace ℝ (Vector N) U.toLinearMap
end SphericalAging.HamiltonianDerivativeCovariance

end
end
end

-- ==== Examples.pmaronow__aging_palomar.Examples.Example_b63d596263a83866f44b_EnergyCovarianceContraction ====
set_option autoImplicit false
public section
/-! Actual finite-N coefficient-gradient contractions in the energy
integration-by-parts identity, including the dimension-vanishing rank-one
correction. The covariance tensor is calculated from the real ordered
Hamiltonian; it is not a premise of any theorem. -/
noncomputable section
open MeasureTheory ProbabilityTheory Set
open scoped BigOperators InnerProductSpace
namespace SphericalAging.EnergyCovarianceContraction
open FiniteModel  
open HamiltonianDerivativeCovariance 
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false

lemma operatorTrace_abs_le {N : ℕ} (U : Vector N →L[ℝ] Vector N) :
    |operatorTrace U| ≤ (N : ℝ)*‖U‖ := by
  rw [operatorTrace,LinearMap.trace_eq_sum_inner U.toLinearMap (EuclideanSpace.basisFun (Fin N) ℝ)]
  calc
    _ ≤ ∑ i : Fin N, |inner ℝ (EuclideanSpace.basisFun (Fin N) ℝ i)
      (U (EuclideanSpace.basisFun (Fin N) ℝ i))| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _i : Fin N, ‖U‖ := by
      apply Finset.sum_le_sum
      intro i _
      have hn : ‖EuclideanSpace.basisFun (Fin N) ℝ i‖=1 :=
        (EuclideanSpace.basisFun (Fin N) ℝ).orthonormal.norm_eq_one i
      calc
        _ ≤ ‖EuclideanSpace.basisFun (Fin N) ℝ i‖*‖U (EuclideanSpace.basisFun (Fin N) ℝ i)‖ :=
          norm_inner_le_norm (𝕜 := ℝ) _ _
        _ ≤ ‖EuclideanSpace.basisFun (Fin N) ℝ i‖*(‖U‖*‖EuclideanSpace.basisFun (Fin N) ℝ i‖) := by
          exact mul_le_mul_of_nonneg_left (U.le_opNorm _) (norm_nonneg _)
        _ = _ := by rw [hn]; ring
    _ = _ := by simp

end SphericalAging.EnergyCovarianceContraction
