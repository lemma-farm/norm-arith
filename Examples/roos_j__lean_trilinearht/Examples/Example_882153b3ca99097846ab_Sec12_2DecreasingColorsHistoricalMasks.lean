  pos : Cell → V → ℕ
  X_top : ∀ I, ht I = 0 → X I = ∅
  le_par : ∀ I, AdmState.Le ⟨depth (par I), X (par I), pos (par I)⟩ ⟨depth I, X I, pos I⟩
  wf : ∀ I, AdmState.WF ⟨depth I, X I, pos I⟩
