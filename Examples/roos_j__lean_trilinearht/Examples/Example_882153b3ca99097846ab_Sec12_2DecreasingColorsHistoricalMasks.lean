/-- The combined coefficient `a_{v,G} = Σ_I a_{v,G,I} 1_I` of the occurrences of `v` in `G`. -/
noncomputable def occCoef (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) (G : ι) (v : V) (y : ℝ) : ℂ :=
  ∑ I ∈ occ G v, (dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y
omit [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι] in
theorem norm_occCoef_le (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) {Mc : ℝ} (hc : ∀ G v I, ‖c G v I‖ ≤ Mc) {K₀ : ℕ}
    (hK : ∀ G v, (occ G v).card ≤ K₀) (G : ι) (v : V) (y : ℝ) :
    ‖occCoef Gd occ c G v y‖ ≤ K₀ * Mc := by
  classical
  have hMc : 0 ≤ Mc := (norm_nonneg _).trans (hc G v (0, 0))
  refine (norm_sum_le _ _).trans ?_
  calc ∑ I ∈ occ G v, ‖(dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y‖
      ≤ ∑ _I ∈ occ G v, Mc := Finset.sum_le_sum fun I _ => by
        by_cases hy : y ∈ dyadicGridCell Gd I.1 I.2
        · rw [Set.indicator_of_mem hy]; exact hc G v I
        · rw [Set.indicator_of_notMem hy, norm_zero]; exact hMc
    _ = (occ G v).card * Mc := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ K₀ * Mc := by gcongr; exact_mod_cast hK G v
end WholeRanges
