    (hPbc : ∀ I ∈ cells, ∀ v, ‖Pb.coef I Zb v‖ ≤ Dc) (hcga : ∀ I m, ‖cga I m‖ ≤ 1)
    (hcgb : ∀ I m, ‖cgb I m‖ ≤ 1)
    (Ya Yb : ℤ × ℤ → ℝ → ℂ) (hYam : ∀ I, Measurable (Ya I)) (hYbm : ∀ I, Measurable (Yb I))
