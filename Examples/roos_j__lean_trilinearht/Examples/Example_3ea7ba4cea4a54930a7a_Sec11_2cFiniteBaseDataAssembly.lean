  intro l
  rcases fin_four_cover hia.symm hka.symm hab hik hib hkb l with h | h | h | h <;> rw [h]
  · obtain ⟨P₁, P₂, h₁, h₂, c₁, c₂, e₁, e₂, hP⟩ := hra
