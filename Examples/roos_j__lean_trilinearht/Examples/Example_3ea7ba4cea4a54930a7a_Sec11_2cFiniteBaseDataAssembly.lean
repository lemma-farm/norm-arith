    (hrb : ∃ P₁ P₂ : BasicProjection G R' CF, P₁.Ψ.D.budget ≤ X ∧ P₂.Ψ.D.budget ≤ X ∧
      P₁.HasChartsOn {I | I ∈ cells ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G R'.1 R'.2} c₀'
        H' ∧
      P₂.HasChartsOn {I | I ∈ cells ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G R'.1 R'.2} c₀'
        H' ∧
