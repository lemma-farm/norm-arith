/-- The number of changes of the color data of `v` along the last `n` ancestors of `I`. -/
noncomputable def chgN : ℕ → T.Cell → V → ℕ
  | 0, _, _ => 0
  | n + 1, I, v => chgN n (T.par I) v +
      if v ∈ T.X (T.par I) ∧ K.colorData (T.st (T.par I)) v ≠ K.colorData (T.st I) v then 1 else 0
/-- The number of changes of the color data of `v` along the whole ancestor path of `I`. -/
noncomputable def changes (I : T.Cell) (v : V) : ℕ := K.chgN T (T.ht I) I v
