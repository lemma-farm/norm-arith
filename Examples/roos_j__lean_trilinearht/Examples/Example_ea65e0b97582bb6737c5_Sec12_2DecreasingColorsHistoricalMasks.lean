open Classical in
/-- The first marked round, its winner and its top score. -/
noncomputable def sigData {n : ℕ} (σ : Fin n → (V → Prop) × ℤ) : Option (Fin n × V × ℤ) :=
  if h : ∃ ρ, ∃ z, (σ ρ).1 z then
