theorem profTerm_le_add (ρ : Fin K.d0) (s : ℤ) (w a b : V) {δ : ℕ} (hab : K.dist.d s a b = δ) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s w b + (δ : ℤ) := by
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have htri := K.dist.triangle s w a b
    have h2 : K.dist.d s w b ≠ ⊤ := by
      intro h; rw [h, hab] at htri
      exact h1 (by simpa using htri)
    simp only [h1, h2, ite_false]
    rw [hab] at htri
    have : (K.dist.d s w b).toNat ≤ (K.dist.d s w a).toNat + δ := by
      have := ENat.toNat_le_toNat htri (by simp [h1])
      simpa [ENat.toNat_add h1 (ENat.natCast_ne_top δ)] using this
    rw [← WithBot.coe_add]
    exact WithBot.coe_le_coe.mpr (by omega)
/-- Profiles are `1`-Lipschitz in the vertex for the graph distance at the same depth. -/
theorem prof_le_add (ρ : Fin K.d0) (z : V) (W : Finset V) (s : ℤ) {a b : V} {δ : ℕ}
