/-- The pseudometrics decrease in `l` (blueprint line 1738). -/
theorem lowMet_succ_le (ρ : Fin K.d0) (g : ℤ) (z : V) (W : Finset V) {l : ℕ}
    (hl : l + 1 ≤ 2 * K.d0) (a b : V) :
    K.lowMet ρ g z W (l + 1) a b ≤ K.lowMet ρ g z W l a b := by
  have hT : K.Tl g l ≤ K.Tl g (l + 1) := by
    unfold Tl
    have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
    have : (l : ℝ) * K.b1 / (2 * K.d0) ≤ ((l + 1 : ℕ) : ℝ) * K.b1 / (2 * K.d0) := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      push_cast; nlinarith
    linarith
  have hT' := K.Tl_le_Ul g hl
  apply K.lowMet_le_of
  intro s'
  refine le_trans ?_ (K.clipDiff_le_lowMet ρ g z W (by omega) a b s')
  unfold clipDiff
  rw [clipW_succ hT hT', clipW_succ hT hT' (K.prof ρ z W b s')]
  refine (abs_min_sub_min_le_max _ _ _ _).trans (max_le (by simp) ?_)
  exact (abs_max_sub_max_le_max _ _ _ _).trans (max_le (by simp [abs_nonneg]) le_rfl)
end ColorSetup
