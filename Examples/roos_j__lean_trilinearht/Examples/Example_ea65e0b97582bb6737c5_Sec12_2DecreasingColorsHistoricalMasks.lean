/-- One term of a profile. -/
noncomputable def profTerm (ρ : Fin K.d0) (s' : ℤ) (w a : V) : WithBot ℤ :=
  if K.dist.d s' w a = ⊤ then ⊥ else
    (((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ) : ℤ)
theorem prof_eq (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) (s' : ℤ) :
    K.prof ρ z W a s' = (W.erase z).sup (fun w => K.profTerm ρ s' w a) := rfl
omit [DecidableEq V] in
theorem profTerm_mono (ρ : Fin K.d0) {s s' : ℤ} (h : s ≤ s') (w a : V) :
    K.profTerm ρ s w a ≤ K.profTerm ρ s' w a := by
  have hd := K.dist.anti h w a
  unfold profTerm
  by_cases h1 : K.dist.d s w a = ⊤
  · simp [h1]
  · have h2 : K.dist.d s' w a ≠ ⊤ := ne_top_of_le_ne_top h1 hd
    simp only [h1, h2, ite_false]
    have : (K.dist.d s' w a).toNat ≤ (K.dist.d s w a).toNat := ENat.toNat_le_toNat hd h1
    exact_mod_cast (by omega : ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s w a).toNat : ℤ) ≤
      ((K.b1 * K.Dp ρ w : ℕ) : ℤ) - ((K.dist.d s' w a).toNat : ℤ))
/-- Profiles increase with depth. -/
theorem prof_mono (ρ : Fin K.d0) (z : V) (W : Finset V) (a : V) {s s' : ℤ} (h : s ≤ s') :
    K.prof ρ z W a s ≤ K.prof ρ z W a s' :=
  Finset.sup_mono_fun fun w _ => K.profTerm_mono ρ h w a
