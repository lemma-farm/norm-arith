/-! ### Historical masks (blueprint lines 1748-1771) -/
/-- `I₀` is an ancestor of `I` (or `I` itself). -/
def Anc (I₀ I : T.Cell) : Prop := ∃ n : ℕ, T.par^[n] I = I₀
theorem anc_le {I₀ I : T.Cell} (h : T.Anc I₀ I) : (T.st I₀).Le (T.st I) := by
  obtain ⟨n, rfl⟩ := h
  induction n generalizing I with
  | zero => exact AdmState.Le.refl _
  | succ n ih =>
    rw [Function.iterate_succ_apply]
    exact (ih (I := T.par I)).trans (T.st_le_par I)
end AdmTree
/-- The numerical relations of blueprint lines 1714-1717 used by the masks:
`b₂ = 100 (H_max + 1)`, `b₁ = d₀^{10} b₂ (H_max + 1)` and `d₀ ≥ 8` (the blueprint has `d₀ ≥ 1000
    log 2`). -/
structure ColorParams {V : Type*} (K : ColorSetup V) (Hmax : ℕ) : Prop where
  hb2 : K.b2 = 100 * (Hmax + 1)
  hb1 : K.b1 = K.d0 ^ 10 * K.b2 * (Hmax + 1)
  hd0 : 8 ≤ K.d0
