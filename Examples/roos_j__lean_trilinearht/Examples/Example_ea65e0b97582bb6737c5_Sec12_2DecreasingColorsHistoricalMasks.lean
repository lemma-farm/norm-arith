theorem roundTop_psc_mem {A : AdmState V} {v : V} (hv : v ∈ A.X) (ρ : Fin K.d0) :
    0 ≤ roundTop A.X (K.psc A.s ρ v) ∧ roundTop A.X (K.psc A.s ρ v) ≤ K.d0 := by
  refine ⟨?_, roundTop_le ⟨v, hv⟩ fun z _ => ?_⟩
