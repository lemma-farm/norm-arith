theorem Tl_ge (g : ℤ) (l : ℕ) : ((g - 3) * K.b1 : ℝ) ≤ K.Tl g l := by
  unfold Tl
  have : (0 : ℝ) ≤ l * K.b1 / (2 * K.d0) := by positivity
  linarith
theorem colorData_eq_some {A : AdmState V} {v : V} {ρ : Fin K.d0} {z : V} {g : ℤ} {m : ℕ}
    {ls : ℕ × ℕ} {hd : Option (Fin K.d0 × V × ℤ)}
    (h : K.colorData A v = (some (ρ, z, g), m, ls, hd)) :
    K.prim A v = some (ρ, z, g) ∧ m = admLevel A z ∧
    ls = K.ballSel (K.ballVec ρ g z (admFrozen A z) A.X v) ∧
    hd = sigData (roundSig A.X (fun ρ' => K.hsc ρ g z (admFrozen A z) ls.1 v ρ')) := by
  unfold colorData at h
  cases hc : K.prim A v with
  | none => rw [hc] at h; simp at h
  | some t =>
    obtain ⟨ρ₀, z₀, g₀⟩ := t
    rw [hc] at h
    simp only [Prod.mk.injEq, Option.some.injEq] at h
    obtain ⟨⟨rfl, rfl, rfl⟩, rfl, rfl, rfl⟩ := h
    exact ⟨rfl, rfl, rfl, rfl⟩
omit [DecidableEq V] in
theorem ballSel_spec {vec : ℕ → ℕ} {l n : ℕ} (h : K.ballSel vec = (l, n)) (hl : 1 ≤ l) :
    l < K.d0 ∧ vec l = n ∧ vec (l + 1) = n := by
  classical
  unfold ballSel at h
  split_ifs at h with hex
  · simp only [Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    exact ⟨(Nat.find_spec hex).2.1, rfl, (Nat.find_spec hex).2.2.symm⟩
  · simp only [Prod.mk.injEq] at h; omega
def MaskPred (c : Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ))
    (W : Finset V) (v₀ : V) (s : ℤ) (b : V) (h : ℕ) : Prop :=
  ∃ ρ z g m l n ρ' a g₂, c = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)) ∧ 1 ≤ l ∧
    (∃ k : ℕ, K.dist.d s z b = k ∧ (g - 1) * K.b1 - h ≤ K.b1 * K.Dp ρ z - k) ∧
    K.lowMet ρ g z W (l + 1) b v₀ ≤ h ∧ K.lowMet ρ g z W l b v₀ ≤ 10 * K.Rl l * h
variable (T : AdmTree V)
/-- The group of a central vertex: its color and complete color data (winners, levels and
rounds; the frozen prefix and cohort block are determined by these along a path). -/
noncomputable def grp (Nv : ℕ) (I : T.Cell) (v : V) :
    ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)) :=
  (K.color T Nv I v, K.colorData (T.st I) v)
/-- The mask `M_{G,h}` at a cell (blueprint eq:ball-mask): present vertices satisfying the mask
predicate for some historical central vertex of the group at or above the cell. -/
def mask (Nv : ℕ) (G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ)))
    (h : ℕ) (I : T.Cell) : Set V :=
  {b | b ∈ T.X I ∧ ∃ I₀, T.Anc I₀ I ∧ ∃ v₀ ∈ T.X I₀, K.grp T Nv I₀ v₀ = G ∧
    K.MaskPred (K.colorData (T.st I₀) v₀) (admFrozen (T.st I₀) (Option.elim
      (K.colorData (T.st I₀) v₀).1 v₀ (fun t => t.2.1))) v₀ (T.depth I) b h}
omit [DecidableEq V] in
theorem Rl_ge_one {Hmax : ℕ} (hP : ColorParams K Hmax) {l : ℕ} (hl : 1 ≤ l) : 1 ≤ K.Rl l := by
  unfold Rl
  have h1 : (1 : ℝ) ≤ l := by exact_mod_cast hl
  have h2 : (1 : ℝ) ≤ K.b2 := by rw [hP.hb2]; push_cast; nlinarith
  have h3 : (1 : ℝ) ≤ K.d0 + 1 := by have : (0 : ℝ) ≤ K.d0 := Nat.cast_nonneg _; linarith
  have : (1 : ℝ) ≤ l * (K.d0 + 1) := by nlinarith
  nlinarith
end ColorSetup
