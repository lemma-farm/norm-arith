/-- The numerical inequalities of blueprint lines 1763-1765:
`A_h + 1 ≤ T_{l+1} - T_l` with `A_h = 10 R_l h + 2 R_l`. -/
theorem pad_gap {Hmax : ℕ} (hP : ColorParams K Hmax) {l : ℕ} (hl : l ≤ K.d0) {h : ℕ}
    (hh : h ≤ Hmax) : 10 * K.Rl l * h + 2 * K.Rl l + 1 ≤ (K.b1 : ℝ) / (2 * K.d0) := by
  have hd : (8 : ℝ) ≤ K.d0 := by exact_mod_cast hP.hd0
  have hb2 : (K.b2 : ℝ) = 100 * (Hmax + 1) := by rw [hP.hb2]; push_cast; ring
  have hb1 : (K.b1 : ℝ) = K.d0 ^ 10 * K.b2 * (Hmax + 1) := by rw [hP.hb1]; push_cast; ring
  have hlr : (l : ℝ) ≤ K.d0 := by exact_mod_cast hl
  have hhr : (h : ℝ) ≤ Hmax := by exact_mod_cast hh
  have hH : (0 : ℝ) ≤ Hmax := Nat.cast_nonneg _
  have hl0 : (0 : ℝ) ≤ l := Nat.cast_nonneg _
  have hR : K.Rl l ≤ 10 * K.d0 * (K.d0 + 1) * K.b2 := by
    unfold Rl
    have : (0 : ℝ) ≤ (K.d0 + 1) * K.b2 := by positivity
    nlinarith only [hlr, this]
  have hR0 : 0 ≤ K.Rl l := by unfold Rl; positivity
  have hd0 : (0 : ℝ) < 2 * K.d0 := by linarith
  rw [le_div_iff₀ hd0]
  set B := (K.b2 : ℝ)
  set H := (Hmax : ℝ)
  set d := (K.d0 : ℝ)
  have hB : 100 ≤ B := by rw [hb2]; nlinarith
  have step1 : 10 * K.Rl l * h + 2 * K.Rl l + 1 ≤ 10 * (10 * d * (d + 1) * B) * (H + 1) + 1 := by
    have : 10 * K.Rl l * h + 2 * K.Rl l ≤ 10 * K.Rl l * (H + 1) := by nlinarith only [hR0, hhr]
    have : 10 * K.Rl l * (H + 1) ≤ 10 * (10 * d * (d + 1) * B) * (H + 1) := by gcongr
    linarith
  have step2 : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) ≤
      d ^ 10 * B * (H + 1) := by
    have hd2 : d ^ 10 = d ^ 3 * d ^ 7 := by ring
    have h87 : (8 : ℝ) ^ 7 ≤ d ^ 7 := pow_le_pow_left₀ (by norm_num) hd 7
    have hBH : 1 ≤ B * (H + 1) := by nlinarith only [hhr, hb2]
    set P := B * (H + 1) with hPdef
    have e1 : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) =
        200 * d ^ 3 * P + 200 * d ^ 2 * P + 2 * d := by rw [hPdef]; ring
    have e2 : 200 * d ^ 2 * P ≤ 25 * d ^ 3 * P := by
      have : (0 : ℝ) ≤ d ^ 2 * P := by positivity
      nlinarith only [hd, this]
    have e3 : 2 * d ≤ 2 * d ^ 3 * P := by
      have : 1 ≤ d ^ 2 := by nlinarith only [hd]
      have : d ≤ d ^ 3 := by nlinarith only [hR0, hd, hR, hB]
      nlinarith only [hd, hBH, e2]
    have : (10 * (10 * d * (d + 1) * B) * (H + 1) + 1) * (2 * d) ≤
        (227 * d ^ 3) * P := by rw [e1]; nlinarith only [hd, hBH, e2]
    have : (227 * d ^ 3) * P ≤ d ^ 3 * d ^ 7 * P := by
      have : (0 : ℝ) ≤ d ^ 3 * P := by positivity
      nlinarith only [hb1, h87]
    rw [hd2]; nlinarith only [hd, h87, e2, e3]
  rw [hb1]
  nlinarith only [hd, step1, step2]
theorem grp_colorData {Nv : ℕ} {I₀ I : T.Cell} {v₀ v : V}
    (h : K.grp T Nv I₀ v₀ = K.grp T Nv I v) :
    K.colorData (T.st I₀) v₀ = K.colorData (T.st I) v := congrArg Prod.snd h
/-- Unpacking a mask membership for the group of a successful center. -/
theorem mask_unpack {Nv : ℕ} {I : T.Cell} {v : V} {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ}
    {ρ' : Fin K.d0} {a : V} {g₂ : ℤ}
    (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂))) {h : ℕ}
    {J : T.Cell} {b : V} (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h J) :
    ∃ I₀, T.Anc I₀ J ∧ ∃ v₀ ∈ T.X I₀, K.colorData (T.st I₀) v₀ = K.colorData (T.st I) v ∧
      K.grp T Nv I₀ v₀ = K.grp T Nv I v ∧
      (∃ k : ℕ, K.dist.d (T.depth J) z b = k ∧ (g - 1) * K.b1 - h ≤ K.b1 * K.Dp ρ z - k) ∧
      K.lowMet ρ g z (admFrozen (T.st I₀) z) (l + 1) b v₀ ≤ h ∧
      K.lowMet ρ g z (admFrozen (T.st I₀) z) l b v₀ ≤ 10 * K.Rl l * h := by
  obtain ⟨-, I₀, hI₀, v₀, hv₀, hgrp, hpred⟩ := hb
  have he := K.grp_colorData T hgrp
  refine ⟨I₀, hI₀, v₀, hv₀, he, hgrp, ?_⟩
  obtain ⟨ρ₁, z₁, g₁, m₁, l₁, n₁, ρ₁', a₁, g₁', hc₁, -, hP1, hP2, hP3⟩ := hpred
  rw [he, hc] at hc₁
  simp only [Prod.mk.injEq, Option.some.injEq] at hc₁
  obtain ⟨⟨rfl, rfl, rfl⟩, rfl, ⟨rfl, rfl⟩, rfl, rfl, rfl⟩ := hc₁
  rw [he, hc] at hP2 hP3
  exact ⟨hP1, hP2, hP3⟩
theorem clip_center_eq {A : AdmState V} {v : V} (hv : v ∈ A.X) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hp : K.prim A v = some (ρ, z, g)) {l : ℕ} (hl : l ≤ 2 * K.d0) {s' : ℤ} (hs : s' ≤ A.s) :
    clipW (K.Tl g l) (K.Ul g) (K.prof ρ z (admFrozen A z) v s') = K.Tl g l := by
  have hW : admFrozen A z ⊆ A.X := Finset.filter_subset _ _
  apply clipW_eq_low (K.Tl_le_Ul g hl) (K.prof_center_le hv hp hW hs)
  have := K.Tl_ge g l
  have hb : (0 : ℝ) ≤ K.b1 := Nat.cast_nonneg _
  push_cast; nlinarith
/-- `eq:rival-bound` (blueprint lines 1763-1766): at an actual use centered at `v`, every vertex
of the pad-`h` mask has rival profile at most `T_l + A_h`, `A_h = 10 R_l h + 2 R_l`, at all
depths up to the use. -/
theorem rival_bound {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ} {ρ' : Fin K.d0} {a : V}
    {g₂ : ℤ} (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)))
    (hl : 1 ≤ l) {h : ℕ} (hh : h ≤ Hmax) {b : V} (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h I)
    {s' : ℤ} (hs : s' ≤ T.depth I) :
    ∀ x : ℤ, K.prof ρ z (admFrozen (T.st I) z) b s' = x →
      (x : ℝ) ≤ K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) := by
  obtain ⟨hp, -, hls, -⟩ := K.colorData_eq_some hc
  have hld := (K.ballSel_spec hls.symm hl).1
  obtain ⟨I₀, hI₀, v₀, hv₀, he, -, -, -, hP3⟩ := K.mask_unpack T hc hb
  obtain ⟨hW, hcl⟩ := K.center_close hP (T.st_wf I₀) (T.st_wf I) (T.anc_le hI₀) hv₀ hv he hc hl
  rw [hW] at hP3
  have hl2 : l ≤ 2 * K.d0 := by omega
  have hbv := K.lowMet_triangle ρ g z (admFrozen (T.st I) z) hl2 b v₀ v
  have hdiff := K.clipDiff_le_lowMet ρ g z (admFrozen (T.st I) z) hl2 b v s'
  have hcv := K.clip_center_eq (A := T.st I) hv hp hl2 hs
  unfold clipDiff at hdiff
  rw [hcv] at hdiff
  have hup : clipW (K.Tl g l) (K.Ul g) (K.prof ρ z (admFrozen (T.st I) z) b s') ≤
      K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) := by
    have := (abs_le.mp (hdiff.trans (hbv.trans (add_le_add hP3 hcl)))).2
    linarith
  apply val_le_of_clipW _ hup
  have hgap := K.pad_gap hP (l := l) (by omega) hh
  have hTU := K.Tl_le_Ul g (l := l + 1) (by omega)
  rw [K.Tl_succ] at hTU
  linarith
/-- Blueprint lem:masks, second assertion (neighbor closure): at an actual use, every present
neighbor of a vertex of `M_{G,h}` belongs to `M_{G,h+1}` when `h < H_max`. -/
theorem mask_neighbor {Hmax : ℕ} (hP : ColorParams K Hmax) (Nv : ℕ) {I : T.Cell} {v : V}
    (hv : v ∈ T.X I) {ρ : Fin K.d0} {z : V} {g : ℤ} {m l n : ℕ} {ρ' : Fin K.d0} {a : V}
    {g₂ : ℤ} (hc : K.colorData (T.st I) v = (some (ρ, z, g), m, (l, n), some (ρ', a, g₂)))
    (hl : 1 ≤ l) {h : ℕ} (hh : h < Hmax) {b b' : V}
    (hb : b ∈ K.mask T Nv (K.grp T Nv I v) h I) (hb' : b' ∈ T.X I) {δ : ℕ}
    (hbb : K.dist.d (T.depth I) b b' = δ) (hδ : δ ≤ 1) :
    b' ∈ K.mask T Nv (K.grp T Nv I v) (h + 1) I := by
  obtain ⟨hp, -, hls, -⟩ := K.colorData_eq_some hc
  have hld := (K.ballSel_spec hls.symm hl).1
  have hrival := K.rival_bound T hP Nv hv hc hl hh.le hb (le_refl (T.depth I))
  obtain ⟨I₀, hI₀, v₀, hv₀, he, hgrp, ⟨k, hk, hkg⟩, hP2, hP3⟩ := K.mask_unpack T hc hb
  obtain ⟨hW, hcl⟩ := K.center_close hP (T.st_wf I₀) (T.st_wf I) (T.anc_le hI₀) hv₀ hv he hc hl
  rw [hW] at hP2 hP3
  set W := admFrozen (T.st I) z
  set s := T.depth I
  have hl2 : l + 1 ≤ 2 * K.d0 := by omega
  have hR := K.Rl_ge_one hP hl
  have hgap := K.pad_gap hP (l := l) (by omega) hh.le
  have hTs := K.Tl_succ g l
  have hTU := K.Tl_le_Ul g hl2
  -- profile bound for the neighbor at earlier depths
  have hb'prof : ∀ s'' ≤ s, ∀ x : ℤ, K.prof ρ z W b' s'' = x →
      (x : ℝ) ≤ K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) + δ := by
    intro s'' hs'' x hx
    have h1 := K.prof_mono ρ z W b' hs''
    have hb'b : K.dist.d s b' b = δ := by rw [K.dist.symm]; exact hbb
    have h2 := h1.trans (K.prof_le_add ρ z W s hb'b)
    rw [hx] at h2
    cases hy : K.prof ρ z W b s with
    | bot => rw [hy] at h2; simp at h2
    | coe y =>
      rw [hy] at h2
      have : x ≤ y + δ := by exact_mod_cast h2
      have := hrival y hy
      have : (x : ℝ) ≤ y + δ := by exact_mod_cast (by omega : x ≤ y + δ)
      linarith
  -- distances at later depths
  have hlater : ∀ s'' , s ≤ s'' → ∃ δ' : ℕ, K.dist.d s'' b b' = δ' ∧ δ' ≤ δ := by
    intro s'' hs''
    have hle := K.dist.anti hs'' b b'
    rw [hbb] at hle
    refine ⟨(K.dist.d s'' b b').toNat,
      (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hle)).symm, ?_⟩
    have := ENat.toNat_le_toNat hle (by simp)
    simpa using this
  -- the context distance of the two neighbors in `d^{(l+1)}`
  have hbb' : K.lowMet ρ g z W (l + 1) b b' ≤ δ := by
    apply K.lowMet_le_of
    intro s''
    unfold clipDiff
    rcases le_total s'' s with hs'' | hs''
    · have e1 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b s'') = K.Tl g (l + 1) :=
        clipW_eq_of_val hTU fun x hx => by
          have := K.rival_bound T hP Nv hv hc hl hh.le hb hs'' x hx
          have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
          linarith
      have e2 : clipW (K.Tl g (l + 1)) (K.Ul g) (K.prof ρ z W b' s'') = K.Tl g (l + 1) :=
        clipW_eq_of_val hTU fun x hx => by
          have := hb'prof s'' hs'' x hx
          have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
          linarith
      rw [e1, e2]; simp
    · obtain ⟨δ', hδ', hδδ⟩ := hlater s'' hs''
      have hδ'' : K.dist.d s'' b' b = δ' := by rw [K.dist.symm]; exact hδ'
      exact (abs_clipW_sub_le_of hTU (K.prof_le_add ρ z W s'' hδ')
        (K.prof_le_add ρ z W s'' hδ'')).trans (by exact_mod_cast hδδ)
  refine ⟨hb', I₀, hI₀, v₀, hv₀, hgrp, ?_⟩
  rw [he, hc]
  simp only [Option.elim]
  rw [hW]
  refine ⟨ρ, z, g, m, l, n, ρ', a, g₂, rfl, hl, ?_, ?_, ?_⟩
  · -- the winner-score predicate
    have htri := K.dist.triangle s z b b'
    rw [hk, hbb] at htri
    obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d s z b' = k' :=
      ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) htri)).symm⟩
    rw [hk'] at htri
    have : k' ≤ k + δ := by exact_mod_cast htri
    refine ⟨k', hk', ?_⟩
    push_cast; omega
  · -- `d^{(l+1)}(b', v₀) ≤ h + 1`
    have t := K.lowMet_triangle ρ g z W hl2 b' b v₀
    rw [K.lowMet_symm ρ g z W (l + 1) b' b] at t
    have : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
    push_cast; linarith only [hP2, hbb', t, this]
  · -- `d^{(l)}(b', v₀) ≤ 10 R_l (h + 1)`
    apply K.lowMet_le_of
    intro s''
    have hl1 : l ≤ 2 * K.d0 := by omega
    have hTU' := K.Tl_le_Ul g hl1
    have hδr : (δ : ℝ) ≤ 1 := by exact_mod_cast hδ
    have hh0 : (0 : ℝ) ≤ h := Nat.cast_nonneg _
    rcases le_total s'' s with hs'' | hs''
    · -- both clipped values lie in `[T_l, T_l + A_h + 1]`
      have u1 : clipW (K.Tl g l) (K.Ul g) (K.prof ρ z W b' s'') ≤
          K.Tl g l + (10 * K.Rl l * h + 2 * K.Rl l) + δ :=
        clipW_le_of_le (by nlinarith only [hR]) (hb'prof s'' hs'')
      have l1 := (clipW_mem hTU' (K.prof ρ z W b' s'')).1
      have hd0 := K.clipDiff_le_lowMet ρ g z W hl1 v₀ v s''
      unfold clipDiff at hd0
      rw [K.clip_center_eq (A := T.st I) hv hp hl1 hs''] at hd0
      have u2 := (abs_le.mp (hd0.trans hcl)).2
      have l2 := (clipW_mem hTU' (K.prof ρ z W v₀ s'')).1
      unfold clipDiff
      rw [abs_le]; constructor <;> push_cast <;> nlinarith only [hR, l1, u2, hδr, u1, l2]
    · obtain ⟨δ', hδ', hδδ⟩ := hlater s'' hs''
      have hδ'' : K.dist.d s'' b' b = δ' := by rw [K.dist.symm]; exact hδ'
      have e1 : K.clipDiff ρ g z W l b' b s'' ≤ δ' :=
        abs_clipW_sub_le_of hTU' (K.prof_le_add ρ z W s'' hδ'') (K.prof_le_add ρ z W s'' hδ')
      have e2 := K.clipDiff_le_lowMet ρ g z W hl1 b v₀ s''
      have e3 : K.clipDiff ρ g z W l b' v₀ s'' ≤
          K.clipDiff ρ g z W l b' b s'' + K.clipDiff ρ g z W l b v₀ s'' := by
        unfold clipDiff; exact abs_sub_le _ _ _
      have : (δ' : ℝ) ≤ δ := by exact_mod_cast hδδ
      push_cast; nlinarith only [hP3, hR, hδr, e1, e2, e3, this]
