theorem groupOutput_none (φ : V → ℝ → ℂ) (ε : V → ℝ) (a : V → ℝ → ℂ) (y : ℝ) :
    groupOutput φ ε a y none = ∑ v, a v y * φ v y := by
  classical
  simp [groupOutput, privateColumnValue]
