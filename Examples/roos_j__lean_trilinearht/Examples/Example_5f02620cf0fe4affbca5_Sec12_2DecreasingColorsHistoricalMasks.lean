      ((Complex.measurable_re.comp ((Complex.continuous_conj.measurable.comp (hPm G)).mul
        (hPm G'))).aestronglyMeasurable)
      (C := (Fintype.card V * (M * M)) ^ 2) (fun y => ?_) hS hSfin
      (fun y hy => by simp [hsuppP G' y hy])
    refine (Complex.abs_re_le_norm _).trans ?_
    rw [norm_mul, Complex.norm_conj, sq]
    exact mul_le_mul (hPb G y) (hPb G' y) (norm_nonneg _) (by positivity)
  have hintC : ∀ G G' v w, Integrable (fun y =>
      starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((Complex.continuous_conj.measurable.comp ((ha_meas G v).mul (hφm v))).mul
        ((ha_meas G' w).mul (hφm w))).aestronglyMeasurable)
      (C := (M * M) * (M * M)) (fun y => ?_) hS hSfin
      (fun y hy => by simp [ha_supp G' w y hy])
    rw [norm_mul, Complex.norm_conj, norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul (ha_bd G v y) (hφb v y) (norm_nonneg _) hM0)
      (mul_le_mul (ha_bd G' w y) (hφb w y) (norm_nonneg _) hM0) (by positivity) (by positivity)
  have hintA : ∀ G G' v w, Integrable (fun y => ‖a G v y‖ * ‖a G' w y‖) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((ha_meas G v).norm.mul (ha_meas G' w).norm).aestronglyMeasurable)
      (C := M * M) (fun y => ?_) hS hSfin (fun y hy => by simp [ha_supp G' w y hy])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul (ha_bd G v y) (ha_bd G' w y) (norm_nonneg _) hM0
