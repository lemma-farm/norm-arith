theorem norm_sq_sum_of_disjoint (z : ι → ℂ) (h : ∀ G G', G ≠ G' → z G = 0 ∨ z G' = 0) :
    ‖∑ G, z G‖ ^ 2 = ∑ G, ‖z G‖ ^ 2 := by
  classical
  by_cases hz : ∃ G, z G ≠ 0
  · obtain ⟨G₀, hG₀⟩ := hz
    have hothers : ∀ G, G ≠ G₀ → z G = 0 := fun G hG =>
      (h G G₀ hG).resolve_right hG₀
    rw [Finset.sum_eq_single G₀ (fun G _ hG => hothers G hG) (by simp),
      Finset.sum_eq_single G₀ (fun G _ hG => by rw [hothers G hG, norm_zero]; ring) (by simp)]
  · push Not at hz
    simp [hz]
