/-- Cauchy–Schwarz over a support of at most `N` nonzero terms. -/
theorem sq_sum_le_of_support {κ : Type*} [Fintype κ] (x : κ → ℝ)
    {N : ℕ} (hN : (Finset.univ.filter (fun p => x p ≠ 0)).card ≤ N) :
    (∑ p, x p) ^ 2 ≤ N * ∑ p, x p ^ 2 := by
  set S := Finset.univ.filter (fun p => x p ≠ 0)
  have h1 : ∑ p, x p = ∑ p ∈ S, x p := by
    rw [Finset.sum_filter_ne_zero]
  have h2 : ∑ p ∈ S, x p ^ 2 ≤ ∑ p, x p ^ 2 :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun _ _ _ => sq_nonneg _)
  rw [h1]
  calc (∑ p ∈ S, x p) ^ 2 ≤ S.card * ∑ p ∈ S, x p ^ 2 := sq_sum_le_card_mul_sum_sq
    _ ≤ N * ∑ p, x p ^ 2 := by
        have hc : (S.card : ℝ) ≤ N := by exact_mod_cast hN
        exact mul_le_mul hc h2 (Finset.sum_nonneg fun _ _ => sq_nonneg _) (Nat.cast_nonneg _)
theorem integrable_of_bound_support {E : Type*} [NormedAddCommGroup E] {f : ℝ → E}
    (hf : AEStronglyMeasurable f volume) {C : ℝ} (hC : ∀ y, ‖f y‖ ≤ C) {S : Set ℝ}
    (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (hsupp : ∀ y, y ∉ S → f y = 0) :
    Integrable f := by
  have hg : Integrable (S.indicator (fun _ => C)) :=
    (integrableOn_const hSfin).integrable_indicator hS
  refine hg.mono' hf (Filter.Eventually.of_forall fun y => ?_)
  by_cases hy : y ∈ S
  · rw [Set.indicator_of_mem hy]; exact hC y
  · rw [Set.indicator_of_notMem hy, hsupp y hy, norm_zero]
