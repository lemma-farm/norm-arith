    (hC : 0 ≤ C) (hg : eLpNorm g 2 (normalizedIntervalMeasure a₀ r) ≤ ENNReal.ofReal C) :
    Real.sqrt (r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2) ≤ C := by
