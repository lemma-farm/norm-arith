    lt_of_le_of_lt hg ENNReal.ofReal_lt_top
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)] at hg
  have hX : 0 ≤ ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r :=
    integral_nonneg fun _ => by positivity
  have h := (ENNReal.ofReal_le_ofReal_iff hC).mp hg
  have heq : ∫ a, ‖g a‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a₀ r =
      r⁻¹ * ∫ y in Set.Ico a₀ (a₀ + r), ‖g y‖ ^ 2 := by
    rw [normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul,
      setIntegral_congr_set Ico_ae_eq_Icc.symm]
