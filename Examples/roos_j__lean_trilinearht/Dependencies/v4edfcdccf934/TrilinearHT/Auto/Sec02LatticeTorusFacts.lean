/-- Evaluation of an integer frequency at a torus point, before exponentiation. -/
noncomputable def torusEvaluation {d : ℕ} (x : StandardTorus d) :
    (Fin d → ℤ) →ₗ[ℤ] AddCircle (1 : ℝ) := (Pi.basisFun ℤ (Fin d)).constr ℤ x
