/-- The conclusion `eq:weyl-splitting` of `lem:weyl` (one time variable) for horizontal data `V`,
rational matrix `C` and quadratic `Λ`, with projection heights and sizes at most `B`. -/
def WeylSplitData (B : ℝ) {d : ℕ} (V : Matrix (Fin d) (Fin 1) ℝ) (C : Matrix (Fin d) (Fin d) ℚ)
    (Λ : Matrix (Fin 1) (Fin 1) ℝ) : Prop :=
  ∃ (U : Submodule ℝ (EuclideanSpace ℝ (Fin d))) (Q : Matrix (Fin d) (Fin d) ℚ),
    realMatrixOperator (Q.map (fun q => (q : ℝ))) = Uᗮ.starProjection ∧
    realMatrixOperator ((1 - Q).map (fun q => (q : ℝ))) = U.starProjection ∧
    (∀ x ∈ U, ∀ y ∈ U, inner ℝ y
      (realMatrixOperator ((C.map (fun q => (q : ℝ))) - (C.map (fun q => (q : ℝ))).transpose) x)
        = 0) ∧
    (∀ i j, (rationalHeight (Q i j) : ℝ) ≤ B) ∧
    (∀ i j, (rationalHeight ((1 - Q) i j) : ℝ) ≤ B) ∧
    ‖realMatrixOperator (Q.map (fun q => (q : ℝ)) * V)‖ ≤ B ∧
    ‖realMatrixOperator (effectiveReturnQuadratic (C.map (fun q => (q : ℝ))) Λ V
      ((1 - Q).map (fun q => (q : ℝ)) * V) (Q.map (fun q => (q : ℝ)) * V))‖ ≤ B
theorem WeylSplitData.mono {B B' : ℝ} {d : ℕ} {V : Matrix (Fin d) (Fin 1) ℝ}
    {C : Matrix (Fin d) (Fin d) ℚ} {Λ : Matrix (Fin 1) (Fin 1) ℝ} (h : WeylSplitData B V C Λ)
    (hB : B ≤ B') : WeylSplitData B' V C Λ := by
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ := h
  exact ⟨U, Q, h1, h2, h3, fun i j => (h4 i j).trans hB, fun i j => (h5 i j).trans hB,
    h6.trans hB, h7.trans hB⟩
