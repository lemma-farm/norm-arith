/-! ### The fits as admissible opponents -/
def IsAdaptiveFit (c₂ : ℕ) (B : ℝ) (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ)
    (w : ℤ × ℤ → ℝ × ℝ → ℂ) (j : Fin 4) (q : ℝ) (f : ℝ → ℂ) (k : ℕ) (M : ℕ)
    (roots : Finset (ℤ × ℤ)) (seg : ℤ × ℤ → ℤ × ℤ) (n : ℤ × ℤ → ℕ)
    (a : ℤ × ℤ → ℕ → ℝ → ℂ) (g : ℤ × ℤ → ℝ → ℂ) : Prop :=
  (M : ℝ) ≤ 17 * B ^ 2 ∧
  J ∈ roots ∧ roots ⊆ dyadicFiniteTree G J N ∧
  dyadicRootLength G roots ≤ 4 / 3 * dyadicGridLength G J.1 ∧
  ∀ I ∈ dyadicFiniteTree G J N,
    seg I ∈ roots ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (seg I).1 (seg I).2 ∧
    n I ≤ M ∧
    (∀ I' ∈ dyadicFiniteTree G J N, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G I'.1 I'.2 →
      dyadicGridCell G I'.1 I'.2 ⊆ dyadicGridCell G (seg I).1 (seg I).2 →
      seg I' = seg I ∧ n I' ≤ n I ∧ ∀ i < n I', a I' i = a I i) ∧
    (∀ i < n I, ∃ (d : ℕ) (Φ : QuadraticChartData d),
      QuadraticChartComplexity c₂ B Φ ∧ IsBoundedQuadraticChart Φ ∧
        a I i = quadraticChartAtom Φ) ∧
    (kernelHull G J N w I → ∃ coef : Fin M → ℂ, ∑ i, ‖coef i‖ ^ 2 ≤ 1 ∧
      (∀ i : Fin M, n I ≤ i → coef i = 0) ∧ ∀ y, g I y = ∑ i, coef i * a I i y) ∧
    Measurable (g I) ∧ (kernelHull G J N w I → ∀ y, ‖g I y‖ ≤ Real.sqrt M) ∧
    (kernelHull G J N w I →
      ∫ y in dyadicGridCell G I.1 I.2, ‖g I y‖ ^ 2 ≤ dyadicGridLength G I.1) ∧
    FormSmall (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (w I) j q
      (fun y => f y - g I y) (Real.exp (-(k : ℝ)))
/-- The bilinear norm of the pair `(X, Y)` in slots `p ≠ p'` against normalized `L²` spectators is
at most `η` (blueprint §11.2, lines 1589-1596). -/
def PairSmall (a₀ r : ℝ) (w : ℝ × ℝ → ℂ) (p p' : Fin 4) (X Y : ℝ → ℂ) (η : ℝ) : Prop :=
  ∀ z : Fin 4 → ℝ → ℂ, (∀ l, Measurable (z l)) →
    (∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≤ 1) →
    ‖localProgressionForm r w (slotPair z p p' X Y)‖ ≤ η
section PairForm
variable {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
  (hw : IsAdmissibleLocalKernel κ a₀ r w)
def SpectatorOK (a₀ r : ℝ) (z : Fin 4 → ℝ → ℂ) (p p' : Fin 4) : Prop :=
  (∀ l, Measurable (z l)) ∧
    ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤
/-- A function with finite normalized `L²` norm. -/
def FinL2 (a₀ r : ℝ) (X : ℝ → ℂ) : Prop :=
  Measurable X ∧ eLpNorm X 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤
theorem FinL2.sub {X Y : ℝ → ℂ} (hX : FinL2 a₀ r X) (hY : FinL2 a₀ r Y) : FinL2 a₀ r (X - Y) :=
  ⟨hX.1.sub hY.1, ((eLpNorm_sub_le (by norm_num)).trans_lt
    (ENNReal.add_lt_top.mpr ⟨hX.2.lt_top, hY.2.lt_top⟩)).ne⟩
theorem FinL2.zero : FinL2 a₀ r (0 : ℝ → ℂ) := ⟨measurable_const, by simp⟩
theorem FinL2.of_bound (hr : 0 < r) {X : ℝ → ℂ} (hX : Measurable X) {S : ℝ}
    (hS : ∀ y, ‖X y‖ ≤ S) : FinL2 a₀ r X :=
  ⟨hX, ne_top_of_le_ne_top ENNReal.ofReal_ne_top (eLpNorm_two_le_of_bound hr hX hS)⟩
end PairForm
/-! ### Cyclic updates at one cell -/
/-- The position updated at level `t` (cyclic order). -/
def stagPos (t : ℕ) : Fin 4 := ⟨t % 4, Nat.mod_lt _ (by norm_num)⟩
/-- The data of the cyclic updates at one cell: inputs normalized in `L^q`, and at each level
`t ≥ 1` a bounded projection of the input in position `t mod 4` with residual smallness
`e^{-k_t}`; the accuracies grow fast enough to dominate the supremum bounds. -/
structure StaggerCell (κ : LocalKernelClass) where
  a₀ : ℝ
  r : ℝ
  w : ℝ × ℝ → ℂ
  q : ℝ
  f : Fin 4 → ℝ → ℂ
  g : ℕ → ℝ → ℂ
  k : ℕ → ℝ
  S : ℕ → ℝ
  r_pos : 0 < r
  adm : IsAdmissibleLocalKernel κ a₀ r w
  two_le_q : 2 ≤ q
  f_meas : ∀ p, Measurable (f p)
  f_norm : ∀ p, eLpNorm (f p) (ENNReal.ofReal q) (normalizedIntervalMeasure a₀ r) ≤ 1
  g_meas : ∀ t, Measurable (g t)
  S_pos : ∀ t, 0 < S t
  g_bound : ∀ t y, ‖g t y‖ ≤ S t
  g_L2 : ∀ t, eLpNorm (g t) 2 (normalizedIntervalMeasure a₀ r) ≤ 1
  g_small : ∀ t, 1 ≤ t →
    FormSmall a₀ r w (stagPos t) q (f (stagPos t) - g t) (Real.exp (-k t))
  k_nonneg : ∀ t, 0 ≤ k t
  k_grow : ∀ v h, 1 ≤ v → v < h → 2 * k v ≤ k h
  S_le : ∀ v h, 1 ≤ v → v < h → S v ≤ Real.exp (k h / 2)
namespace StaggerCell
variable {κ : LocalKernelClass} (C : StaggerCell κ)
/-- The normalized measure of the cell. -/
noncomputable abbrev μ : Measure ℝ := normalizedIntervalMeasure C.a₀ C.r
/-- The local form. -/
noncomputable abbrev H (F : Fin 4 → ℝ → ℂ) : ℂ := localProgressionForm C.r C.w F
def tv (s : Fin 4) : Option ℕ → ℝ → ℂ
  | none => C.f s
  | some ℓ => C.g ℓ
def Valid (s : Fin 4) (m : ℕ) (A : Option ℕ) : Prop :=
  ∀ ℓ, A = some ℓ → 1 ≤ ℓ ∧ stagPos ℓ = s ∧ m ≤ ℓ
/-- Normalized spectators for the slots `p, p'`. -/
def Spect (z : Fin 4 → ℝ → ℂ) (p p' : Fin 4) : Prop :=
  (∀ l, Measurable (z l)) ∧ ∀ l, l ≠ p → l ≠ p' → eLpNorm (z l) 2 C.μ ≤ 1
theorem Spect.ok {C : StaggerCell κ} {z : Fin 4 → ℝ → ℂ} {p p' : Fin 4} (h : C.Spect z p p') :
    SpectatorOK C.a₀ C.r z p p' :=
  ⟨h.1, fun l h1 h2 => ne_top_of_le_ne_top ENNReal.one_ne_top (h.2 l h1 h2)⟩
def LateRep (l : Fin 4) (m : ℕ) (X : ℝ → ℂ) : Prop :=
  ∃ A₁ A₂ : Option ℕ, Valid l m A₁ ∧ Valid l m A₂ ∧ X = C.tv l A₁ - C.tv l A₂
theorem LateRep.mono {C : StaggerCell κ} {l : Fin 4} {m m' : ℕ} (hm : m' ≤ m) {X : ℝ → ℂ}
    (h : C.LateRep l m X) : C.LateRep l m' X := by
  obtain ⟨A₁, A₂, h₁, h₂, rfl⟩ := h
  exact ⟨A₁, A₂, fun ℓ hℓ => let ⟨a, b, c⟩ := h₁ ℓ hℓ; ⟨a, b, by omega⟩,
    fun ℓ hℓ => let ⟨a, b, c⟩ := h₂ ℓ hℓ; ⟨a, b, by omega⟩, rfl⟩
noncomputable def prevProj (t : ℕ) : ℝ → ℂ := if t ≤ 4 then 0 else C.g (t - 4)
/-- The increment at level `t`. -/
noncomputable def incr (t : ℕ) : ℝ → ℂ := C.g t - C.prevProj t
/-- The last update level of position `l` before level `t`. -/
def lastLevel (l : Fin 4) (t : ℕ) : ℕ := t - (t + 4 - l) % 4
noncomputable def lastProj (l : Fin 4) (t : ℕ) : ℝ → ℂ :=
  if 1 ≤ lastLevel l t then C.g (lastLevel l t) else 0
noncomputable def tail (τ : ℕ) : Fin 4 → ℝ → ℂ := fun p => C.f p - C.lastProj p τ
noncomputable def W (u τ : ℕ) : Fin 4 → ℝ → ℂ :=
  Function.update (C.tail τ) (stagPos u) (C.incr u)
end StaggerCell
/-! ### The accuracy schedule and the declaration `stagger` -/
theorem PairSmall.mono {a₀ r : ℝ} {w : ℝ × ℝ → ℂ} {p p' : Fin 4} {X Y : ℝ → ℂ} {η η' : ℝ}
    (h : PairSmall a₀ r w p p' X Y η) (hη : η ≤ η') : PairSmall a₀ r w p p' X Y η' :=
  fun z hz hz2 => (h z hz hz2).trans hη
end Auto
