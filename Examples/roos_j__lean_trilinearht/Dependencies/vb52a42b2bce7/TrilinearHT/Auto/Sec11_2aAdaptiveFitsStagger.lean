/-- The pointwise physical part of the fit projection: `∑ c_i a_i` over admissible atoms. -/
noncomputable def fitPhys (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) (y : ℝ) : ℂ :=
  ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then fitCoeff M s a n z i * a i y else 0
open scoped Classical in
theorem fitProj_coeFn (M : ℕ) {s : Set ℝ} (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∀ᵐ y ∂volume, y ∈ s → (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y =
      ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then
        fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 := by
  have hcol : ∀ i : Fin M, ∀ᵐ y ∂volume, y ∈ s →
      ((fitCoeff M s a n z i • fitColumn s (a i) i : ColumnL2 (Fin M)) :
        ℝ → ColumnHilbert (Fin M)) y = if FitAdmissible s (a i) then
          fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 := by
    intro i
    by_cases h : FitAdmissible s (a i)
    · filter_upwards [Lp.coeFn_smul (fitCoeff M s a n z i) (fitColumn s (a i) i),
        fitColumn_coeFn h i] with y h1 h2 hys
      rw [h1, Pi.smul_apply, h2, Set.indicator_of_mem hys]
      simp only [h, ↓reduceIte]
    · have h0 : fitColumn s (a i) i = 0 := by unfold fitColumn; simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
      rw [h0, smul_zero, hy]
      simp only [h, ↓reduceIte]; rfl
  have hall : ∀ᵐ y ∂volume, ∀ i ∈ fitLabels M n, y ∈ s →
      ((fitCoeff M s a n z i • fitColumn s (a i) i : ColumnL2 (Fin M)) :
        ℝ → ColumnHilbert (Fin M)) y = if FitAdmissible s (a i) then
          fitCoeff M s a n z i • fitColumnValue (a i) i y else 0 :=
    (Filter.eventually_all_finset _).mpr fun i _ => hcol i
  filter_upwards [hall, Lp.coeFn_fun_finsetSum (fitLabels M n)
    (fun i => fitCoeff M s a n z i • fitColumn s (a i) i)] with y hy hsum hys
  rw [fitCoeff_spec, hsum]
  exact Finset.sum_congr rfl fun i hi => hy i hi hys
open scoped Classical in
/-- The physical coordinate of the fit projection is `fitPhys` almost everywhere on the cell. -/
theorem fitProj_none (M : ℕ) {s : Set ℝ} (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∀ᵐ y ∂volume, y ∈ s →
      (fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y none = fitPhys M s a n z y := by
  filter_upwards [fitProj_coeFn M a n z] with y hy hys
  rw [hy hys, fitPhys]
  rw [columnHilbert_sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs
  · simp [fitColumnValue_none, smul_eq_mul]
  · rfl
