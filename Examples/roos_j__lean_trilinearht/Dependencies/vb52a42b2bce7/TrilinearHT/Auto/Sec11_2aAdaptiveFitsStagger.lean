  have hin := inner_fitColumn hφ (⟨n, hn⟩ : Fin M) (z - U.starProjection z) hfresh
  have hres : ∫ y in s, conj (φ y) * ((z - U.starProjection z : ColumnL2 (Fin M)) :
      ℝ → ColumnHilbert (Fin M)) y none = ∫ y in s, conj (φ y) * fitResid M s f a n y := by
    refine integral_congr_ae (ae_restrict_of_ae ?_)
    filter_upwards [Lp.coeFn_sub z (U.starProjection z),
      physicalColumnInput_coeFn (V := Fin M) f] with y h1 h3
    rw [h1, Pi.sub_apply, PiLp.sub_apply, h3]
    simp [fitResid, fitProj, hz, hU]
  rw [hres] at hin
  have hnorm := norm_fitColumn_sq_le hφ (⟨n, hn⟩ : Fin M)
  have hvol : 0 ≤ volume.real s := measureReal_nonneg
  have hg0 : 0 ≤ ‖inner ℂ (fitColumn s φ (⟨n, hn⟩ : Fin M)) (z - U.starProjection z)‖ ^ 2 /
      ‖fitColumn s φ (⟨n, hn⟩ : Fin M)‖ ^ 2 := by positivity
  by_cases hρ0 : ρ * volume.real s = 0
  · have h0 : ρ ^ 2 * volume.real s / 4 = 0 := by
      rw [show ρ ^ 2 * volume.real s / 4 = ρ * (ρ * volume.real s) / 4 by ring, hρ0]; simp
    rw [h0, add_zero]
    linarith [ge_iff_le.mp hgain]
  have hcp : 0 < ‖∫ y in s, conj (φ y) * fitResid M s f a n y‖ :=
    lt_of_lt_of_le (lt_of_le_of_ne (by positivity) (Ne.symm hρ0)) hcorr
  have hcol : fitColumn s φ (⟨n, hn⟩ : Fin M) ≠ 0 := by
    intro h0
    rw [h0, inner_zero_left] at hin
    rw [← hin, norm_zero] at hcp
    exact lt_irrefl _ hcp
  have hpos : 0 < ‖fitColumn s φ (⟨n, hn⟩ : Fin M)‖ := norm_pos_iff.mpr hcol
  refine le_trans ?_ (ge_iff_le.mp hgain)
  refine add_le_add le_rfl ?_
  rw [hin, le_div_iff₀ (by positivity)]
  have hc2 : (ρ * volume.real s) ^ 2 ≤ ‖∫ y in s, conj (φ y) * fitResid M s f a n y‖ ^ 2 :=
    pow_le_pow_left₀ (by positivity) hcorr 2
  have hmul := mul_le_mul_of_nonneg_left hnorm
    (by positivity : (0 : ℝ) ≤ ρ ^ 2 * volume.real s / 4)
  nlinarith only [hc2, hmul]
/-- A range inside the orthogonal sum of two ranges has at most their total projection energy. -/
theorem starProjection_energy_le_of_le_sup {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℂ E] [CompleteSpace E] {K U₁ U₂ : Submodule ℂ E}
    [FiniteDimensional ℂ K] [FiniteDimensional ℂ U₁] [FiniteDimensional ℂ U₂]
    (hK : K ≤ U₁ ⊔ U₂) (h12 : U₁ ⟂ U₂) (z : E) :
    ‖K.starProjection z‖ ^ 2 ≤ ‖U₁.starProjection z‖ ^ 2 + ‖U₂.starProjection z‖ ^ 2 := by
  set W := U₁ ⊔ U₂
  have hW : W.starProjection z = U₁.starProjection z + U₂.starProjection z := by
    refine Submodule.eq_starProjection_of_mem_of_inner_eq_zero (u := z)
      (Submodule.add_mem_sup (Submodule.starProjection_apply_mem U₁ z)
        (Submodule.starProjection_apply_mem U₂ z)) fun w hw => ?_
    obtain ⟨w₁, hw₁, w₂, hw₂, rfl⟩ := Submodule.mem_sup.mp hw
    have o1 : inner ℂ (z - U₁.starProjection z) w₁ = 0 :=
      Submodule.starProjection_inner_eq_zero z w₁ hw₁
    have o2 : inner ℂ (z - U₂.starProjection z) w₂ = 0 :=
      Submodule.starProjection_inner_eq_zero z w₂ hw₂
    have o3 : inner ℂ (U₂.starProjection z) w₁ = 0 :=
      h12.symm.inner_eq (Submodule.starProjection_apply_mem U₂ z) hw₁
    have o4 : inner ℂ (U₁.starProjection z) w₂ = 0 :=
      h12.inner_eq (Submodule.starProjection_apply_mem U₁ z) hw₂
    have e : z - (U₁.starProjection z + U₂.starProjection z) =
        (z - U₁.starProjection z) - U₂.starProjection z := by abel
    have e' : z - (U₁.starProjection z + U₂.starProjection z) =
        (z - U₂.starProjection z) - U₁.starProjection z := by abel
    have i1 : inner ℂ (z - (U₁.starProjection z + U₂.starProjection z)) w₁ = 0 := by
      rw [e, inner_sub_left, o1, o3, sub_zero]
    have i2 : inner ℂ (z - (U₁.starProjection z + U₂.starProjection z)) w₂ = 0 := by
      rw [e', inner_sub_left, o2, o4, sub_zero]
    rw [inner_add_right, i1, i2, add_zero]
  have horth : inner ℂ (U₁.starProjection z) (U₂.starProjection z) = 0 :=
    h12.inner_eq (Submodule.starProjection_apply_mem U₁ z) (Submodule.starProjection_apply_mem U₂ z)
  have hn : ‖W.starProjection z‖ ^ 2 = ‖U₁.starProjection z‖ ^ 2 + ‖U₂.starProjection z‖ ^ 2 := by
    rw [hW, sq, sq, sq, norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth]
  have hcomp : K.starProjection z = K.starProjection (W.starProjection z) := by
    have := congrArg (fun T => T z) (Submodule.starProjection_comp_starProjection_of_le hK)
    exact this.symm
  rw [← hn, hcomp]
  have h1 := ContinuousLinearMap.le_opNorm K.starProjection (W.starProjection z)
  have h2 := Submodule.starProjection_norm_le K
  have h3 : ‖K.starProjection (W.starProjection z)‖ ≤ ‖W.starProjection z‖ :=
    h1.trans (by simpa using mul_le_mul_of_nonneg_right h2 (norm_nonneg (W.starProjection z)))
  exact pow_le_pow_left₀ (norm_nonneg _) h3 2
/-- The fit column on a disjoint union is the sum of the fit columns on the parts. -/
theorem fitColumn_union {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁) (hs₁v : volume s₁ < ⊤)
    (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤) (hd : Disjoint s₁ s₂) (φ : ℝ → ℂ)
    (m : Fin M) :
    fitColumn (s₁ ∪ s₂) φ m = fitColumn s₁ φ m + fitColumn s₂ φ m := by
  have hsv : volume (s₁ ∪ s₂) < ⊤ := (measure_union_le s₁ s₂).trans_lt
    (ENNReal.add_lt_top.mpr ⟨hs₁v, hs₂v⟩)
  by_cases h : FitAdmissible (s₁ ∪ s₂) φ
  · have h₁ : FitAdmissible s₁ φ := ⟨hs₁, hs₁v, h.2.2⟩
    have h₂ : FitAdmissible s₂ φ := ⟨hs₂, hs₂v, h.2.2⟩
    refine Lp.ext ?_
    filter_upwards [fitColumn_coeFn h m, fitColumn_coeFn h₁ m, fitColumn_coeFn h₂ m,
      Lp.coeFn_add (fitColumn s₁ φ m) (fitColumn s₂ φ m)] with y hy h1 h2 h3
    rw [hy, h3, Pi.add_apply, h1, h2, Set.indicator_union_of_disjoint hd]
  · have h₁ : ¬ FitAdmissible s₁ φ := fun h' => h ⟨hs₁.union hs₂, hsv, h'.2.2⟩
    have h₂ : ¬ FitAdmissible s₂ φ := fun h' => h ⟨hs₁.union hs₂, hsv, h'.2.2⟩
    unfold fitColumn
    simp only [h, h₁, h₂, ↓reduceDIte, add_zero]
theorem fitRange_le_sup_union {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁)
    (hs₁v : volume s₁ < ⊤) (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤)
    (hd : Disjoint s₁ s₂) (a : ℕ → ℝ → ℂ) (n : ℕ) :
    fitRange (M := M) (s₁ ∪ s₂) a n ≤ fitRange s₁ a n ⊔ fitRange s₂ a n := by
  unfold fitRange
  refine Submodule.span_le.mpr ?_
  rintro x ⟨i, hi, rfl⟩
  rw [fitColumn_union hs₁ hs₁v hs₂ hs₂v hd]
  exact Submodule.add_mem_sup (Submodule.subset_span ⟨i, hi, rfl⟩)
    (Submodule.subset_span ⟨i, hi, rfl⟩)
/-- Fit ranges on disjoint sets are orthogonal. -/
theorem fitRange_isOrtho {M : ℕ} {s₁ s₂ : Set ℝ} (hd : Disjoint s₁ s₂) (a b : ℕ → ℝ → ℂ)
    (n n' : ℕ) : fitRange (M := M) s₁ a n ⟂ fitRange s₂ b n' := by
  unfold fitRange
  refine Submodule.isOrtho_span.mpr ?_
  rintro _ ⟨i, -, rfl⟩ _ ⟨i', -, rfl⟩
  by_cases h₁ : FitAdmissible s₁ (a i)
  · by_cases h₂ : FitAdmissible s₂ (b i')
    · rw [MeasureTheory.L2.inner_def]
      refine integral_eq_zero_of_ae ?_
      filter_upwards [fitColumn_coeFn h₁ i, fitColumn_coeFn h₂ i'] with y hy1 hy2
      rw [hy1, hy2]
      by_cases hy : y ∈ s₁
      · have hy' : y ∉ s₂ := Set.disjoint_left.mp hd hy
        rw [Set.indicator_of_notMem hy', inner_zero_right]; rfl
      · rw [Set.indicator_of_notMem hy, inner_zero_left]; rfl
    · unfold fitColumn
      simp only [h₂, ↓reduceDIte, inner_zero_right]
  · unfold fitColumn
    simp only [h₁, ↓reduceDIte, inner_zero_left]
/-- The fit energy on a cell is at most the sum of the fit energies on its two halves with the
same atoms (refinement of the partition; nested subspaces). -/
theorem fitEnergy_split {M : ℕ} {s₁ s₂ : Set ℝ} (hs₁ : MeasurableSet s₁)
    (hs₁v : volume s₁ < ⊤) (hs₂ : MeasurableSet s₂) (hs₂v : volume s₂ < ⊤)
    (hd : Disjoint s₁ s₂) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ‖fitProj M (s₁ ∪ s₂) a n z‖ ^ 2 ≤ ‖fitProj M s₁ a n z‖ ^ 2 + ‖fitProj M s₂ a n z‖ ^ 2 :=
  starProjection_energy_le_of_le_sup (fitRange_le_sup_union hs₁ hs₁v hs₂ hs₂v hd a n)
    (fitRange_isOrtho hd a a n n) z
theorem fitRange_ae_zero_off {M : ℕ} {s : Set ℝ} {a : ℕ → ℝ → ℂ} {n : ℕ}
    {x : ColumnL2 (Fin M)} (hx : x ∈ fitRange s a n) :
    ∀ᵐ y ∂volume, y ∉ s → (x : ℝ → ColumnHilbert (Fin M)) y = 0 := by
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin M)) (p := fun x _ =>
    ∀ᵐ y ∂volume, y ∉ s → (x : ℝ → ColumnHilbert (Fin M)) y = 0) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, rfl⟩
    by_cases h : FitAdmissible s (a i)
    · filter_upwards [fitColumn_coeFn h i] with y hy hys
      rw [hy, Set.indicator_of_notMem hys]
    · unfold fitColumn
      simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
      rw [hy]; rfl
  · filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin M)) 2 volume] with y hy _
    rw [hy]; rfl
  · intro x y _ _ hx hy
    filter_upwards [hx, hy, Lp.coeFn_add x y] with z hx hy hz hzs
    rw [hz, Pi.add_apply, hx hzs, hy hzs, add_zero]
  · intro c x _ hx
    filter_upwards [hx, Lp.coeFn_smul c x] with z hx hz hzs
    rw [hz, Pi.smul_apply, hx hzs, smul_zero]
/-- The fit projection only sees the input on its cell. -/
theorem fitProj_restrict {M : ℕ} {s : Set ℝ} (hs : MeasurableSet s) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) :
    fitProj M s a n (columnL2Restriction s hs z) = fitProj M s a n z := by
  unfold fitProj
  set! U := fitRange (M := M) s a n
  have e : columnL2Restriction s hs z = columnL2Indicator s hs z := rfl
  have hw : z - columnL2Restriction s hs z ∈ Uᗮ := by
    rw [e]
    refine (Submodule.mem_orthogonal' U _).mpr fun u hu => ?_
    rw [MeasureTheory.L2.inner_def]
    refine integral_eq_zero_of_ae ?_
    filter_upwards [fitRange_ae_zero_off hu, Lp.coeFn_sub z (columnL2Indicator s hs z),
      columnL2Indicator_coeFn s hs z] with y hu hy hr
    rw [hy, Pi.sub_apply, hr]
    by_cases hys : y ∈ s
    · rw [Set.indicator_of_mem hys, sub_self, inner_zero_left]; rfl
    · rw [hu hys, inner_zero_right]; rfl
  calc U.starProjection (columnL2Restriction s hs z)
      = U.starProjection (columnL2Restriction s hs z) +
          U.starProjection (z - columnL2Restriction s hs z) := by
        rw [(Submodule.starProjection_apply_eq_zero_iff U).mpr hw, add_zero]
    _ = U.starProjection z := by rw [← map_add]; congr 1; abel
/-- Contraction of the fit projection on its cell: `‖P z‖² ≤ ∫_s ‖z‖²`. -/
theorem fitEnergy_le {M : ℕ} {s : Set ℝ} (hs : MeasurableSet s) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) :
    ‖fitProj M s a n z‖ ^ 2 ≤ ∫ y in s, ‖(z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
  rw [← fitProj_restrict hs, ← columnL2Restriction_norm_sq s hs z]
  have h1 := ContinuousLinearMap.le_opNorm (fitProj M s a n) (columnL2Restriction s hs z)
  have h2 : ‖fitProj M s a n‖ ≤ 1 := Submodule.starProjection_norm_le _
  have h3 : ‖fitProj M s a n (columnL2Restriction s hs z)‖ ≤ ‖columnL2Restriction s hs z‖ :=
    h1.trans (by simpa using mul_le_mul_of_nonneg_right h2 (norm_nonneg _))
  exact pow_le_pow_left₀ (norm_nonneg _) h3 2
/-! ### One attempt of the adaptive fit on a dyadic tree -/
/-- The parent cell. -/
noncomputable def dyadicParent (G : RealDyadicGrid) (c : ℤ × ℤ) : ℤ × ℤ :=
  (c.1 - 1, dyadicIndex G (c.1 - 1) (dyadicGridLeft G c.1 c.2))
theorem dyadicParent_of_mem_children (G : RealDyadicGrid) {p c : ℤ × ℤ}
    (hc : c ∈ dyadicChildren G p) : dyadicParent G c = p := by
  have hd := dyadicChildren_depth G p c hc
  have hs := dyadicChildren_subset G p c hc
  have hl := hs (dyadicGridCell_left_mem G c.1 c.2)
  have hp1 : c.1 - 1 = p.1 := by omega
  unfold dyadicParent
  rw [hp1, dyadicIndex_eq hl]
/-- The states of one attempt: atoms and count at each cell of depth `root + d`. -/
noncomputable def fitState (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) : ℕ → ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ
  | 0, c => fitGreedy M (P c) (O c) (fun _ => 0, 0)
  | d + 1, c => fitGreedy M (P c) (O c) (fitState G M P O d (dyadicParent G c))
theorem fitState_count_le (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    (fitState G M P O d c).2 ≤ M := by
  induction d generalizing c with
  | zero => exact (fitGreedy_count (P := P c) (O := O c) _ (Nat.zero_le _)).2
  | succ d ih => exact (fitGreedy_count (P := P c) (O := O c) _ (ih _)).2
/-- The inherited count of a cell: the parent's final count (zero at the root). -/
noncomputable def fitInherited (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) :
    ℕ → ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ
  | 0, _ => (fun _ => 0, 0)
  | d + 1, c => fitState G M P O d (dyadicParent G c)
theorem fitState_eq_greedy (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    fitState G M P O d c = fitGreedy M (P c) (O c) (fitInherited G M P O d c) := by
  cases d <;> rfl
theorem fitInherited_count_le (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ)
    (d : ℕ) (c : ℤ × ℤ) : (fitInherited G M P O d c).2 ≤ M := by
  cases d with
  | zero => exact Nat.zero_le _
  | succ d => exact fitState_count_le G M P O d _
/-- The number of atoms inserted at a cell. -/
noncomputable def fitNew (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) : ℕ :=
  (fitState G M P O d c).2 - (fitInherited G M P O d c).2
theorem fitNew_add (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
    (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ) (c : ℤ × ℤ) :
    (fitState G M P O d c).2 = (fitInherited G M P O d c).2 + fitNew G M P O d c := by
  have h := (fitGreedy_count (P := P c) (O := O c) (fitInherited G M P O d c)
    (fitInherited_count_le G M P O d c)).1
  rw [fitState_eq_greedy] at *
  unfold fitNew
  rw [fitState_eq_greedy]
  omega
/-- A cell whose stopping predicate holds for every state inserts nothing. -/
theorem fitNew_eq_zero_of_P (G : RealDyadicGrid) (M : ℕ)
    (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop) (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (d : ℕ)
    (c : ℤ × ℤ) (hP : ∀ a n, P c a n) : fitNew G M P O d c = 0 := by
  have hfix : ∀ st, fitStep M (P c) (O c) st = st := fun st => by
    rcases fitStep_count (P := P c) (O := O c) (M := M) st with h | ⟨-, hn, -⟩
    · exact h
    · exact absurd (hP st.1 st.2) hn
  have hg : ∀ st, fitGreedy M (P c) (O c) st = st := fun st => by
    unfold fitGreedy
    exact Function.iterate_fixed (hfix st) M
  unfold fitNew
  rw [fitState_eq_greedy, hg]
  omega
section FitEnergy
variable (G : RealDyadicGrid) (M : ℕ) (P : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → Prop)
  (O : ℤ × ℤ → (ℕ → ℝ → ℂ) → ℕ → ℝ → ℂ) (f : Lp ℂ 2 (volume : Measure ℝ))
/-- The oracle hypothesis: whenever the residual at a cell is not small and the cap is not
reached, the oracle's atom is admissible and correlates with the residual by `ρ |I|`. -/
def FitOracle (ρ : ℝ) : Prop :=
  ∀ c a n, n < M → ¬ P c a n →
    FitAdmissible (dyadicGridCell G c.1 c.2) (O c a n) ∧
    ρ * dyadicGridLength G c.1 ≤
      ‖∫ y in dyadicGridCell G c.1 c.2, conj (O c a n y) *
        fitResid M (dyadicGridCell G c.1 c.2) f a n y‖
/-- The fit energy at a cell for a state. -/
noncomputable def fitCellEnergy (c : ℤ × ℤ) (st : (ℕ → ℝ → ℂ) × ℕ) : ℝ :=
  ‖fitProj M (dyadicGridCell G c.1 c.2) st.1 st.2 (physicalColumnInput f)‖ ^ 2
theorem fitCellEnergy_gain {ρ : ℝ} (hρ : 0 ≤ ρ) (horacle : FitOracle G M P O f ρ) (d : ℕ)
    (c : ℤ × ℤ) :
    fitCellEnergy G M f c (fitInherited G M P O d c) +
        ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O d c ≤
      fitCellEnergy G M f c (fitState G M P O d c) := by
  have h := fitGreedy_energy (M := M) (P := P c) (O := O c)
    (fun a n => fitCellEnergy G M f c (a, n)) (g := ρ ^ 2 * dyadicGridLength G c.1 / 4)
    (fun a n hn hP => by
      obtain ⟨hadm, hcorr⟩ := horacle c a n hn hP
      have hgain := fitEnergy_gain f a hn hadm hρ
        (by rw [volume_real_cell]; exact hcorr)
      rw [volume_real_cell] at hgain
      exact hgain) (fitInherited G M P O d c)
  rw [← fitState_eq_greedy] at h
  have hc := (fitGreedy_count (P := P c) (O := O c) (fitInherited G M P O d c)
    (fitInherited_count_le G M P O d c)).1
  rw [← fitState_eq_greedy] at hc
  have hnew : ((fitState G M P O d c).2 - (fitInherited G M P O d c).2 : ℝ) =
      (fitNew G M P O d c : ℝ) := by
    unfold fitNew; rw [Nat.cast_sub hc]
  rw [hnew] at h
  exact h
/-- The two children of a cell carry at least the parent's fit energy with the same atoms. -/
theorem fitCellEnergy_children (p : ℤ × ℤ) (st : (ℕ → ℝ → ℂ) × ℕ) :
    fitCellEnergy G M f p st ≤ ∑ c ∈ dyadicChildren G p, fitCellEnergy G M f c st := by
  set m := Classical.choose (dyadicGridCell_children G p.1 p.2)
  have hm := Classical.choose_spec (dyadicGridCell_children G p.1 p.2)
  have hch : dyadicChildren G p = {(p.1 + 1, m), (p.1 + 1, m + 1)} := rfl
  have hne : ((p.1 + 1, m) : ℤ × ℤ) ≠ (p.1 + 1, m + 1) := by simp
  rw [hch, Finset.sum_pair hne]
  have hd : Disjoint (dyadicGridCell G (p.1 + 1) m) (dyadicGridCell G (p.1 + 1) (m + 1)) :=
    dyadicGridCell_pairwiseDisjoint G (p.1 + 1) (by omega)
  unfold fitCellEnergy
  have := fitEnergy_split (M := M) (dyadicGridCell_measurable G _ _)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top)
    (dyadicGridCell_measurable G _ _)
    (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top) hd st.1 st.2
    (physicalColumnInput f)
  simp only at this ⊢
  rw [hm]
  exact this
theorem dyadicGeneration_children_disjoint (G : RealDyadicGrid) (R : ℤ × ℤ) (k : ℕ) :
    (dyadicGeneration G R k : Set (ℤ × ℤ)).PairwiseDisjoint (dyadicChildren G) := by
  intro p _ p' _ hne
  refine Finset.disjoint_left.mpr fun c hc hc' => hne ?_
  rw [← dyadicParent_of_mem_children G hc, dyadicParent_of_mem_children G hc']
/-- Blueprint §11.2, line 1577 ("fits and refinements form nested subspaces"): the energy gains
of all insertions down to generation `d` are at most the fit energy of that generation. -/
theorem fitEnergy_telescope {ρ : ℝ} (hρ : 0 ≤ ρ) (horacle : FitOracle G M P O f ρ)
    (R : ℤ × ℤ) (d : ℕ) :
    ∑ k ∈ Finset.range (d + 1), ∑ c ∈ dyadicGeneration G R k,
        ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O k c ≤
      ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (fitState G M P O d c) := by
  induction d with
  | zero =>
    simp only [zero_add, Finset.range_one, Finset.sum_singleton]
    refine Finset.sum_le_sum fun c _ => ?_
    have h := fitCellEnergy_gain G M P O f hρ horacle 0 c
    have h0 : 0 ≤ fitCellEnergy G M f c (fitInherited G M P O 0 c) := by
      unfold fitCellEnergy; positivity
    linarith
  | succ d ih =>
    rw [Finset.sum_range_succ]
    have hgen : dyadicGeneration G R (d + 1) =
        (dyadicGeneration G R d).biUnion (dyadicChildren G) := rfl
    have hstep : ∑ c ∈ dyadicGeneration G R (d + 1),
        (fitCellEnergy G M f c (fitInherited G M P O (d + 1) c) +
          ρ ^ 2 * dyadicGridLength G c.1 / 4 * fitNew G M P O (d + 1) c) ≤
        ∑ c ∈ dyadicGeneration G R (d + 1), fitCellEnergy G M f c (fitState G M P O (d + 1) c) :=
      Finset.sum_le_sum fun c _ => fitCellEnergy_gain G M P O f hρ horacle (d + 1) c
    have hinh : ∑ p ∈ dyadicGeneration G R d, fitCellEnergy G M f p (fitState G M P O d p) ≤
        ∑ c ∈ dyadicGeneration G R (d + 1),
          fitCellEnergy G M f c (fitInherited G M P O (d + 1) c) := by
      rw [hgen, Finset.sum_biUnion (dyadicGeneration_children_disjoint G R d)]
      refine Finset.sum_le_sum fun p _ => ?_
      refine (fitCellEnergy_children G M f p _).trans (le_of_eq ?_)
      refine Finset.sum_congr rfl fun c hc => ?_
      simp only [fitInherited, dyadicParent_of_mem_children G hc]
    rw [Finset.sum_add_distrib] at hstep
    linarith
/-- The fit energy of a generation is at most the input energy on the root. -/
theorem fitEnergy_generation_le (R : ℤ × ℤ) (d : ℕ) (st : ℤ × ℤ → (ℕ → ℝ → ℂ) × ℕ) :
    ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (st c) ≤
      ∫ y in dyadicGridCell G R.1 R.2, ‖(f : ℝ → ℂ) y‖ ^ 2 := by
  calc ∑ c ∈ dyadicGeneration G R d, fitCellEnergy G M f c (st c)
      ≤ ∑ c ∈ dyadicGeneration G R d, ∫ y in dyadicGridCell G c.1 c.2,
          ‖(physicalColumnInput (V := Fin M) f : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 :=
        Finset.sum_le_sum fun c _ => fitEnergy_le (dyadicGridCell_measurable G _ _) _ _ _
    _ = ∫ y in dyadicGridCell G R.1 R.2,
          ‖(physicalColumnInput (V := Fin M) f : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 :=
        (setIntegral_cell_eq_sum_generation_real G R d (integrableOn_norm_sq_Lp _ _)).symm
    _ = _ := integral_physical_sq f _
end FitEnergy
/-! ### Coefficients of the fit projection -/
theorem columnHilbert_sum_apply {V : Type*} {ι : Type*} (s : Finset ι)
    (x : ι → ColumnHilbert V) (o : Option V) : (∑ i ∈ s, x i) o = ∑ i ∈ s, x i o := by
  induction s using Finset.cons_induction with
  | empty => simp only [Finset.sum_empty]; rfl
  | cons b s hb ih => rw [Finset.sum_cons, Finset.sum_cons, PiLp.add_apply, ih]
/-- The labels of the first `n` fit columns. -/
def fitLabels (M n : ℕ) : Finset (Fin M) := Finset.univ.filter (fun i : Fin M => (i : ℕ) < n)
theorem fitRange_exists_coeff {M : ℕ} {s : Set ℝ} {a : ℕ → ℝ → ℂ} {n : ℕ}
    {x : ColumnL2 (Fin M)} (hx : x ∈ fitRange s a n) :
    ∃ c : Fin M → ℂ, x = ∑ i ∈ fitLabels M n, c i • fitColumn s (a i) i := by
  classical
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin M)) (p := fun x _ =>
    ∃ c : Fin M → ℂ, x = ∑ i ∈ fitLabels M n, c i • fitColumn s (a i) i) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, rfl⟩
    refine ⟨Pi.single i (1 : ℂ), ?_⟩
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb; simp [hb]
    · intro h; exact absurd (show i ∈ fitLabels M n from
        Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩) h
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨c, rfl⟩ ⟨d, rfl⟩
    exact ⟨c + d, by simp [add_smul, Finset.sum_add_distrib]⟩
  · rintro r x _ ⟨c, rfl⟩
    exact ⟨r • c, by simp [Finset.smul_sum, smul_smul]⟩
/-- Coefficients of the fit projection in the fit columns. -/
noncomputable def fitCoeff (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : Fin M → ℂ :=
  Classical.choose (fitRange_exists_coeff
    (Submodule.starProjection_apply_mem (fitRange (M := M) s a n) z))
theorem fitCoeff_spec (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    fitProj M s a n z = ∑ i ∈ fitLabels M n, fitCoeff M s a n z i • fitColumn s (a i) i :=
  Classical.choose_spec (fitRange_exists_coeff
    (Submodule.starProjection_apply_mem (fitRange (M := M) s a n) z))
