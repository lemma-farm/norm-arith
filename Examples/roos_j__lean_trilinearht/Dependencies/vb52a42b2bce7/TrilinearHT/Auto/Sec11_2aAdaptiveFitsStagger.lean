/-- The squared coefficient norm over admissible atoms. -/
noncomputable def fitCoeffSq (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : ℝ :=
  ∑ i ∈ fitLabels M n, if FitAdmissible s (a i) then ‖fitCoeff M s a n z i‖ ^ 2 else 0
theorem fitCoeffSq_nonneg (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    0 ≤ fitCoeffSq M s a n z :=
  Finset.sum_nonneg fun i _ => by split_ifs <;> positivity
theorem norm_fitPhys_sq_le (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M))
    (y : ℝ) : ‖fitPhys M s a n z y‖ ^ 2 ≤ M * fitCoeffSq M s a n z := by
  classical
  set b : Fin M → ℝ := fun i =>
    if FitAdmissible s (a i) then ‖fitCoeff M s a n z i‖ else 0 with hb
  have h1 : ‖fitPhys M s a n z y‖ ≤ ∑ i ∈ fitLabels M n, b i := by
    unfold fitPhys
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i _ => ?_)
    simp only [hb]
    split_ifs with h
    · rw [norm_mul]
      exact mul_le_of_le_one_right (norm_nonneg _) (h.2.2.2 y)
    · simp
  have h2 := sq_sum_le_card_mul_sum_sq (s := fitLabels M n) (f := b)
  have hcard : ((fitLabels M n).card : ℝ) ≤ M := by
    have := Finset.card_le_univ (fitLabels M n)
    simp only [Fintype.card_fin] at this
    exact_mod_cast this
  have hsq : ∑ i ∈ fitLabels M n, b i ^ 2 = fitCoeffSq M s a n z := by
    unfold fitCoeffSq
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [hb]
    split_ifs <;> simp
  have hb0 : 0 ≤ ∑ i ∈ fitLabels M n, b i :=
    Finset.sum_nonneg fun i _ => by simp only [hb]; split_ifs <;> positivity
  calc ‖fitPhys M s a n z y‖ ^ 2 ≤ (∑ i ∈ fitLabels M n, b i) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h1 2
    _ ≤ (fitLabels M n).card * ∑ i ∈ fitLabels M n, b i ^ 2 := by exact_mod_cast h2
    _ ≤ M * fitCoeffSq M s a n z := by
        rw [hsq]
        exact mul_le_mul_of_nonneg_right hcard (fitCoeffSq_nonneg M s a n z)
theorem fitPhys_measurable (M : ℕ) (s : Set ℝ) (a : ℕ → ℝ → ℂ) (n : ℕ)
    (z : ColumnL2 (Fin M)) : Measurable (fitPhys M s a n z) := by
  classical
  unfold fitPhys
  refine Finset.measurable_sum _ fun i _ => ?_
  split_ifs with h
  · exact measurable_const.mul h.2.2.1
  · exact measurable_const
/-- The physical fit is bounded in `L²(s)` by the fit energy. -/
theorem setIntegral_fitPhys_sq_le (M : ℕ) {s : Set ℝ} (hs : MeasurableSet s)
    (hsv : volume s < ⊤) (a : ℕ → ℝ → ℂ) (n : ℕ) (z : ColumnL2 (Fin M)) :
    ∫ y in s, ‖fitPhys M s a n z y‖ ^ 2 ≤
      ∫ y in s, ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y‖ ^ 2 := by
  have : IsFiniteMeasure (volume.restrict s) :=
    ⟨by rw [Measure.restrict_apply_univ]; exact hsv⟩
  have hint : Integrable (fun y => ‖fitPhys M s a n z y‖ ^ 2) (volume.restrict s) := by
    refine Integrable.of_bound (C := M * fitCoeffSq M s a n z)
      ((fitPhys_measurable M s a n z).norm.pow_const 2).aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact norm_fitPhys_sq_le M s a n z y
  refine integral_mono_ae hint (integrableOn_norm_sq_Lp _ s) ?_
  rw [Filter.EventuallyLE, ae_restrict_iff' hs]
  filter_upwards [fitProj_none M a n z] with y hy hys
  rw [← hy hys, EuclideanSpace.norm_sq_eq, Fintype.sum_option]
  have : 0 ≤ ∑ m : Fin M,
      ‖(fitProj M s a n z : ℝ → ColumnHilbert (Fin M)) y (some m)‖ ^ 2 :=
    Finset.sum_nonneg fun _ _ => by positivity
  linarith
/-! ### The adaptive-fit oracle -/
theorem eLpNorm_normalized_le_of_integral {a r : ℝ} (hr : 0 < r) {g : ℝ → ℂ}
    (hg : MemLp g 2 (volume.restrict (Set.Ico a (a + r)))) {C : ℝ} (hC : 0 ≤ C)
    (h : ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ C ^ 2 * r) :
    eLpNorm g 2 (normalizedIntervalMeasure a r) ≤ ENNReal.ofReal C := by
  have hres : volume.restrict (Set.Ico a (a + r)) = volume.restrict (Set.Icc a (a + r)) :=
    Measure.restrict_congr_set Ico_ae_eq_Icc
  have hm : MemLp g 2 (normalizedIntervalMeasure a r) := by
    rw [hres] at hg
    exact hg.smul_measure (c := ENNReal.ofReal r⁻¹) ENNReal.ofReal_ne_top
  rw [hm.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
  apply ENNReal.ofReal_le_ofReal
  have heq : ∫ y, ‖g y‖ ^ (2 : ENNReal).toReal ∂normalizedIntervalMeasure a r =
      r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 := by
    rw [normalizedIntervalMeasure, integral_smul_measure,
      ENNReal.toReal_ofReal (inv_nonneg.mpr hr.le), smul_eq_mul,
      setIntegral_congr_set Ico_ae_eq_Icc.symm]
    congr 2; funext y; simp
  rw [heq]
  have hX : r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 ≤ C ^ 2 := by
    rw [inv_mul_le_iff₀ hr]; linarith
  have hX0 : 0 ≤ r⁻¹ * ∫ y in Set.Ico a (a + r), ‖g y‖ ^ 2 :=
    mul_nonneg (inv_nonneg.mpr hr.le) (integral_nonneg fun _ => by positivity)
  have e : (2 : ENNReal).toReal⁻¹ = (1 / 2 : ℝ) := by norm_num
  rw [e, ← Real.sqrt_eq_rpow]
  calc Real.sqrt _ ≤ Real.sqrt (C ^ 2) := Real.sqrt_le_sqrt hX
    _ = C := Real.sqrt_sq hC
theorem intervalIntegral_eq_cell {a r : ℝ} (hr : 0 ≤ r) (h : ℝ → ℂ) :
    ∫ x in a..a + r, h x = ∫ x in Set.Ico a (a + r), h x := by
  rw [intervalIntegral.integral_of_le (by linarith)]
  exact setIntegral_congr_set (Ioc_ae_eq_Icc.trans Ico_ae_eq_Icc.symm)
/-- A detection chart: complexity and boundedness at budget `B`, and correlation `B⁻¹`. -/
def FitChartGood (c₂ : ℕ) (B a₀ r : ℝ) (R : ℝ → ℂ) (p : Σ d, QuadraticChartData d) : Prop :=
  QuadraticChartComplexity c₂ B p.2 ∧ IsBoundedQuadraticChart p.2 ∧
    B⁻¹ ≤ r⁻¹ * ‖∫ x in a₀..a₀ + r, R x * conj (quadraticChartAtom p.2 x)‖
