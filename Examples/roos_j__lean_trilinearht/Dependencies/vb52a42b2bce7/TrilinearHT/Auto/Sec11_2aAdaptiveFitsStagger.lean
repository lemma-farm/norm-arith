/-! ### Energy gain of one fresh column -/
/-- Adding a vector `u` to a closed range `U` increases the projection energy of `z` by at least
`|⟨u, z - P_U z⟩|² / ‖u‖²` (blueprint §11.2, line 1577: "squared energy gain"). -/
theorem starProjection_sup_span_gain {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    [CompleteSpace E] (U : Submodule ℂ E) [FiniteDimensional ℂ U] (u z : E) :
    ‖(U ⊔ Submodule.span ℂ {u}).starProjection z‖ ^ 2 ≥
      ‖U.starProjection z‖ ^ 2 + ‖inner ℂ u (z - U.starProjection z)‖ ^ 2 / ‖u‖ ^ 2 := by
  set! W := U ⊔ Submodule.span ℂ {u} with hW
  have hUW : U ≤ W := le_sup_left
  have huW : u ∈ W :=
    (le_sup_right : Submodule.span ℂ {u} ≤ W) (Submodule.mem_span_singleton_self u)
  set r := z - U.starProjection z with hr
  have hPU : W.starProjection (U.starProjection z) = U.starProjection z :=
    Submodule.starProjection_eq_self_iff.mpr (hUW (Submodule.starProjection_apply_mem U z))
  have hdecomp : W.starProjection z = U.starProjection z + W.starProjection r := by
    rw [hr, map_sub, hPU]; abel
  have h0 : inner ℂ (U.starProjection z) r = 0 := by
    have h0' := Submodule.starProjection_inner_eq_zero z (U.starProjection z)
      (Submodule.starProjection_apply_mem U z)
    exact inner_eq_zero_symm.mp h0'
  have horth : inner ℂ (U.starProjection z) (W.starProjection r) = 0 := by
    rw [← Submodule.inner_starProjection_left_eq_right, hPU, h0]
  have hnorm : ‖W.starProjection z‖ ^ 2 = ‖U.starProjection z‖ ^ 2 + ‖W.starProjection r‖ ^ 2 := by
    have h := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ horth
    rw [hdecomp, sq, sq, sq, h]
  have hinner : inner ℂ u r = inner ℂ u (W.starProjection r) := by
    rw [← Submodule.inner_starProjection_left_eq_right, Submodule.starProjection_eq_self_iff.mpr
        huW]
  rw [hnorm, ge_iff_le]
  refine add_le_add le_rfl ?_
  rcases eq_or_ne u 0 with hu | hu
  · simp [hu]
  have hu0 : 0 < ‖u‖ := norm_pos_iff.mpr hu
  rw [div_le_iff₀ (by positivity), hinner]
  have hcs := norm_inner_le_norm (𝕜 := ℂ) u (W.starProjection r)
  calc ‖inner ℂ u (W.starProjection r)‖ ^ 2 ≤ (‖u‖ * ‖W.starProjection r‖) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hcs 2
    _ = ‖W.starProjection r‖ ^ 2 * ‖u‖ ^ 2 := by ring
