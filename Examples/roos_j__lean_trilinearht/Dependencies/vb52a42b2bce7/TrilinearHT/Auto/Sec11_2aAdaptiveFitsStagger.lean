        fitStep M P O st = (Function.update st.1 st.2 (O st.1 st.2), st.2 + 1)) := by
  unfold fitStep
  split_ifs with h
  · exact Or.inr ⟨h.1, h.2, rfl⟩
  · exact Or.inl rfl
