namespace Auto
open Filter MeasureTheory
open scoped Topology ENNReal
noncomputable def euclideanDualBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) : Module.Basis (Fin n) ℝ E :=
  b.dualBasis.map (LinearMap.toContinuousLinearMap.trans
    (InnerProductSpace.toDual ℝ E).symm.toLinearEquiv)
theorem euclideanDualBasis_inner {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (i : Fin n) (x : E) :
    inner ℝ (euclideanDualBasis b i) x = b.repr x i := by
  simp [euclideanDualBasis, Module.Basis.map_apply, InnerProductSpace.toDual_symm_apply]
theorem euclideanDualBasis_inner_basis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (i j : Fin n) :
    inner ℝ (euclideanDualBasis b i) (b j) = if i = j then 1 else 0 := by
  rw [euclideanDualBasis_inner]
  simp [Finsupp.single_apply, eq_comm]
/-- The integer dual with respect to the Euclidean inner product. -/
noncomputable def euclideanDualLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (L : Submodule ℤ E) : Submodule ℤ E :=
  LinearMap.BilinForm.dualSubmodule (innerₗ E) L
theorem euclideanInner_nondegenerate {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] : (innerₗ E).Nondegenerate := by
  constructor
  · intro x hx
    exact (inner_self_eq_zero.mp (hx x))
  · intro x hx
    exact (inner_self_eq_zero.mp (hx x))
theorem euclideanDualBasis_eq_bilinDual {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    LinearMap.BilinForm.dualBasis (innerₗ E) euclideanInner_nondegenerate b =
      euclideanDualBasis b := by
  apply DFunLike.coe_injective
  have h := (LinearMap.BilinForm.dualBasis_eq_iff euclideanInner_nondegenerate b
    (euclideanDualBasis b)).mpr (fun i j => by
      simpa only [innerₗ_apply_apply, eq_comm] using euclideanDualBasis_inner_basis b i j)
  exact h
/-- Blueprint `lem:transference`: the integer dual lattice is generated by the
Euclidean dual basis, hence is again a full lattice. -/
theorem euclideanDualLattice_span {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    euclideanDualLattice (Submodule.span ℤ (Set.range b)) =
      Submodule.span ℤ (Set.range (euclideanDualBasis b)) := by
  rw [euclideanDualLattice, LinearMap.BilinForm.dualSubmodule_span_of_basis _
    euclideanInner_nondegenerate, euclideanDualBasis_eq_bilinDual]
/-- The compact, origin-symmetric convex bodies used in
blueprint `lem:transference`; the interior is required to be nonempty. -/
structure IsSymmetricConvexBody {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (K : Set E) : Prop where
  compact : IsCompact K
  convex : Convex ℝ K
  neg_mem : ∀ x ∈ K, -x ∈ K
  interior_nonempty : (interior K).Nonempty
open scoped Pointwise
