  change c ∈ dyadicGeneration _ _ _ ↔ _
  rw [dyadicGeneration_mem_iff]
  have := Ψ.root_le_depth h
  constructor
  · rintro ⟨h1, h2⟩; exact ⟨by omega, h2⟩
  · rintro ⟨h1, h2⟩; exact ⟨by omega, h2⟩
