/-- A low list on the tree below `R` (blueprint prop:base, lines 1626-1630): cellwise
coefficients of modulus at most one on labels available at the cell, availability inherited along
paths, and atoms given by bounded charts fixed below canonical birth cells (each label's birth
cells along different paths are equal or disjoint). -/
structure LowList (G : RealDyadicGrid) (J : ℤ × ℤ) (N : ℕ) (R : ℤ × ℤ) (c₀ : ℕ) (H : ℝ) where
  Λ : Type
  [fin : Fintype Λ]
  coef : ℤ × ℤ → Λ → ℂ
  coef_le : ∀ I l, ‖coef I l‖ ≤ 1
  avail : ℤ × ℤ → Λ → Prop
  coef_avail : ∀ I l, coef I l ≠ 0 → avail I l
  avail_mono : ∀ c d l, c ∈ dyadicFiniteTree G J N → d ∈ dyadicFiniteTree G J N →
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 → avail d l → avail c l
  birth : ℤ × ℤ → Λ → ℤ × ℤ
  dim : ℤ × ℤ → Λ → ℕ
  chart : (K : ℤ × ℤ) → (l : Λ) → QuadraticChartData (dim K l)
  birth_spec : ∀ I l, avail I l →
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (birth I l).1 (birth I l).2 ∧
      birth I l ∈ dyadicFiniteTree G J N ∧
      dyadicGridCell G (birth I l).1 (birth I l).2 ⊆ dyadicGridCell G R.1 R.2
  avail_birth : ∀ I l, avail I l → avail (birth I l) l
  birth_canon' : ∀ I₁ I₂ l, avail I₁ l → avail I₂ l →
    ¬ Disjoint (dyadicGridCell G (birth I₁ l).1 (birth I₁ l).2)
      (dyadicGridCell G (birth I₂ l).1 (birth I₂ l).2) → birth I₁ l = birth I₂ l
  one_le_dim : ∀ K l, 1 ≤ dim K l
  complexity : ∀ K l, QuadraticChartComplexity c₀ H (chart K l)
  bounded : ∀ K l, IsBoundedQuadraticChart (chart K l)
attribute [instance] LowList.fin
namespace LowList
variable {G : RealDyadicGrid} {J : ℤ × ℤ} {N : ℕ} {R : ℤ × ℤ} {c₀ : ℕ} {H : ℝ}
  (X : LowList G J N R c₀ H)
/-- The atom of label `l` at the cell `I`. -/
noncomputable def atom (I : ℤ × ℤ) (l : X.Λ) : ℝ → ℂ := quadraticChartAtom (X.chart (X.birth I l) l)
/-- The low argument `X(I) = Σ_l c_{I,l} φ_{I,l}`. -/
noncomputable def val (I : ℤ × ℤ) (y : ℝ) : ℂ := ∑ l, X.coef I l * X.atom I l y
theorem atom_measurable (I : ℤ × ℤ) (l : X.Λ) : Measurable (X.atom I l) :=
  quadraticChartAtom_measurable _
theorem atom_bound (I : ℤ × ℤ) (l : X.Λ) (y : ℝ) : ‖X.atom I l y‖ ≤ 1 := X.bounded _ _ y
theorem val_measurable (I : ℤ × ℤ) : Measurable (X.val I) :=
  Finset.measurable_sum _ fun l _ => measurable_const.mul (X.atom_measurable I l)
end LowList
