  letI : Nonempty (Fin d) := Fin.pos_iff_nonempty.mp (by omega)
  rw [ae_iff]
  simp
/-- Away from the origin, every radial power density is strictly positive. -/
theorem radialPowerWeight_pos_of_ne_zero
