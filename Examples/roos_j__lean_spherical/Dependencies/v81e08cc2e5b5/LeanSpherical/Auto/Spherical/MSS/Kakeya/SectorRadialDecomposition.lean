/-- A finite smooth frequency-chart interface for the angular shell proof.

The angle is a globally smooth extension for each chart; it is only required
to be a genuine polar angle where that chart multiplier is nonzero.  This is
what avoids the branch discontinuity of a single global `Complex.arg` while
leaving the concrete sector construction as a separate geometric task. -/
structure SmoothAngularFrequencyChartFamily (κ : Type*) (charts : Finset κ)
    (active : Set (Euclidean 2)) where
  /-- Compact smooth sector multiplier. -/
  sector : κ → SchwartzMap (Euclidean 2) Complex
  sector_compact : ∀ j, j ∈ charts →
    HasCompactSupport (sector j : Euclidean 2 → Complex)
  /-- A global smooth extension of the local polar angle. -/
  angle : κ → Euclidean 2 → Real
  angle_smooth : ∀ j, ContDiff Real (⊤ : ℕ∞) (angle j)
  /-- A common lower bound gives one common physical angular endpoint. -/
  angle_lower : ∀ j, j ∈ charts → ∀ xi, -4 < angle j xi
  /-- On a nonzero chart multiplier the extension is the literal circle
  angle of the frequency. -/
  polar_on_sector : ∀ j, j ∈ charts → ∀ xi, sector j xi ≠ 0 →
    xi = ‖xi‖ • circleDirection (angle j xi)
  /-- The chart multipliers reconstruct the active annulus exactly. -/
  sum_eq_one_on_active : ∀ xi, xi ∈ active →
    ∑ j ∈ charts, sector j xi = 1
  /-- The chart count is an absolute geometric constant. -/
  card_le_four : charts.card ≤ 4
section SmoothAngularFrequencyChartFamily
variable {κ : Type*} {charts : Finset κ} {active : Set (Euclidean 2)}
end SmoothAngularFrequencyChartFamily
