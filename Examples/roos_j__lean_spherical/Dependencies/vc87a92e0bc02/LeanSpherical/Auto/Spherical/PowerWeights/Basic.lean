  unfold radialPowerWeight
  intro htop
  rw [ENNReal.rpow_eq_top_iff] at htop
  rcases htop with (⟨hzero, _⟩ | ⟨htop, _⟩)
  · exact (ENNReal.ofReal_pos.mpr (norm_pos_iff.mpr hx)).ne' hzero
  · exact ENNReal.ofReal_ne_top htop
