theorem lintegral_multDiff_sq {G : ℝ → ℂ} (hG : Measurable G) :
    ∫⁻ s, ∫⁻ x, ‖smoothingMultiplicativeDifference G s x‖ₑ ^ 2 = (∫⁻ x, ‖G x‖ₑ ^ 2) ^ 2 := by
  have hm : Measurable (Function.uncurry fun (s x : ℝ) => ‖G (x + s)‖ₑ ^ 2 * ‖G x‖ₑ ^ 2) :=
    ((hG.comp (measurable_snd.add measurable_fst)).enorm.pow_const 2).mul
      ((hG.comp measurable_snd).enorm.pow_const 2)
  calc ∫⁻ s, ∫⁻ x, ‖smoothingMultiplicativeDifference G s x‖ₑ ^ 2
      = ∫⁻ s, ∫⁻ x, ‖G (x + s)‖ₑ ^ 2 * ‖G x‖ₑ ^ 2 := by
        refine lintegral_congr fun s => lintegral_congr fun x => ?_
        simp only [smoothingMultiplicativeDifference, enorm_mul, mul_pow]
        rw [← enorm_norm (star (G x)), norm_star, enorm_norm]
    _ = ∫⁻ x, ∫⁻ s, ‖G (x + s)‖ₑ ^ 2 * ‖G x‖ₑ ^ 2 := lintegral_lintegral_swap hm.aemeasurable
    _ = ∫⁻ x, (∫⁻ s, ‖G s‖ₑ ^ 2) * ‖G x‖ₑ ^ 2 := by
        refine lintegral_congr fun x => ?_
        have hmx : Measurable fun s : ℝ => ‖G (x + s)‖ₑ ^ 2 :=
          (hG.comp (measurable_const_add x)).enorm.pow_const 2
        rw [lintegral_mul_const _ hmx]
        congr 1
        exact lintegral_add_left_eq_self (fun s => ‖G s‖ₑ ^ 2) x
    _ = _ := by rw [lintegral_const_mul _ (hG.enorm.pow_const 2), sq]
