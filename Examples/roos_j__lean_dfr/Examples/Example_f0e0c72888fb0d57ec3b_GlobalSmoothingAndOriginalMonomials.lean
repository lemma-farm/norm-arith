/-- One-dimensional Fourier integral with the explicit phase. -/
def mfkF1 (h : ℝ → ℂ) (ξ : ℝ) : ℂ :=
  ∫ x : ℝ, Complex.exp (-(2 * Real.pi * Complex.I * (x * ξ))) * h x
theorem mfk_phase_eq (x ξ : ℝ) :
    ((Real.fourierChar (-(inner ℝ x ξ)) : Circle) : ℂ) =
      Complex.exp (-(2 * Real.pi * Complex.I * (x * ξ))) := by
  rw [Real.fourierChar_apply]
  congr 1
  simp only [RCLike.inner_apply, conj_trivial]
  push_cast
  ring
theorem mfkF1_eq_fourier (h : ℝ → ℂ) (ξ : ℝ) : mfkF1 h ξ = 𝓕 h ξ := by
  rw [Real.fourier_eq, mfkF1]
  congr 1
  ext x
  rw [Circle.smul_def, smul_eq_mul, mfk_phase_eq]
theorem mfk_lintegral_sq_eq_ofReal {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℂ} (hf : MemLp f 2 μ) :
    ∫⁻ x, ‖f x‖ₑ ^ 2 ∂μ = ENNReal.ofReal (∫ x, ‖f x‖ ^ 2 ∂μ) := by
  have hi := (memLp_two_iff_integrable_sq_norm hf.aestronglyMeasurable).mp hf
  rw [ofReal_integral_eq_lintegral_ofReal hi (Eventually.of_forall (fun x => by positivity))]
  congr 1
  ext x
  rw [ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
