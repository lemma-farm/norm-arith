/-! ### Lc04: localized functions, multiplicative differences, weights -/
/-- `D^{(1)}_s u(w) = u(w + s e_1) \bar{u(w)}`. -/
def mlcD1 (u : ℝ × ℝ → ℂ) (s : ℝ) (w : ℝ × ℝ) : ℂ := u (w.1 + s, w.2) * star (u w)
/-- `D^{(2)}_s u(w) = u(w + s e_2) \bar{u(w)}`. -/
def mlcD2 (u : ℝ × ℝ → ℂ) (s : ℝ) (w : ℝ × ℝ) : ℂ := u (w.1, w.2 + s) * star (u w)
def MlcLoc (u : ℝ × ℝ → ℂ) (B a b R : ℝ) : Prop :=
  Measurable u ∧ (∀ z, ‖u z‖ ≤ B) ∧ ∀ z, u z ≠ 0 → |z.1 - a| ≤ R ∧ |z.2 - b| ≤ R
def mlcBox (a b R : ℝ) : Set (ℝ × ℝ) := Icc (a - R) (a + R) ×ˢ Icc (b - R) (b + R)
theorem mlcBox_measurable (a b R : ℝ) : MeasurableSet (mlcBox a b R) :=
  measurableSet_Icc.prod measurableSet_Icc
theorem mlcBox_lt_top (a b R : ℝ) : volume (mlcBox a b R) < ⊤ :=
  (isCompact_Icc.prod isCompact_Icc).measure_lt_top
theorem mem_mlcBox {a b R : ℝ} {z : ℝ × ℝ} (h : |z.1 - a| ≤ R ∧ |z.2 - b| ≤ R) : z ∈ mlcBox a b R
  := by
  rw [abs_le, abs_le] at h
  exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
theorem MlcLoc.eq_indicator {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) :
    (mlcBox a b R).indicator u = u := by
  funext z
  by_cases hz : u z = 0
  · simp [hz]
  · exact indicator_of_mem (mem_mlcBox (hu.2.2 z hz)) u
theorem MlcLoc.memLp {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (p : ℝ≥0∞) :
    MemLp u p volume := by
  rw [← hu.eq_indicator, memLp_indicator_iff_restrict (/- proof-bridge:d093adda48db97cd2c7481a0 -/ (mlcBox_measurable a b R)).nullMeasurableSet]
  have : IsFiniteMeasure (volume.restrict (mlcBox a b R)) :=
    isFiniteMeasure_restrict.mpr (mlcBox_lt_top a b R).ne
  exact MemLp.of_bound hu.1.aestronglyMeasurable B (Eventually.of_forall hu.2.1)
theorem MlcLoc.integrable {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) :
    Integrable u volume :=
  memLp_one_iff_integrable.mp (hu.memLp 1)
theorem MlcLoc.D1 {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (s : ℝ) :
    MlcLoc (mlcD1 u s) (B * B) a b R := by
  refine ⟨?_, fun z => ?_, fun z hz => ?_⟩
  · unfold mlcD1
    exact (hu.1.comp ((measurable_fst.add_const s).prodMk measurable_snd)).mul
      (continuous_star.measurable.comp hu.1)
  · unfold mlcD1
    rw [norm_mul, norm_star]
    exact mul_le_mul (hu.2.1 _) (hu.2.1 _) (norm_nonneg _) ((norm_nonneg _).trans (hu.2.1 z))
  · unfold mlcD1 at hz
    refine hu.2.2 z fun h0 => hz ?_
    rw [h0, star_zero, mul_zero]
theorem MlcLoc.D2 {u : ℝ × ℝ → ℂ} {B a b R : ℝ} (hu : MlcLoc u B a b R) (s : ℝ) :
    MlcLoc (mlcD2 u s) (B * B) a b R := by
  refine ⟨?_, fun z => ?_, fun z hz => ?_⟩
  · unfold mlcD2
    exact (hu.1.comp (measurable_fst.prodMk (measurable_snd.add_const s))).mul
      (continuous_star.measurable.comp hu.1)
  · unfold mlcD2
    rw [norm_mul, norm_star]
    exact mul_le_mul (hu.2.1 _) (hu.2.1 _) (norm_nonneg _) ((norm_nonneg _).trans (hu.2.1 z))
  · unfold mlcD2 at hz
    refine hu.2.2 z fun h0 => hz ?_
    rw [h0, star_zero, mul_zero]
end
end Auto
