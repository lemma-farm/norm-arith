  hu₁ : MlcLoc u₁ B₁ a₁ b₁ (C0 * h)
  hu₂ : MlcLoc u₂ B₂ a₂ b₂ (C0 * h)
  lip₂ : ∀ z a, ‖u₂ (z + (0, a)) - u₂ z‖ ≤ B₂ * L * |a|
  htb : tb ∈ Icc A B
  htb0 : |tb - (a₁ - a₂)| ≤ 2 * C0 * h
namespace MlcPair
variable {r A B C0 h L B₁ B₂ a₁ b₁ a₂ b₂ tb : ℝ} {ψ : ℝ → ℝ} {u₁ u₂ : ℝ × ℝ → ℂ}
