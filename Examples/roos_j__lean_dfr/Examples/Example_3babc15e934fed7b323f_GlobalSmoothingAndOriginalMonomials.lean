/-! ### Lc14: summing the weighted energies over the partners -/
theorem mlc_sum_X1_le {u : ℝ × ℝ → ℂ} (hu : Measurable u) {ι : Type*} (T : Finset ι) (q : ι → ℝ)
    (h : ℝ) {G : ℝ × ℝ → ℝ} (hG : ∀ ξ, ∑ i ∈ T, mlcw h (q i) ξ ≤ G ξ) :
    ∑ i ∈ T, mlcX1 h (q i) u ≤
      ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 * ENNReal.ofReal (G ξ) := by
  unfold mlcX1
  rw [← lintegral_finsetSum _ (fun i _ => mlc_meas_X1 hu h (q i))]
  refine lintegral_mono fun s => ?_
  have hmξ : Measurable fun ξ => ‖mfkF2 (mlcD1 u s) ξ‖ₑ ^ 2 :=
    ((mlc_meas_F2D1 hu).comp (measurable_const.prodMk measurable_id)).enorm.pow_const 2
  rw [← lintegral_finsetSum _ (fun i _ => (show Measurable fun ξ => ‖mfkF2 _ ξ‖ₑ ^ 2 * mlcW h (q
    i) ξ from hmξ.mul (mlcW_measurable h (q i))))]
  refine lintegral_mono fun ξ => ?_
  rw [← Finset.mul_sum]
  gcongr
  simp only [mlcW_eq]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => mlcw_nonneg _ _ _)]
  exact ENNReal.ofReal_le_ofReal (hG ξ)
theorem mlc_sum_X2_le {u : ℝ × ℝ → ℂ} (hu : Measurable u) {ι : Type*} (T : Finset ι) (q : ι → ℝ)
    (h : ℝ) {G : ℝ × ℝ → ℝ} (hG : ∀ ξ, ∑ i ∈ T, mlcw h (q i) ξ ≤ G ξ) :
    ∑ i ∈ T, mlcX2 h (q i) u ≤
      ∫⁻ s, ∫⁻ ξ, ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 * ENNReal.ofReal (G ξ) := by
  unfold mlcX2
  rw [← lintegral_finsetSum _ (fun i _ => mlc_meas_X2 hu h (q i))]
  refine lintegral_mono fun s => ?_
  have hmξ : Measurable fun ξ => ‖mfkF2 (mlcD2 u s) ξ‖ₑ ^ 2 :=
    ((mlc_meas_F2D2 hu).comp (measurable_const.prodMk measurable_id)).enorm.pow_const 2
  rw [← lintegral_finsetSum _ (fun i _ => (show Measurable fun ξ => ‖mfkF2 _ ξ‖ₑ ^ 2 * mlcW h (q
    i) ξ from hmξ.mul (mlcW_measurable h (q i))))]
  refine lintegral_mono fun ξ => ?_
  rw [← Finset.mul_sum]
  gcongr
  simp only [mlcW_eq]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => mlcw_nonneg _ _ _)]
  exact ENNReal.ofReal_le_ofReal (hG ξ)
theorem mlc_const_weight {F : ℝ → ℝ × ℝ → ℂ} (c : ℝ) :
    ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 * ENNReal.ofReal c = ENNReal.ofReal c * ∫⁻ s, ∫⁻ ξ, ‖F s ξ‖ₑ ^ 2 := by
  simp_rw [lintegral_mul_const' _ _ ENNReal.ofReal_ne_top]
  rw [mul_comm]
end
end Auto
end
