/-! ### Lc11: counting lattice points -/
theorem mlc_card_Icc_int (c : ℤ) {ρ : ℝ} (hρ : 0 ≤ ρ) :
    ((Finset.Icc (c - ⌊ρ⌋) (c + ⌊ρ⌋)).card : ℝ) ≤ 2 * ρ + 1 := by
  rw [Int.card_Icc]
  have h0 : 0 ≤ ⌊ρ⌋ := Int.floor_nonneg.mpr hρ
  have e : c + ⌊ρ⌋ + 1 - (c - ⌊ρ⌋) = 2 * ⌊ρ⌋ + 1 := by ring
  rw [e]
  have : ((2 * ⌊ρ⌋ + 1).toNat : ℝ) = ((2 * ⌊ρ⌋ + 1 : ℤ) : ℝ) := by
    rw [← Int.cast_natCast, Int.toNat_of_nonneg (by omega)]
  rw [this]
  push_cast
  linarith [Int.floor_le ρ]
theorem mlc_mem_Icc_of_abs {m c : ℤ} {ρ : ℝ} (h : |(m : ℝ) - c| ≤ ρ) :
    m ∈ Finset.Icc (c - ⌊ρ⌋) (c + ⌊ρ⌋) := by
  rw [abs_le] at h
  rw [Finset.mem_Icc]
  constructor
  · have : ((c - m : ℤ) : ℝ) ≤ ρ := by push_cast; linarith
    have := Int.le_floor.mpr this
    omega
  · have : ((m - c : ℤ) : ℝ) ≤ ρ := by push_cast; linarith
    have := Int.le_floor.mpr this
    omega
/-- Lattice points in a square of half side `ρ`. -/
theorem mlc_card_le_square (S : Finset (ℤ × ℤ)) (c : ℤ × ℤ) {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hS : ∀ m ∈ S, |(m.1 : ℝ) - c.1| ≤ ρ ∧ |(m.2 : ℝ) - c.2| ≤ ρ) :
    (S.card : ℝ) ≤ (2 * ρ + 1) ^ 2 := by
  have hsub : S ⊆ Finset.Icc (c.1 - ⌊ρ⌋) (c.1 + ⌊ρ⌋) ×ˢ Finset.Icc (c.2 - ⌊ρ⌋) (c.2 + ⌊ρ⌋) := by
    intro m hm
    rw [Finset.mem_product]
    exact ⟨mlc_mem_Icc_of_abs (hS m hm).1, mlc_mem_Icc_of_abs (hS m hm).2⟩
  calc (S.card : ℝ) ≤ ((Finset.Icc (c.1 - ⌊ρ⌋) (c.1 + ⌊ρ⌋) ×ˢ
        Finset.Icc (c.2 - ⌊ρ⌋) (c.2 + ⌊ρ⌋)).card : ℝ) := by exact_mod_cast Finset.card_le_card hsub
    _ = ((Finset.Icc (c.1 - ⌊ρ⌋) (c.1 + ⌊ρ⌋)).card : ℝ) *
        ((Finset.Icc (c.2 - ⌊ρ⌋) (c.2 + ⌊ρ⌋)).card : ℝ) := by
        rw [Finset.card_product]; push_cast; ring
    _ ≤ (2 * ρ + 1) * (2 * ρ + 1) := by
        gcongr
        · exact mlc_card_Icc_int _ hρ
        · exact mlc_card_Icc_int _ hρ
    _ = _ := by ring
/-- Lattice points `m` with `|h m_i| ≤ R`. -/
theorem mlc_card_le_bounded (S : Finset (ℤ × ℤ)) {h R : ℝ} (hh : 0 < h) (hR : 0 ≤ R)
    (hS : ∀ m ∈ S, |h * m.1| ≤ R ∧ |h * m.2| ≤ R) :
    (S.card : ℝ) ≤ (2 * (R / h) + 1) ^ 2 := by
  refine mlc_card_le_square S (0, 0) (by positivity) fun m hm => ?_
  obtain ⟨h1, h2⟩ := hS m hm
  simp only [Int.cast_zero, sub_zero]
  rw [abs_mul, abs_of_pos hh] at h1 h2
  constructor <;> rw [le_div_iff₀ hh] <;> linarith
/-- Lattice points with diameter `≤ D` (in units of `h`). -/
theorem mlc_card_le_diam (S : Finset (ℤ × ℤ)) {h D : ℝ} (hh : 0 < h) (hD : 0 ≤ D)
    (hS : ∀ m ∈ S, ∀ m' ∈ S, |h * m.1 - h * m'.1| ≤ D * h ∧ |h * m.2 - h * m'.2| ≤ D * h) :
    (S.card : ℝ) ≤ (2 * D + 1) ^ 2 := by
  rcases S.eq_empty_or_nonempty with he | ⟨m₀, hm₀⟩
  · rw [he]; simp only [Finset.card_empty, CharP.cast_eq_zero]; positivity
  refine mlc_card_le_square S m₀ hD fun m hm => ?_
  obtain ⟨h1, h2⟩ := hS m hm m₀ hm₀
  rw [← mul_sub, abs_mul, abs_of_pos hh, mul_comm] at h1 h2
  exact ⟨le_of_mul_le_mul_right h1 hh, le_of_mul_le_mul_right h2 hh⟩
end
end Auto
