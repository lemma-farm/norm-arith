/-! ### Lc02: derivative bounds at scale `h` (Leibniz rule for the amplitudes) -/
def MlcReg (N : ℕ) (f : ℝ → ℝ) (α ε : ℝ) : Prop :=
  ContDiff ℝ N f ∧ ∀ k ≤ N, ∀ x, |iteratedDeriv k f x| ≤ α * ε ^ k
theorem MlcReg.alpha_nonneg {N : ℕ} {f : ℝ → ℝ} {α ε : ℝ} (h : MlcReg N f α ε) : 0 ≤ α := by
  have := h.2 0 (Nat.zero_le _) 0
  simp only [iteratedDeriv_zero, pow_zero, mul_one] at this
  exact (abs_nonneg _).trans this
theorem MlcReg.mul {N : ℕ} {f g : ℝ → ℝ} {α β ε : ℝ} (hf : MlcReg N f α ε) (hg : MlcReg N g β ε)
    (hε : 0 ≤ ε) : MlcReg N (fun x => f x * g x) (2 ^ N * (α * β)) ε := by
  refine ⟨hf.1.mul hg.1, fun k hk x => ?_⟩
  have hα := hf.alpha_nonneg
  have hβ := hg.alpha_nonneg
  have e := iteratedDeriv_mul (n := k) (f := f) (g := g) (x := x)
    ((hf.1.of_le (by exact_mod_cast hk)).contDiffAt) ((hg.1.of_le
      (by exact_mod_cast hk)).contDiffAt)
  have e' : iteratedDeriv k (fun x => f x * g x) x = iteratedDeriv k (f * g) x := rfl
  rw [e', e]
  calc
    |∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * iteratedDeriv i f x *
        iteratedDeriv (k - i) g x|
      ≤ ∑ i ∈ Finset.range (k + 1), |(k.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (k -
        i) g x| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (α * ε ^ i) * (β * ε ^ (k - i)) := by
        refine Finset.sum_le_sum fun i hi => ?_
        have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [abs_mul, abs_mul, Nat.abs_cast]
        gcongr
        · exact hf.2 i (hi'.trans hk) x
        · exact hg.2 (k - i) ((Nat.sub_le k i).trans hk) x
    _ = ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (α * β * ε ^ k) := by
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi' : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have : ε ^ k = ε ^ i * ε ^ (k - i) := by rw [← pow_add, Nat.add_sub_cancel' hi']
        rw [this]; ring
    _ = 2 ^ k * (α * β * ε ^ k) := by
        rw [← Finset.sum_mul]
        congr 1
        exact_mod_cast Nat.sum_range_choose k
    _ ≤ 2 ^ N * (α * β) * ε ^ k := by
        have : (2 : ℝ) ^ k ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hk
        have : 0 ≤ α * β * ε ^ k := by positivity
        nlinarith
end
